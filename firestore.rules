rules_version = '2';
// Regole di sicurezza di Pronti in Tavola (docs/SPEC-FIREBASE.md, passaparola).
// Entrato = telefono che ha aperto il link (accesso anonimo).
// Utente = documento utenti/<uid> di quel telefono (nome, stato, cliente).
// Approvato = telefono legato da Monica a un cliente. Gestore = Monica o Mario (gestori/<uid>).
// Prove: npm run prova-regole (emulatore, tools/prova-regole.js).
service cloud.firestore {
  match /databases/{database}/documents {

    function doc(col, id) { return /databases/$(database)/documents/$(col)/$(id); }
    function entrato() { return request.auth != null; }
    function io() { return request.auth.uid; }
    function gestore() { return entrato() && exists(doc('gestori', io())); }
    function utente() { return get(doc('utenti', io())).data; }
    function approvato() {
      return entrato() && exists(doc('utenti', io()))
        && utente().stato == 'approvato' && utente().cliente is string;
    }
    function mioCliente() { return utente().cliente; }
    function cambiati() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function accettaNuovi() { return get(doc('impostazioni', 'app')).data.get('nuovi', true) == true; }
    // Ordine che nasce in questa stessa scrittura, fatto da questo telefono.
    function ordineNuovoMio(id) {
      return id is string && !exists(doc('ordini', id)) && existsAfter(doc('ordini', id))
        && getAfter(doc('ordini', id)).data.utente == io();
    }
    // Ordine del cliente approvato che cambia in questa stessa scrittura
    // (nuovo, o con lo stato o i cuori cambiati): lega pronti, cuori e teglie a un ordine vero.
    function ordineMioCheCambia(id) {
      return existsAfter(doc('ordini', id))
        && getAfter(doc('ordini', id)).data.cliente == mioCliente()
        && (!exists(doc('ordini', id))
            || getAfter(doc('ordini', id)).data.stato != get(doc('ordini', id)).data.stato
            || getAfter(doc('ordini', id)).data.get('cuori', {}) != get(doc('ordini', id)).data.get('cuori', {}));
    }
    // «Mi è piaciuto» di quel piatto nell'ordine, prima e dopo questa scrittura (C98: il cuore del piatto segue quello dell'ordine).
    function cuorePrima(oid, piatto) {
      return exists(doc('ordini', oid)) && get(doc('ordini', oid)).data.get('cuori', {}).get(piatto, false) == true;
    }
    function cuoreDopo(oid, piatto) { return getAfter(doc('ordini', oid)).data.get('cuori', {}).get(piatto, false) == true; }
    // (C99) Codice fisso del profilo: si scrive una volta sola, poi nessuno lo cambia (nemmeno chi gestisce).
    function codiceCliente(c) { return c is string && c.matches('^[A-HJ-NP-Z2-9]{5}$') && c.matches('.*[2-9].*'); }
    function codiceFermo() {
      return !('codice' in resource.data) ? (!('codice' in request.resource.data) || (request.resource.data.codice is string && request.resource.data.codice.matches('^[A-Z0-9]{4,8}$')))
        : request.resource.data.get('codice', '') == resource.data.codice;
    }
    // (C99) Nome scritto dalla persona e storia dei nomi (al massimo 30 cambi).
    function nomeGiusto(n) { return n is string && n.size() >= 2 && n.size() <= 60; }
    function storiaGiusta() { return !('nomiPrima' in request.resource.data) || (request.resource.data.nomiPrima is list && request.resource.data.nomiPrima.size() <= 30); }
    // Numero dell'ordine preso dal contatore, che sale di 1 nella stessa scrittura.
    function numeroDalContatore() {
      return request.resource.data.n == get(doc('contatori', 'ordini')).data.prossimo
        && getAfter(doc('contatori', 'ordini')).data.prossimo == request.resource.data.n + 1;
    }

    match /gestori/{uid} {
      allow read: if (entrato() && io() == uid) || gestore();
      allow create, delete: if gestore();
      allow update: if gestore() && codiceFermo();
    }

    // Richiesta di chi apre l'invito per gestire (Monica): solo con Google, col SUO indirizzo.
    // Diventa gestore solo quando un gestore dice sì (scrive gestori/<uid>).
    match /richiesteGestore/{uid} {
      allow read: if (entrato() && io() == uid) || gestore();
      allow create, update: if entrato() && io() == uid
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.resource.data.keys().hasOnly(['nome', 'email', 'quando'])
        && request.resource.data.nome is string && request.resource.data.nome.size() > 0 && request.resource.data.nome.size() <= 60
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.quando is string && request.resource.data.quando.size() <= 30;
      allow delete: if (entrato() && io() == uid) || gestore();
    }

    match /piatti/{id} {
      allow read: if entrato();
      allow write: if gestore();
      // Approvato: solo i pronti (presi o rimessi) e i cuori (+1 o -1 come il cuore del piatto nel suo ordine), sempre insieme a un suo ordine.
      allow update: if approvato()
        && cambiati().hasOnly(['pronto', 'cuori', 'ultimoOrdine'])
        && ordineMioCheCambia(request.resource.data.ultimoOrdine)
        && (!cambiati().hasAny(['cuori'])
            || (request.resource.data.cuori is int && request.resource.data.cuori >= 0
                && ((request.resource.data.cuori - resource.data.cuori == 1
                     && cuoreDopo(request.resource.data.ultimoOrdine, id) && !cuorePrima(request.resource.data.ultimoOrdine, id))
                    || (resource.data.cuori - request.resource.data.cuori == 1
                     && cuorePrima(request.resource.data.ultimoOrdine, id) && !cuoreDopo(request.resource.data.ultimoOrdine, id)))))
        && (!cambiati().hasAny(['pronto'])
            || (resource.data.pronto != null && request.resource.data.pronto != null
                && request.resource.data.pronto.diff(resource.data.pronto).affectedKeys().hasOnly(['qta'])
                && request.resource.data.pronto.qta >= 0));
    }

    match /foto/{id} {
      allow read: if entrato();
      allow write: if gestore() && request.resource.data.foto is string && request.resource.data.foto.size() < 400000;
      allow delete: if gestore();
    }

    match /impostazioni/app {
      allow read: if entrato();
      allow write: if gestore();
    }
    match /impostazioni/approvati {
      allow read: if approvato() || gestore();
      allow write: if gestore();
    }
    match /impostazioni/monica {
      allow read, write: if gestore();
    }
    // lista della spesa, dosi e «in casa» di Monica (C15): i clienti non la vedono mai
    match /impostazioni/spesa {
      allow read, write: if gestore();
    }

    // Un telefono. Si crea una volta sola (con «Accetta nuovi clienti» acceso):
    // «nuovo» col suo nome unico, o «ricollega» se il nome c'è già (telefono nuovo della stessa persona).
    match /utenti/{uid} {
      allow read: if (entrato() && io() == uid) || gestore();
      allow create, delete: if gestore();
      allow update: if gestore() && codiceFermo();
      allow create: if entrato() && io() == uid
        && request.resource.data.keys().hasOnly(['nome', 'chiave', 'tramite', 'il', 'stato', 'cliente', 'primo', 'codice'])
        && (!('codice' in request.resource.data) || codiceCliente(request.resource.data.codice))
        && request.resource.data.keys().hasAll(['nome', 'chiave', 'tramite', 'il', 'stato', 'cliente', 'primo'])
        && request.resource.data.nome is string
        && request.resource.data.nome.size() >= 2 && request.resource.data.nome.size() <= 60
        && request.resource.data.chiave is string && request.resource.data.chiave.size() <= 60
        && request.resource.data.chiave.matches('^[a-z0-9]+(-[a-z0-9]+)*$')
        && request.resource.data.tramite is string && request.resource.data.tramite.size() <= 40
        && request.resource.data.cliente == null
        && (request.resource.data.primo == null || ordineNuovoMio(request.resource.data.primo))
        && ((request.resource.data.stato == 'nuovo'
             && accettaNuovi()   // la porta chiusa ferma solo i nomi nuovi: chi c'è già rientra da un telefono nuovo (iPhone dall'icona)
             && !exists(doc('nomi', request.resource.data.chiave))
             && existsAfter(doc('nomi', request.resource.data.chiave)))
            || (request.resource.data.stato == 'ricollega'
             && exists(doc('nomi', request.resource.data.chiave))));
      // Prima dell'ok di Monica il telefono segna solo il suo primo ordine
      // (un altro solo se il primo è annullato). Non si approva da solo.
      allow update: if entrato() && io() == uid
        && resource.data.stato in ['nuovo', 'ricollega']
        && cambiati().hasOnly(['primo'])
        && (resource.data.primo == null || get(doc('ordini', resource.data.primo)).data.stato == 'annullato')
        && ordineNuovoMio(request.resource.data.primo);
      // (C99) Prima dell'ok di Monica il telefono corregge il suo nome (la storia dice com'era).
      allow update: if entrato() && io() == uid
        && resource.data.stato in ['nuovo', 'ricollega']
        && cambiati().hasOnly(['nome', 'nomiPrima'])
        && nomeGiusto(request.resource.data.nome) && storiaGiusta();
    }

    // Nomi già usati: si creano una volta sola, insieme al documento utenti/ nuovo. Li legge solo Monica.
    match /nomi/{chiave} {
      allow read, write: if gestore();
      allow create: if entrato()
        && request.resource.data.keys().hasOnly(['il'])
        && !exists(doc('utenti', io()))
        && getAfter(doc('utenti', io())).data.chiave == chiave
        && getAfter(doc('utenti', io())).data.stato == 'nuovo';
    }

    match /clienti/{id} {
      allow read: if gestore() || (approvato() && mioCliente() == id);
      allow create, delete: if gestore();
      allow update: if gestore() && codiceFermo();
      // (C99) Il cliente cambia il SUO nome («nome del cliente»); il «nome per Monica» (nome) resta a chi gestisce.
      allow update: if approvato() && mioCliente() == id
        && cambiati().hasOnly(['nomeCliente', 'nomiPrima'])
        && nomeGiusto(request.resource.data.nomeCliente) && storiaGiusta();
    }

    match /ordini/{id} {
      allow read: if gestore() || (entrato() && resource.data.utente == io())
        || (approvato() && resource.data.cliente == mioCliente());
      allow write: if gestore();
      // Approvato: crea solo un ordine suo, nuovo, non pagato, col numero preso dal contatore.
      allow create: if approvato()
        && request.resource.data.id == id
        && request.resource.data.utente == io()
        && request.resource.data.cliente == mioCliente()
        && request.resource.data.stato == 'nuovo'
        && request.resource.data.paga.ricevuto == false
        && numeroDalContatore();
      // Telefono non ancora approvato: un solo ordine «da approvare», segnato nel suo utenti/.
      allow create: if entrato()
        && request.resource.data.id == id
        && request.resource.data.utente == io()
        && request.resource.data.cliente == null
        && request.resource.data.stato == 'daApprovare'
        && request.resource.data.paga.ricevuto == false
        && getAfter(doc('utenti', io())).data.stato in ['nuovo', 'ricollega']
        && getAfter(doc('utenti', io())).data.primo == id
        && numeroDalContatore();
      // Telefono non ancora approvato: annulla il suo ordine da approvare.
      allow update: if entrato()
        && resource.data.utente == io()
        && resource.data.stato == 'daApprovare'
        && request.resource.data.stato == 'annullato'
        && cambiati().hasOnly(['stato']);
      // Approvato: annulla se nuovo, risponde alla proposta, «Ho pagato», chiede una modifica, «Mi è piaciuto».
      allow update: if approvato()
        && resource.data.cliente == mioCliente()
        && cambiati().hasOnly(['stato', 'entro', 'proposta', 'paga', 'modifica', 'esitoModifica', 'cuori'])
        && (!cambiati().hasAny(['paga'])
            || request.resource.data.paga.diff(resource.data.paga).affectedKeys().hasOnly(['dice']))
        && (!cambiati().hasAny(['esitoModifica']) || request.resource.data.esitoModifica == '')
        && (!cambiati().hasAny(['stato', 'entro', 'proposta'])
            || (resource.data.stato == 'nuovo' && request.resource.data.stato == 'annullato'
                && !cambiati().hasAny(['entro', 'proposta']))
            || (resource.data.stato == 'proposta' && request.resource.data.stato in ['accettato', 'nuovo']
                && request.resource.data.proposta == null
                && (request.resource.data.stato != 'accettato' || request.resource.data.entro == resource.data.proposta)));
    }

    match /contatori/ordini {
      allow read: if entrato();
      allow write: if gestore();
      // +1 solo insieme a un ordine nuovo di questo telefono (le regole dell'ordine dicono se può farlo).
      allow update: if entrato()
        && cambiati().hasOnly(['prossimo', 'ultimo'])
        && request.resource.data.prossimo == resource.data.prossimo + 1
        && ordineNuovoMio(request.resource.data.ultimo);
    }

    match /settimane/{settimana} {
      allow read: if entrato();
      allow write: if gestore();
      // Approvato: le teglie cambiano solo insieme a un suo ordine (nuovo o annullato).
      allow create, update: if approvato()
        && request.resource.data.keys().hasOnly(['teglie', 'ultimo'])
        && request.resource.data.teglie is int && request.resource.data.teglie >= 0
        && ordineMioCheCambia(request.resource.data.ultimo);
    }
  }
}
