+def git(*argomenti):
+    """Uscita di un comando git di sola lettura, '' se fallisce (la guardia lascia passare)."""
+    try:
+        r = subprocess.run(["git", *argomenti], capture_output=True, text=True, timeout=5, cwd=cartella())
+        return r.stdout if r.returncode == 0 else ""
+    except Exception:
+        return ""
+
+
+def leggi(*percorso):
+    try:
+        with open(os.path.join(cartella(), *percorso), encoding="utf-8") as f:
+            return f.read()
+    except Exception:
+        return ""
+
+
+def schemi_del_sito():
+    """I `paths` di sito.yml (un posto solo): GitHub li usa per decidere se pubblicare. `**` = tutto, `*` = senza «/»."""
+    blocco = re.search(r"^\s*paths:\s*\n((?:[ \t]*-[ \t]*\S.*\n?)+)", leggi(".github", "workflows", "sito.yml"), re.M)
+    if not blocco:
+        return []
+    schemi = []
+    for voce in re.findall(r"-[ \t]*['\"]?([^'\"\n]+?)['\"]?[ \t]*$", blocco.group(1), re.M):
+        schemi.append("^" + re.escape(voce).replace(r"\*\*", ".*").replace(r"\*", "[^/]*") + "$")
+    return schemi
+
+
+def del_sito(file):
+    schemi = schemi_del_sito()
+    return sorted({f for f in file if any(re.match(s, f) for s in schemi)})
+
+
+def ramo_di_lavoro():
+    return leggi(".claude", "ramo-di-lavoro.txt").strip()
+
+
+def sul_ramo_di_lavoro():
+    """True se HEAD è il ramo che pubblica. RAMO_ATTUALE_PROVA solo per le prove."""
+    attuale = os.environ.get("RAMO_ATTUALE_PROVA") or git("rev-parse", "--abbrev-ref", "HEAD").strip()
+    return bool(attuale) and attuale == ramo_di_lavoro()
+
+
+def file_del_commit(cmd):
+    """File che il commit porterebbe: già in scena, più `git add …` / `-a` nello stesso comando.
+    IN_SCENA_PROVA e CAMBIATI_PROVA (elenchi con virgole) solo per le prove."""
+    finto = os.environ.get("IN_SCENA_PROVA")
+    file = set(finto.split(",") if finto is not None else git("diff", "--cached", "--name-only").split())
+    if re.search(TUTTI_IN_SCENA, cmd):
+        if "CAMBIATI_PROVA" in os.environ:
+            file.update(os.environ["CAMBIATI_PROVA"].split(","))
+        else:
+            for riga in git("status", "--porcelain", "--untracked-files=all").splitlines():
+                file.add(riga[3:].split(" -> ")[-1].strip('"'))
+    for m in re.finditer(INIZIO + r"git\s+add\s+([^;&|\n]*)", cmd):
+        file.update(p.strip("'\"") for p in m.group(1).split() if not p.startswith("-"))
+    return sorted(f for f in file if f)
+
+
+def cosa_porta_il_push():
