+  {"id": "gh:insalata-di-riso-estiva", "nome": "Insalata di riso estiva", "foto": "https://www.giuseppehealthy.it/wp-content/uploads/2025/10/INSALATA-DI-RISO-ESTIVA.jpg", "url": "https://www.giuseppehealthy.it/it/ricetta/insalata-di-riso-estiva/", "porzioni": 4, "ingredienti": ["350g riso", "200/300g melone", "200g bresaola", "100g feta", "q.b. sale", "Olio evo"], "totale": 30, "passi": [{"t": "Procedimento: Per prima cosa fai bollire l’acqua per il riso; nel frattempo taglia il melone a cubetti e tienilo da parte; taglia la bresaola a listarelle e trasferiscila in padella per farla rosolare qualche minuto.", "foto": []}, {"t": "Nel frattempo sala l’acqua per il riso, e quando l’acqua bolle mettilo a cuocere.", "foto": []}, {"t": "Una volta cotto il riso, unisci tutti gli ingredienti, e per un tocco più goloso aggiungi della feta sbriciolata!", "foto": []}], "autore": "Giuseppe Healthy", "video": "https://www.youtube.com/watch?v=qvPyCZcGhoE", "nutr": {"kcal": 456.2, "prot": 26.9, "carb": 76.5, "zuc": 6.1, "grassi": 6.5, "saturi": 1.9, "sodio": 1170.4}, "dolce": false, "stimata": true},
