+  {"id": "gh:torta-magica-3-ingredienti-senza-farina-senza-zucchero-senza-glutine", "nome": "TORTA MAGICA 3 INGREDIENTI - Senza farina, senza zucchero, senza glutine", "foto": "https://www.giuseppehealthy.it/wp-content/uploads/2025/10/TORTA-MAGICA.jpg", "url": "https://www.giuseppehealthy.it/it/ricetta/torta-magica-3-ingredienti-senza-farina-senza-zucchero-senza-glutine/", "porzioni": 4, "ingredienti": ["500g ricotta", "2 uova", "30g amido di mais (o fecola)", "Scorza di limone", "Dolcificante (facoltativo)"], "totale": 45, "passi": [{"t": "Unisci tutti gli ingredienti fino a formare una pastella liscia ed omogenea.", "foto": []}, {"t": "Trasferisci in una tortiera foderata, e cuoci a 180 gradi per 40 minuti circa; lasciala intiepidire e sei pronto per portarla in tavola ❤️", "foto": []}], "autore": "Giuseppe Healthy", "video": "https://www.youtube.com/watch?v=BWMeBqaRweU", "nutr": {"kcal": 243.8, "prot": 14.4, "carb": 10.8, "zuc": 4.4, "grassi": 16.0, "saturi": 9.7, "sodio": 135.9}, "dolce": true, "stimata": true},
