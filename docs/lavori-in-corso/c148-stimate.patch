+  {"id": "fw:dessert-budino-proteico-fiocchi-di-latte-e-zucca", "nome": "Dessert Budino Proteico Fiocchi di Latte e Zucca", "foto": "https://fitwithfun.it/wp-content/uploads/2025/03/Dessert-Budino-Proteico-Fiocchi-di-Latte-e-Zucca.jpg", "url": "https://fitwithfun.it/dessert-budino-proteico-fiocchi-di-latte-e-zucca/", "porzioni": 2, "ingredienti": ["200 g zucca (peso da cruda al netto degli scarti)", "250 g fiocchi di latte", "q.b. eritritolo o xilitolo (o dolcificante q.b.)"], "totale": 5, "passi": [{"t": "In realtà puoi usare questa ricetta anche per rendere i tuoi primi piatti più proteici, quindi puoi sostituire il dolcificante con sale e spezie preferite.", "foto": []}, {"t": "Nello specifico ho usato la zucca butternut in quanto contiene meno acqua e diventa molto cremosa una volta cotta e frullata.", "foto": []}, {"t": "Ho dunque tagliato la zucca a pezzi e cotta un paio di minuti al microonde.", "foto": []}, {"t": "Una volta che la zucca è cotta e intiepidita frulla coi fiocchi di latte e con dolcificante (o sale) a seconda dell'uso finale.", "foto": []}, {"t": "Se la usi come dessert ti consiglio vaniglia e/o cannella, salata pepe, peperoncino e/o noce moscata.", "foto": []}], "autore": "Fit with Fun", "nutr": {"kcal": 154.0, "prot": 16.1, "carb": 7.9, "zuc": 6.9, "grassi": 5.5, "saturi": 3.5, "sodio": 475.0}, "dolce": true, "stimata": true},
