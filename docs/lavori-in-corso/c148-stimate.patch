+  {"id": "fw:porridge-zucca-e-fiocchi-di-latte-piatto-unico-proteico-e-cremoso", "nome": "Porridge zucca e fiocchi di latte: piatto unico cremoso e proteico", "foto": "https://fitwithfun.it/wp-content/uploads/2026/03/Porridge-zucca-e-fiocchi-di-latte-piatto-unico-proteico-e-cremoso.jpg", "url": "https://fitwithfun.it/porridge-zucca-e-fiocchi-di-latte-piatto-unico-proteico-e-cremoso/", "porzioni": 1, "ingredienti": ["60 g fiocchi di avena", "150 g zucca", "100 g fiocchi di latte", "1 cucchiaino parmigiano", "1 cucchiaino olio extravergine di oliva", "q.b. sale e pepe"], "totale": 10, "passi": [{"t": "In un pentolino cuoci la zucca a piccoli cubetti con un po’ d’acqua finché diventa morbida (puoi cuocerla ancora pià velocemente in microonde per un paio di minuti).", "foto": []}, {"t": "Aggiungi i fiocchi di avena e altra acqua se necessario, quindi mescola e lascia cuocere a fuoco medio finché l’avena assorbe il liquido e il composto diventa cremoso.", "foto": []}, {"t": "Infine regola con sale e pepe, aggiungi i fiocchi di latte e mescola delicatamente per renderlo ancora più morbido e avvolgente. Poi spegni il fuoco.", "foto": []}, {"t": "Completa con un filo di olio extravergine d’oliva prima di servire.", "foto": []}, {"t": "Puoi gustarlo caldo appena pronto per un piatto avvolgente e nutriente, oppure lasciarlo raffreddare, conservarlo in frigorifero e mangiarlo freddo o scaldarlo velocemente quando preferisci.", "foto": []}], "autore": "Fit with Fun", "nutr": {"kcal": 431.5, "prot": 23.1, "carb": 44.8, "zuc": 8.0, "grassi": 15.1, "saturi": 5.3, "sodio": 411.2}, "dolce": false, "stimata": true},
+  {"id": "fw:porridge-melograno-e-formaggio-cremoso-proteico-e-sorprendente", "nome": "Porridge melograno e formaggio: cremoso, proteico e sorprendente", "foto": "https://fitwithfun.it/wp-content/uploads/2026/03/Porridge-melograno-e-formaggio-cremoso-proteico-e-sorprendente.jpg", "url": "https://fitwithfun.it/porridge-melograno-e-formaggio-cremoso-proteico-e-sorprendente/", "porzioni": 1, "ingredienti": ["70 g fiocchi di avena", "100 g philadelphia protein", "10 g parmigiano", "q.b. melograno", "q.b. sale e pepe"], "totale": 10, "passi": [{"t": "In un pentolino cuoci i fiocchi di avena con acqua quanto basta (consiglio 4 volte il peso dei fiocchi), mescolando finché iniziano ad ammorbidirsi e ad assorbire il liquido.", "foto": []}, {"t": "Continua la cottura aggiungendo poca acqua alla volta se necessario, fino a ottenere una consistenza cremosa e ben legata.", "foto": []}, {"t": "Puoi cuocere anche tutto al microonde. Ti ci vorranno circa 2' ancor meglio se giri ogni 30'' e valuti la densità.", "foto": []}, {"t": "A fuoco spento unisci il formaggio spalmabile proteico, qualche chicco di melograno, metà del parmigiano e mescola finché si scioglie e rende il porridge ancora più morbido.", "foto": []}, {"t": "Regola con sale, pepe e completa con i chicchi di melograno distribuiti sopra e il restante parmigiano. Ci sta benissimo anche della rucola.", "foto": []}, {"t": "Gustalo caldo appena pronto per apprezzarne al meglio la cremosità, oppure lascialo raffreddare, conservalo in frigorifero e mangialo freddo o scaldalo velocemente quando preferisci.", "foto": []}], "autore": "Fit with Fun", "nutr": {"kcal": 395.1, "prot": 24.3, "carb": 46.0, "zuc": 4.8, "grassi": 11.4, "saturi": 5.1, "sodio": 361.4}, "dolce": false, "stimata": true},
+  {"id": "fw:torta-yogurt-greco-e-mirtilli-con-pasta-fillo-in-friggitrice-ad-aria", "nome": "Torta yogurt greco e mirtilli con pasta fillo in friggitrice ad aria", "foto": "https://fitwithfun.it/wp-content/uploads/2026/03/Torta-yogurt-greco-e-mirtilli-con-pasta-fillo-in-friggitrice-ad-aria.jpg", "url": "https://fitwithfun.it/torta-yogurt-greco-e-mirtilli-con-pasta-fillo-in-friggitrice-ad-aria/", "porzioni": 4, "ingredienti": ["3 fogli pasta fillo", "1 uovo", "120 g yogurt greco", "20 g proteine alla vaniglia (facoltative)", "q.b. scorza di limone", "q.b. eritritolo o xilitolo (o dolcificante q.b.)"], "totale": 30, "passi": [{"t": "Taglia i fogli di fillo a metà per formare dei rettangoli più piccoli, poi spennella uno con dell'acqua e piega a fisarmonica.", "foto": []}, {"t": "Arrotola su sè stesso come a formare una girella e ponilo al centro di uno stampo da circa 15 cm.", "foto": []}, {"t": "Continua con un altro foglio di pasta fillo, questa volta però posizionandolo attorno alla girella iniziale e così via anche con gli altri fogli.", "foto": []}, {"t": "Cuoci in friggitrice per 5' a 160° o in forno per 10' a 180°, per dare struttura.", "foto": []}, {"t": "Intanto in una ciotola metti lo yogurt greco, rompi l'uovo, aggiungi scorza di limone e dolcificante (se gradisci anche le proteine in polvere), consigliatissimo il dolcificante Torta al Limone.", "foto": []}, {"t": "Versa sulla struttura di fillo, aggiungi i mirtilli e prosegui la cottura in friggitrice per altri 15', in forno per altri 20'.", "foto": []}], "autore": "Fit with Fun", "nutr": {"kcal": 65.7, "prot": 8.3, "carb": 1.5, "zuc": 1.4, "grassi": 3.0, "saturi": 1.7, "sodio": 43.3}, "dolce": false, "stimata": true},
