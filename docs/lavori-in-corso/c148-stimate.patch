+  {"id": "gh:muffin-in-tazza-4-ingredienti-pronti-in-5-minuti", "nome": "MUFFIN IN TAZZA 4 INGREDIENTI - Pronti in 5 minuti!", "foto": "https://www.giuseppehealthy.it/wp-content/uploads/2025/10/MUFFIN-IN-TAZZA.jpg", "url": "https://www.giuseppehealthy.it/it/ricetta/muffin-in-tazza-4-ingredienti-pronti-in-5-minuti/", "porzioni": 2, "ingredienti": ["130g yogurt greco", "1 uovo", "30g farina di avena", "30g gocce di cioccolato", "1 cucchiaino lievito (facoltativo)"], "totale": 25, "passi": [{"t": "In una ciotola lavora tutti gli ingredienti fino ad ottenere una pastella liscia ed omogenea.", "foto": []}, {"t": "Versa il composto in delle cocotte (precedentemente unte) e cuoci in friggitrice ad aria a 165 gradi per 20 minuti circa (oppure in forno a 180 gradi per 25 minuti)", "foto": []}], "autore": "Giuseppe Healthy", "video": "https://www.youtube.com/watch?v=Nkmy3PwGL04", "nutr": {"kcal": 236.9, "prot": 12.3, "carb": 19.2, "zuc": 10.4, "grassi": 12.1, "saturi": 6.6, "sodio": 82.0}, "dolce": true, "stimata": true},
+  {"id": "gh:crepes-kinder-cereali-4-ingredienti-", "nome": "CRÊPES KINDER CEREALI 4 INGREDIENTI - in 2 minuti!", "foto": "https://www.giuseppehealthy.it/wp-content/uploads/2025/09/CREPES-KINDER-CEREALI.jpg", "url": "https://www.giuseppehealthy.it/it/ricetta/crepes-kinder-cereali-4-ingredienti-/", "porzioni": 1, "ingredienti": ["55g farina", "5g cacao", "1 uovo", "125ml latte", "Crema spalmabile ai cereali"], "totale": 5, "passi": [{"t": "Unisci tutti gli ingredienti, fino a formare una pastella liscia. Cuoci in una padella antiaderente, versa un mestolo di composto alla volta, circa 2-3 minuti per lato. Farcisci le crêpes a gusto 😋", "foto": []}], "autore": "Giuseppe Healthy", "video": "https://www.youtube.com/watch?v=yucrl5FFsAA", "nutr": {"kcal": 345.8, "prot": 18.0, "carb": 46.1, "zuc": 7.1, "grassi": 10.9, "saturi": 5.6, "sodio": 140.5}, "dolce": true, "stimata": true},
