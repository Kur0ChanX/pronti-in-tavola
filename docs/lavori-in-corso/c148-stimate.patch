+  {"id": "fw:strudel-rustico-di-pasta-fillo-con-salmone-asparagi-e-besciamella", "nome": "Strudel Rustico di Pasta Fillo con Salmone Asparagi e Besciamella", "foto": "https://fitwithfun.it/wp-content/uploads/2021/04/Strudel-Rustico-di-Pasta-Fillo-con-Salmone-Asparagi-e-Besciamella-3.jpg", "url": "https://fitwithfun.it/strudel-rustico-di-pasta-fillo-con-salmone-asparagi-e-besciamella/", "porzioni": 5, "ingredienti": ["100 g pasta fillo", "100 g salmone affumicato", "150 g asparagi", "2 g olio di cocco (o preferito)", "8 g semi di canapa (o semi preferiti)", "q.b. sale e pepe", "10 g olio extravergine di oliva", "10 g farina di riso", "150 g latte vegetale non zuccherato", "1 pizzico noce moscata", "q.b. sale e pepe"], "totale": 30, "passi": [{"t": "Trovi il video tutorial per realizzare la besciamella nella prefazione ↑", "foto": []}, {"t": "Cuoci e salta gli asparagi in padella, poi una volta intiepiditi tagliali a pezzi.", "foto": []}, {"t": "Taglia anche il salmone a pezzi.", "foto": []}, {"t": "Prendi 4 fogli di pasta fillo (i miei pesano circa 25 g quindi ho così raggiunto i 100 g ma usane quanti ne vuoi) e metti uno sull'altro.", "foto": []}, {"t": "Farcisci lo strudel su un lato, quasi a coprire metà rettangolo, e lasciando un paio di cm alle estremità per permetterti di realizzare delle pieghe che chiuderanno lo strudel.", "foto": []}, {"t": "Fai uno strato col salmone, ricopri con la besciamella e infine distribuisci gli asparagi.", "foto": []}, {"t": "Fai delle pieghe dall'esterno verso il ripieno per chiuderlo nelle estremità, poi giralo come un rotolo.", "foto": []}, {"t": "Poggia su della carta forno, spennella con l'olio di cocco e cospargi coi semi.", "foto": []}, {"t": "Cuoci in forno già caldo a 200º per circa 15/20'.", "foto": []}], "autore": "Fit with Fun", "nutr": {"kcal": 160.9, "prot": 10.4, "carb": 19.9, "zuc": 3.4, "grassi": 4.7, "saturi": 1.3, "sodio": 393.4}, "dolce": false, "stimata": true},
+  {"id": "fw:tortino-proteico-patata-dolce-al-microonde-4-ingredienti-5-minuti", "nome": "Tortino Proteico Patata Dolce al Microonde 4 Ingredienti 5 Minuti", "foto": "https://fitwithfun.it/wp-content/uploads/2023/04/Tortino-Proteico-Patata-Dolce-al-Microonde-4-Ingredienti-5-Minuti-1.jpg", "url": "https://fitwithfun.it/tortino-proteico-patata-dolce-al-microonde-4-ingredienti-5-minuti/", "porzioni": 1, "ingredienti": ["100 g patata dolce (al netto degli scarti)", "100 g albume", "40 g farina di riso istantanea (leggi note in fondo)", "10 g proteine al cioccolato bianco (facoltative)", "1 cucchiaio eritritolo o xilitolo (o dolcificante q.b.)", "1/2 cucchiaino lievito per dolci"], "totale": 10, "passi": [{"t": "Con una forchetta pratica dei buchi nella patata e cuoci nel microonde per qualche minuto a max potenza (i tempi possono variare in base alla larghezza della patata).", "foto": []}, {"t": "In una ciotola unisci la farina di riso, le proteine, il lievito e l'eritritolo.", "foto": []}, {"t": "Una volta che la patata si è intiepidita, frulla con l'albume poi versa nella ciotola con gli ingredienti secchi.", "foto": []}, {"t": "Unisci in modo omogeneo e versa in una tazza o un contenitore in plastica adatto al microonde (il mio è di circa 8/9 cm).", "foto": []}, {"t": "Se gradisci aggiungi del cioccolato in cima poi cuoci per 4' a 800W aprendo lo sportello di tanto in tanto.", "foto": []}, {"t": "Togli dal contenitore, appoggia su un piattino e cuoci un altro minuto.", "foto": []}], "autore": "Fit with Fun", "nutr": {"kcal": 490.6, "prot": 40.3, "carb": 36.2, "zuc": 3.8, "grassi": 22.1, "saturi": 6.7, "sodio": 193.0}, "dolce": false, "stimata": true},
