+  {"id": "fw:crespelle-ricotta-spinaci-e-besciamella-proteiche-low-carb", "nome": "Crespelle Ricotta Spinaci e Besciamella Proteiche Low Carb", "foto": "https://fitwithfun.it/wp-content/uploads/2020/11/Crespelle-Ricotta-Spinaci-e-Besciamella-Proteiche-Low-Carb-0.jpg", "url": "https://fitwithfun.it/crespelle-ricotta-spinaci-e-besciamella-proteiche-low-carb/", "porzioni": 7, "ingredienti": ["1 uovo", "150 g albume", "200 g latte preferito (non zuccherato)", "100 g farine preferite ((leggi le note in fondo))", "150 g ricotta", "250 g Spinaci", "10 g parmigiano (o grana)", "1 manciata basilico fresco", "q.b. Sale e Pepe", "25 g farina preferita ((leggi le note in fondo))", "25 g olio extravergine di oliva", "300 g latte preferito (non zuccherato)", "3 fette formaggio light", "2 cucchiai Passata di Pomodoro", "10 g parmigiano (o grana)"], "totale": 71, "passi": [{"t": "Ti consiglio come prima cosa di preparare l'impasto per le crepes, mentre questo riposa, prepara la besciamella e cuoci gli spinaci.", "foto": []}, {"t": "In una ciotola unisci l'uovo con l'albume sbattendo con una forchetta o una frusta a mano.", "foto": []}, {"t": "Aggiungi poco per volta, una parte di farina e una di latte, unendo bene.", "foto": []}, {"t": "Copri con pellicola e lascia riposare 30' per far assorbire eventuali grumi.", "foto": []}, {"t": "Trascorso questo tempo, scalda una padella in pietra o antiaderente e quando diventa bella calda, versa abbastanza impasto da coprirne il fondo.", "foto": []}, {"t": "Appena i bordi si staccano, gira e cuoci poco meno di 1', prosegui con il resto dell'impasto fino a terminarlo.", "foto": []}, {"t": "Ho usato una padella grande da 24 cm di diametro e me ne sono venute 7.", "foto": []}, {"t": "Segui il video che trovi in prefazione.", "foto": []}, {"t": "Cuoci gli spinaci in padella senza aggiungere altro (sia che siano freschi sia surgelati).", "foto": []}, {"t": "Una volta intiepiditi mettili in un colino e schiacciali con una forchetta, eliminando l'acqua in eccesso.", "foto": []}, {"t": "Dopodiché frullali insieme alla ricotta, basilico, parmigiano, 2 cucchiai di besciamella, sale e pepe e tieni da parte.", "foto": []}, {"t": "Con le crespelle ho riempito 2 pirofile diverse, una rettangolare e una quadrata, tagliando le crespelle a metà per quella quadrata.", "foto": []}, {"t": "Ad una parte di besciamella ho aggiunto la passata, facendo così 2 pirofile di colore diverso.", "foto": []}, {"t": "Sul fondo della pirofila metti 2 cucchiai di besciamella e distribuisci bene (serve a non far attaccare le crepes).", "foto": []}, {"t": "Prendi una crespella e metti un cucchiaio abbondante di ripieno su un lato.", "foto": []}, {"t": "Taglia le fette di formaggio in strisce e mettine q.b. sul ripieno.", "foto": []}, {"t": "Arrotola la crespella, prosegui fino a terminare gli ingredienti poi posiziona le crespelle nelle pirofile.", "foto": []}, {"t": "Versa la restante besciamella sulle crespelle, termina spolverando i 10 g di parmigiano e cuoci in forno preriscaldato a 200º per 30' circa o fino a doratura.", "foto": []}], "autore": "Fit with Fun", "nutr": {"kcal": 164.6, "prot": 10.1, "carb": 8.1, "zuc": 4.7, "grassi": 10.3, "saturi": 4.4, "sodio": 151.9}, "dolce": false, "stimata": true},
+  {"id": "fw:cheesecake-di-ricotta-e-broccoli-proteica-e-low-carb", "nome": "Cheesecake di Ricotta e Broccoli Proteica e Low Carb", "foto": "https://fitwithfun.it/wp-content/uploads/2020/02/Cheesecake-di-Ricotta-e-Broccoli-Low-Carb-1.jpg", "url": "https://fitwithfun.it/cheesecake-di-ricotta-e-broccoli-proteica-e-low-carb/", "porzioni": 1, "ingredienti": ["200 g broccoli", "100 g ricotta", "22 g parmigiano", "q.b. ripieno a scelta (facoltativo)", "q.b. Sale e Pepe"], "totale": 15, "passi": [{"t": "Preriscalda il forno a 200º se vuoi la versione cotta.", "foto": []}, {"t": "Se i broccoli sono surgelati mettili in padella e lascia asciugare l'acqua, se sono freschi, mettili in padella con un dito d'acqua e lascia cuocere e asciugare bene.", "foto": []}, {"t": "Aspetta intiepidiscano poi mettili in un mixer col resto degli ingredienti e 20 g di parmigiano, lascia 2 g da parte.", "foto": []}, {"t": "Versa metà in uno stampo in silicone (o oleato) da circa 10 cm, farcisci a piacere e copri con l'altra metà.", "foto": []}, {"t": "Spolvera col restante parmigiano e se hai farcito con del formaggio, lascia cuocere per 5/10' circa.", "foto": []}, {"t": "Se opti per la versione senza cottura, usa un coppa pasta, farcisci sempre a piacere se vuoi e gusta anche subito o tieni in frigo.", "foto": []}], "autore": "Fit with Fun", "nutr": {"kcal": 289.3, "prot": 21.7, "carb": 7.5, "zuc": 7.5, "grassi": 18.0, "saturi": 11.2, "sodio": 226.0}, "dolce": false, "stimata": true},
