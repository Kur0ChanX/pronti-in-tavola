+  {"id": "fw:torta-salata-di-cavolfiore-in-padella-light-e-proteica", "nome": "Torta Salata di Cavolfiore in Padella Light e Proteica", "foto": "https://fitwithfun.it/wp-content/uploads/2021/05/Torta-Salata-di-Cavolfiore-in-Padella-Light-e-Proteica--e1632417876361.jpg", "url": "https://fitwithfun.it/torta-salata-di-cavolfiore-in-padella-light-e-proteica/", "porzioni": 1, "ingredienti": ["200 g cavolfiore", "1 uovo", "100 g albume", "10 g grana padano o parmigiano", "35 g avena istantanea", "q.b. sale e pepe", "q.b. farcitura preferita"], "totale": 15, "passi": [{"t": "Se il cavolfiore è surgelato mettilo in una padella sul fuoco e lascia asciugare l'acqua, se è fresco, mettilo in padella con un dito d'acqua e lascia cuocere e asciugare bene.", "foto": []}, {"t": "Aspetta intiepidisca poi frullalo con l'uovo e l'albume.", "foto": []}, {"t": "Aggiungi tutti gli altri ingredienti tranne la farcitura ed unisci.", "foto": []}, {"t": "Scalda una padella (la mia è da 15 cm) e versa metà impasto.", "foto": []}, {"t": "Aggiungi la farcitura scelta (per me 25 g di formaggio di capra affumicato e 2 fette di fesa di tacchino) poi ricopri col restante impasto.", "foto": []}, {"t": "Copri con un coperchio e lascia cuocere.", "foto": []}, {"t": "Quando sarà cotto sotto e nei lati, gira e tieni altri 5'.", "foto": []}, {"t": "Servi caldo se hai farcito con del formaggio.", "foto": []}], "autore": "Fit with Fun", "nutr": {"kcal": 343.3, "prot": 31.7, "carb": 27.2, "zuc": 6.0, "grassi": 10.8, "saturi": 4.5, "sodio": 318.1}, "dolce": false, "stimata": true},
+  {"id": "fw:panino-di-spinaci-proteico-3-ingredienti-3-minuti", "nome": "Panino di Spinaci Proteico 3 Ingredienti 3 Minuti", "foto": "https://fitwithfun.it/wp-content/uploads/2025/03/Panino-di-Spinaci-Proteico-3-Ingredienti-3-Minuti.jpg", "url": "https://fitwithfun.it/panino-di-spinaci-proteico-3-ingredienti-3-minuti/", "porzioni": 1, "ingredienti": ["1 uovo", "30 g spinacino fresco", "35 g farina di avena istantanea integrale", "1 pizzico lievito istantaneo", "q.b. sale e spezie preferite"], "totale": 6, "passi": [{"t": "Frulla tutti gli ingredienti, anche con un minipimer se ti è più comodo.", "foto": []}, {"t": "Versa in una ciotola e cuoci in microonde per 2' a 1000W, poi taglia a metà e cuoci altri 30''.", "foto": []}, {"t": "Dopodiché farcisci con ciò che ami e passa in padella calda su entrambi i lati o in un tostapane.", "foto": []}], "autore": "Fit with Fun", "nutr": {"kcal": 211.1, "prot": 12.4, "carb": 21.9, "zuc": 0.5, "grassi": 7.4, "saturi": 2.6, "sodio": 106.0}, "dolce": false, "stimata": true},
+  {"id": "fw:pure-proteico-di-patate-spinaci-e-albumi", "nome": "Purè proteico di patate spinaci e albumi", "foto": "https://fitwithfun.it/wp-content/uploads/2016/06/Pure-di-Patate-Dolci-Spinaci-e-Albumi.jpg", "url": "https://fitwithfun.it/pure-proteico-di-patate-spinaci-e-albumi/", "porzioni": 1, "ingredienti": ["200 g patate", "200 g spinaci", "250 g latte e/o acqua", "150 g albume", "1 cucchiaio grana padano", "q.b. sale e pepe", "1 pizzico noce moscata"], "totale": 35, "passi": [{"t": "Pela e taglia le patate a pezzi e mettile in un pentolino insieme a latte e acqua.", "foto": []}, {"t": "Lascia cuocere a fuoco medio e quando la patata si è ammorbidita aggiungi l'albume e le spezie e lascia che l'albume cuoci girando di tanto in tanto.", "foto": []}, {"t": "Pulisci e lava gli spinaci e aggiungili al resto degli ingredienti nella pentola (se preferisci usa spinaci surgelati e strizzali almeno un po').", "foto": []}, {"t": "Frulla tutto con un frullatore ad immersione.", "foto": []}, {"t": "Se devi mangiarlo a posteriori, prima di servire riscalda e aggiungi il parmigiano. Se devi servirlo al momento, aggiungi il parmigiano, unisci per bene e servi.", "foto": []}], "autore": "Fit with Fun", "nutr": {"kcal": 497.3, "prot": 40.2, "carb": 51.2, "zuc": 16.2, "grassi": 15.2, "saturi": 8.6, "sodio": 693.0}, "dolce": false, "stimata": true},
+  {"id": "fw:torta-di-crepes-fredda-salata-e-senza-glutine", "nome": "Torta di Crepes Fredda Salata e Senza Glutine", "foto": "https://fitwithfun.it/wp-content/uploads/2020/07/Torta-di-Crepes-Fredda-Salata-e-Senza-Glutine-3-sito.jpg", "url": "https://fitwithfun.it/torta-di-crepes-fredda-salata-e-senza-glutine/", "porzioni": 6, "ingredienti": ["50 g farina di ceci (o farina preferita)", "30 g proteine neutre (o farina preferita)", "100 g latte vegetale senza zucchero (o preferito)", "100 g albume", "1 pizzico sale, pepe", "70 g formaggio morbido light (tipo philadelphia)", "70 g fiocchi di latte", "1 zucchina", "200 g prosciutto di tacchino (o fesa)", "50 g mais", "q.b. rucola", "q.b sale", "q.b. basilico fresco"], "totale": 30, "passi": [{"t": "In una ciotola unisci latte e albume e in un'altra unisci la farina di ceci, le proteine, sale e pepe.", "foto": []}, {"t": "Setaccia gli ingredienti secchi unendoli ai liquidi girando man a mano con una frusta a mano.", "foto": []}, {"t": "Una volta terminati gli ingredienti e aver unito bene, rivesti con pellicola trasparente e lascia riposare 30' in frigo (per far sì che si sciolgano eventuali grumi).", "foto": []}, {"t": "Trascorso questo tempo, scalda una padella in pietra (io ne ho usata una da 15 cm e ho ricavato 5 crepes).", "foto": []}, {"t": "Versa 1/2 mestolo di impasto e lascia cuocere la crepe, appena i bordi iniziano a staccarsi, girala dall'altro lato e lascia cuocere meno di un minuto.", "foto": []}, {"t": "Prosegui fino a terminare l'impasto poi lascia intiepidire.", "foto": []}, {"t": "Taglia una zucchina a fette e grigliala.", "foto": []}, {"t": "Frulla il formaggio morbido con i fiocchi di latte, il sale e il basilico.", "foto": []}, {"t": "Spalma un po' di questa crema su una crepe, prosegui con la zucchina, il prosciutto e mais.", "foto": []}, {"t": "Ricopri con un'altra crepe e rifai la stessa procedura: spalma la crema, fai uno strato con zucchina, prosciutto e mais.", "foto": []}, {"t": "Prosegui così fino a terminare le crepes.", "foto": []}, {"t": "Spalma la crema anche intorno se riesci e se ti va.", "foto": []}, {"t": "Termina con rucola e mais e riponi in frigo fino al momento di servire.", "foto": []}], "autore": "Fit with Fun", "nutr": {"kcal": 174.5, "prot": 15.0, "carb": 17.2, "zuc": 1.8, "grassi": 5.6, "saturi": 2.0, "sodio": 139.5}, "dolce": false, "stimata": true},
+  {"id": "fw:gnocchi-di-cavolfiore-proteici-e-senza-farina", "nome": "Gnocchi di Cavolfiore Proteici e Senza Farina", "foto": "", "url": "https://fitwithfun.it/gnocchi-di-cavolfiore-proteici-e-senza-farina/", "porzioni": 1, "ingredienti": ["250 g cavolfiore", "30 g albume", "20 g parmigiano (o grana)", "1 pizzico sale, pepe"], "totale": 25, "passi": [{"t": "Preriscalda il forno a 200º e rivesti una leccarda con carta forno.", "foto": []}, {"t": "Se il cavolfiore è surgelato mettilo in padella e lascia asciugare l'acqua, se è fresco, mettilo in padella con un dito d'acqua e lascia cuocere e asciugare bene.", "foto": []}, {"t": "Aspetta intiepidisca poi mettilo in un mixer col resto degli ingredienti e aziona.", "foto": []}, {"t": "Prendi l'impasto con l'aiuto di un cucchiaino e con le mani forma i tuoi gnocchi, posizionandoli man a mano sulla leccarda.", "foto": []}, {"t": "Cuoci per 10' da un lato poi girali e cuoci altri 5'.", "foto": []}, {"t": "Passali in una padella e aggiungi il condimento scelto (io ho optato per sugo di pomodorino homemade e un po' di mozzarella).", "foto": []}], "autore": "Fit with Fun", "nutr": {"kcal": 167.3, "prot": 17.7, "carb": 7.0, "zuc": 6.2, "grassi": 6.5, "saturi": 3.8, "sodio": 189.8}, "dolce": false, "stimata": true},
+  {"id": "fw:ciccio-pancake-proteico-al-microonde-avena-feta-e-peperoni", "nome": "Ciccio Pancake Proteico al Microonde Avena Feta e Peperoni", "foto": "https://fitwithfun.it/wp-content/uploads/2022/10/Ciccio-Pancake-Proteico-al-Microonde-Avena-Feta-e-Peperoni-1.jpg", "url": "https://fitwithfun.it/ciccio-pancake-proteico-al-microonde-avena-feta-e-peperoni/", "porzioni": 1, "ingredienti": ["50 g farina di avena Integrale", "150 g albume", "50 g feta", "100 g peperoni arrostiti", "10 g olive nere", "1 pizzico lievito (facoltativo)", "Q.b. sale, pepe, basilico"], "totale": 12, "passi": [{"t": "In una ciotola metti l'albume ed aggiungi sale, pepe e lievito se lo usi.", "foto": []}, {"t": "Sbatti energicamente con una forchetta poi aggiungi l'avena ed unisci in modo omogeneo, formando una pastella liscia.", "foto": []}, {"t": "Aggiungi poi i peperoni e il basilico tagliati a pezzi, olive tagliate a rondelle e sbriciola la feta.", "foto": []}, {"t": "Dai una girata e versa in un recipiente adatto per la cottura in microonde (io ne ho usato uno in ceramica di 10 cm).", "foto": []}, {"t": "Cuoci per circa 7 minuti (controlla di tanto in tanto perché i tempi potrebbero variare in base ai modelli).", "foto": []}], "autore": "Fit with Fun", "nutr": {"kcal": 425.8, "prot": 31.4, "carb": 36.2, "zuc": 6.8, "grassi": 16.7, "saturi": 4.5, "sodio": 977.4}, "dolce": false, "stimata": true},
+  {"id": "fw:pancake-alla-zucca-e-avena-proteici-senza-lattosio", "nome": "Pancake alla zucca e avena proteici senza lattosio", "foto": "https://fitwithfun.it/wp-content/uploads/2025/10/pancake-zucca-e-avena-.jpg", "url": "https://fitwithfun.it/pancake-alla-zucca-e-avena-proteici-senza-lattosio/", "porzioni": 2, "ingredienti": ["100 g zucca cotta", "2 uova", "50 g albume", "100 g farina di avena istantanea", "q.b. dolcificante preferito e cannella", "q.b. gocce di cioccolato fondente senza zucchero (facoltative)"], "totale": 15, "passi": [{"t": "Scalda una padella e se vuoi spennella con un po' di olio.", "foto": []}, {"t": "Cuoci la zucca al vapore o al microonde per non farle accumulare troppa acqua (dev'essere asciutta).", "foto": []}, {"t": "Aggiungi uova, albume, dolcificante e cannella ed unisci.", "foto": []}, {"t": "Aggiungi a poco a poco l'avena fino a formare una pastella e se gradisci aggiungi gocce di cioccolato (o mirtilli o altro che ami).", "foto": []}, {"t": "Con l'aiuto di un cucchiaio versa la pastella in padella e forma i tuoi pancake, copri con un coperchio.", "foto": []}, {"t": "Quando noti le bollicine gira i pancake e tieni qualche altro secondo.", "foto": []}, {"t": "Prosegui fino a terminare l'impasto.", "foto": []}, {"t": "Puoi prepararli il giorno prima, tenerli in frigo e scaldarli al microonde, in friggitrice giusto 1 o 2 minuti o di nuovo in padella.", "foto": []}], "autore": "Fit with Fun", "nutr": {"kcal": 281.6, "prot": 16.5, "carb": 31.9, "zuc": 2.0, "grassi": 8.4, "saturi": 2.7, "sodio": 117.8}, "dolce": true, "stimata": true},
+  {"id": "fw:pancake-salati-proteici-con-zucca-e-avena-istantanea-ripieni", "nome": "Pancake Salati Proteici con Zucca e Avena Istantanea Ripieni", "foto": "https://fitwithfun.it/wp-content/uploads/2025/11/Pancake-Salati-Proteici-con-Zucca-e-Avena-Istantanea-Ripieni-1.jpg", "url": "https://fitwithfun.it/pancake-salati-proteici-con-zucca-e-avena-istantanea-ripieni/", "porzioni": 4, "ingredienti": ["150 g zucca butternut (al netto degli scarti)", "130 g albume", "70 g avena istantanea integrale", "q.b. sale, pepe, spezie preferite", "30 g prosciutto cotto", "40 g fettine di formaggio"], "totale": 15, "passi": [{"t": "Scalda una padella e spennella con un po' di olio.", "foto": []}, {"t": "Uso la zucca butternut perché contiene meno acqua ed è perfetta per ricette come questa, usa la zucca che preferisci ma ti consigli odi cuocerla al vapore o al microonde.", "foto": []}, {"t": "Una volta cotta ed intiepidita, frullala.", "foto": []}, {"t": "In una ciotola metti l'avena con sale e spezie e un pizzico di lievito, unisci.", "foto": []}, {"t": "Aggiungi a poco la zucca e l'albume e rendi omogeneo.", "foto": []}, {"t": "Con l'aiuto di un cucchiaio versa dell'impasto sulla padella, al centro metti un pezzo di prosciutto e un odi formaggio e ricopri con altro impasto.", "foto": []}, {"t": "Prosegui cosi fino a terminare gli ingredienti e copri con un coperchio.", "foto": []}, {"t": "Quando noti che sono cotti sotto e nei lati, girali e tienili un altro minuto circa.", "foto": []}, {"t": "Servi caldi per un maggior potere filante, oppure tienili in frigo (una volta intiepiditi) ne riscaldali in microonde o in padella, al momento di servire.", "foto": []}], "autore": "Fit with Fun", "nutr": {"kcal": 131.6, "prot": 8.2, "carb": 12.2, "zuc": 1.4, "grassi": 5.0, "saturi": 1.4, "sodio": 150.3}, "dolce": false, "stimata": true},
+  {"id": "fw:torta-big-bounty-proteica-low-carb-senza-zucchero", "nome": "Torta Big Bounty Proteica Low Carb Senza Zucchero", "foto": "https://fitwithfun.it/wp-content/uploads/2023/09/Torta-Big-Bounty-Proteica-Low-Carb-Senza-Zucchero-1.jpg", "url": "https://fitwithfun.it/torta-big-bounty-proteica-low-carb-senza-zucchero/", "porzioni": 4, "ingredienti": ["200 g albume", "100 g yogurt greco", "50 g farina di avena istantanea", "20 g farina di cocco (leggi note in fondo)", "20 g cocco disidratato", "Q.b. yummy drops al cocco (o dolcificante preferito)", "1 pizzico lievito", "40 g latte di cocco denso", "10 g cacao", "10 g proteine al cioccolato o eritritolo"], "totale": 12, "passi": [{"t": "In una ciotola metti l'albume con lo yogurt e sbatti con una forchetta.", "foto": []}, {"t": "In un'altra ciotola unisci l'avena con la farina di cocco, il cocco disidratato e il lievito.", "foto": []}, {"t": "Aggiungi man a mano i liquidi ed unisci in modo omogeneo.", "foto": []}, {"t": "Infine aggiungi il dolcificante al cocco (se lo usi) o il tuo dolcificante preferito.", "foto": []}, {"t": "Versa in uno stampo adatto (io ho usato un contenitore rettangolare di circa 17x10 cm).", "foto": []}, {"t": "Cuoci per circa 5/6' a max potenza (1000W) aprendo lo sportello di tanto in tanto, poi giralo e cuoci ancora 1/2'.", "foto": []}, {"t": "Lascia raffreddare completamente ed intanto prepara la copertura semplicemente unendo gli ingredienti.", "foto": []}, {"t": "Ricopri la torta con la crema al cioccolato e riponi almeno 30' in frigo prima di gustare.", "foto": []}], "autore": "Fit with Fun", "nutr": {"kcal": 213.3, "prot": 12.6, "carb": 11.4, "zuc": 3.7, "grassi": 12.7, "saturi": 9.9, "sodio": 105.1}, "dolce": true, "stimata": true},
+  {"id": "fw:brownie-proteico-al-cacao-variegato-al-burro-di-arachidi", "nome": "Brownie Proteico al Cacao Variegato al Burro di Arachidi", "foto": "https://fitwithfun.it/wp-content/uploads/2023/04/Brownie-Proteico-al-Cacao-Variegato-al-Burro-di-Arachidi-1.jpg", "url": "https://fitwithfun.it/brownie-proteico-al-cacao-variegato-al-burro-di-arachidi/", "porzioni": 4, "ingredienti": ["100 g banana o polpa di mela cotta", "1 uovo", "200 g albume", "40 g cacao magro in polvere", "40 g avena istantanea (leggi note in fondo)", "40 g avena istantanea proteica brownie al cioccolato (leggi note in fondo)", "1/2 cucchiaino lievito", "1 cucchiaino burro di arachidi per decorare"], "totale": 13, "passi": [{"t": "In una ciotola unisci cacao, i due tipi di avena e il lievito ed unisci.", "foto": []}, {"t": "Frulla la banana con albume e uovo dopodiché versa nella ciotola con gli ingredienti secchi, unendo man a mano.", "foto": []}, {"t": "Una volta reso omogeneo, versa in una pirofila in vetro (la mia è 15x10) o in uno stampo adatto al microonde (puoi anche cuocere in forno a 180° per circa 15/20').", "foto": []}, {"t": "Con un cucchiaino fai cadere del burro di arachidi in vari punti del brownie e con la punta di un coltello muovilo alla rinfusa per formare dei ghirigori.", "foto": []}, {"t": "Se vuoi aggiungi qualche goccia di cioccolato.", "foto": []}, {"t": "Cuoci per circa 5' a 800W, aprendo lo sportello di tanto in tanto.", "foto": []}, {"t": "Dopodiché toglilo dalla pirofila, metti su un piatto e termina la cottura un altro minuto max 2.", "foto": []}], "autore": "Fit with Fun", "nutr": {"kcal": 175.8, "prot": 12.3, "carb": 18.0, "zuc": 4.4, "grassi": 6.0, "saturi": 2.4, "sodio": 109.1}, "dolce": true, "stimata": true},
