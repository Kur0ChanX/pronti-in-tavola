+  {"id": "fw:mimosa-pancakes-con-crema-e-fragole-proteici-senza-glutine", "nome": "Mimosa Pancakes con Crema e Fragole Proteici Senza Glutine", "foto": "https://fitwithfun.it/wp-content/uploads/2023/03/Mimosa-Pancakes-con-Crema-e-Fragole-Proteici-Senza-Glutine-1.jpg", "url": "https://fitwithfun.it/mimosa-pancakes-con-crema-e-fragole-proteici-senza-glutine/", "porzioni": 1, "ingredienti": ["100 g banana", "100 g albume", "50 g farina di riso", "10 g farina di cocco o amido", "10 g succo di limone + scorza q.b.", "1 pizzico lievito per dolci (o cremor tartaro o bicarbonato)", "120 g Crema Pasticcera Proteica (o budino proteico o ciò che vuoi)", "q.b. fragole"], "totale": 20, "passi": [{"t": "Per prima cosa prepara la crema come indicato nella ricetta, poi tieni da parte mettendola in frrigo.", "foto": []}, {"t": "Frulla la banana con l'albume e il succo di limone.", "foto": []}, {"t": "Aggiungi le farine, il lievito, la scorza di limone e se gradisci anche 1 pizzico di curcuma ed unisci in modo omogeneo.", "foto": []}, {"t": "Scalda un padellino o una piastra per pancake (io ho usato un padellino da 11 cm).", "foto": []}, {"t": "Dividi l'impasto in 2 parti (o in più parti se il diametro è minore) e cuoci per qualche minuto su entrambi i lati.", "foto": []}, {"t": "Aspetta che intiepidiscano i pancakes prima di farcire.", "foto": []}, {"t": "Dopodiché taglia le fragole a pezzi e spalma abbondante crema su un pancake e una leggera spalmata sull'altro.", "foto": []}, {"t": "Sulla parte abbondante metti i pezzi di fragole, copri con l'altro pancake, gusta!", "foto": []}], "autore": "Fit with Fun", "nutr": {"kcal": 454.9, "prot": 27.8, "carb": 67.2, "zuc": 22.1, "grassi": 9.5, "saturi": 7.3, "sodio": 316.3}, "dolce": false, "stimata": true},
+  {"id": "fw:frittata-di-riso-light-e-proteica-con-asparagi-e-zafferano", "nome": "Frittata di Riso Light e Proteica con Asparagi e Zafferano", "foto": "https://fitwithfun.it/wp-content/uploads/2021/01/Frittata-di-Riso-Light-con-Asparagi-e-Zafferano-e1632417854571.jpg", "url": "https://fitwithfun.it/frittata-di-riso-light-e-proteica-con-asparagi-e-zafferano/", "porzioni": 1, "ingredienti": ["50 g riso basmati (o preferito)", "1 uovo", "50 g albume", "150 g asparagi", "15 g parmigiano", "30 g fesa di pollo o di tacchino", "q.b. sale, pepe", "q.b. zafferano"], "totale": 20, "passi": [{"t": "Per questa ricetta il riso avanzato sarebbe perfetto, altrimenti ti consiglio di cuocerlo il giorno prima e tenerlo in frigo, in questo modo sarà molto più asciutto e non conferirà umidità alla frittata.", "foto": []}, {"t": "Se usi asparagi freschi sbollentali in acqua, altrimenti se usi quelli surgelati lasciali scongelare in una padella, su fiamma media, senza aggiungere altro.", "foto": []}, {"t": "Quando tutti gli ingredienti saranno pronti, riscalda una piccola padella (tra i 15 e i 18 cm) o accendi il forno a 200º.", "foto": []}, {"t": "Rompi l'uovo in un piatto, aggiungi albume, parmigiano, sale, pepe e zafferano e sbatti con una forchetta.", "foto": []}, {"t": "Aggiungi il riso, gli asparagi e la fesa tagliata a pezzetti.", "foto": []}, {"t": "Unisci bene poi versa nel padellino o in uno stampo se decidi di usare il forno.", "foto": []}, {"t": "In forno ti ci vorranno circa 15/20' o fino a doratura.", "foto": []}, {"t": "Se cuoci nel padellino, tieni la fiamma non alta e copri con un coperchio.", "foto": []}, {"t": "Lascia cuocere circa 10' poi gira e cuoci dall'altro lato per più o meno lo stesso tempo o poco meno.", "foto": []}], "autore": "Fit with Fun", "nutr": {"kcal": 424.9, "prot": 35.4, "carb": 47.9, "zuc": 7.0, "grassi": 10.8, "saturi": 5.3, "sodio": 265.8}, "dolce": false, "stimata": true},
+  {"id": "fw:tortino-di-quinoa-e-cacao-3-ingredienti-proteico-senza-glutine-ne-lattosio", "nome": "Tortino di Quinoa e Cacao 3 Ingredienti Proteico Senza Glutine né Lattosio", "foto": "https://fitwithfun.it/wp-content/uploads/2022/04/Tortino-di-Quinoa-e-Cacao-3-Ingredienti-Proteico-Senza-Glutine-ne-Lattosio-1.jpg", "url": "https://fitwithfun.it/tortino-di-quinoa-e-cacao-3-ingredienti-proteico-senza-glutine-ne-lattosio/", "porzioni": 1, "ingredienti": ["50 g quinoa", "10 g cacao amaro in polvere", "70 g albume", "1 cucchiaio eritritolo o xilitolo (o dolcificante q.b.)", "5 g proteine al cioccolato (facoltative)", "Q.b. vaniglia e cannella"], "totale": 20, "passi": [{"t": "Per realizzare questo tortino ti occorre della quinoa cotta quindi procedi a cucoerla come indicato sulla confezione. Puoi farlo in acqua o latte, come preferisci ma cosa importante, non esagerare con i liquidi perchè dovrà essere ben asciutta per procedere con la ricetta.", "foto": []}, {"t": "Preriscalda il forno a 180° oppure se hai un microonde potrai terminare la cottura usando quest'ultimo.", "foto": []}, {"t": "Aggiungi alla quinoa, tutti gli altri ingredienti rendendo omogeneo.", "foto": []}, {"t": "Versa in un piccolo stampino da 10 cm (o una cocotte, una tazza, ciò che hai) e cuoci in forno per circa 15', al microonde non avendo testato, controlla la cottura ogni 1 o 2 minuti.", "foto": []}, {"t": "Decora a piacere e servi calda o fredda.", "foto": []}], "autore": "Fit with Fun", "nutr": {"kcal": 272.6, "prot": 21.1, "carb": 31.0, "zuc": 3.5, "grassi": 7.0, "saturi": 2.9, "sodio": 130.7}, "dolce": true, "stimata": true},
