+  {"id": "fw:torta-pasqualina-light-ricotta-e-spinaci-con-pasta-fillo", "nome": "Torta Pasqualina Light Ricotta e Spinaci con Pasta Fillo", "foto": "https://fitwithfun.it/wp-content/uploads/2019/04/Torta-Pasqualina-Light-Ricotta-e-Spinaci-con-Pasta-Fillo-.jpg", "url": "https://fitwithfun.it/torta-pasqualina-light-ricotta-e-spinaci-con-pasta-fillo/", "porzioni": 6, "ingredienti": ["140 g Pasta Fillo *", "400 g Spinaci *", "120 g ricotta", "130 g fiocchi di latte", "20 g Grana Padano", "1 cucchiaio olio extravergine di oliva", "50 g albume", "4 Tuorli", "q.b. noce moscata", "q.b. sale", "q.b. pepe"], "totale": 85, "passi": [{"t": "Come primo passaggio cuoci gli spinaci in padella per qualche minuto, senza aggiungere acqua.", "foto": []}, {"t": "Aspetta che intiepidiscano poi strizza via tutta l'acqua possibile.", "foto": []}, {"t": "In una ciotola metti la ricotta coi fiocchi di latte, il grana, sale, pepe, noce moscata e albume, poi aggiungi gli spinaci ed unisci in modo omogeneo.", "foto": []}, {"t": "Prepara una ciotola d'acqua ed aggiungi un cucchiaio scarso di olio.", "foto": []}, {"t": "Prepara uno stampo con carta forno, io ne ho usato uno da 18 cm.", "foto": []}, {"t": "Rivesti lo stampo col primo foglio di carta fillo, facendo in modo che ricopra anche i bordi e spennella con l'emulsione di acqua e olio.", "foto": []}, {"t": "I primi due fogli li ho ripiegati su loro stessi per far in modo che la base venisse più solida (ricorda di spennellare bene ogni angolo ed ogni piega).", "foto": []}, {"t": "Continua fino a terminare i fogli, facendo in modo che la parte che fuoriesce dallo stampo non stia tutta da un lato, perché servirà poi per chiudere la nostra torta.", "foto": []}, {"t": "Una volta terminati i fogli, riempi con l'impasto di spinaci.", "foto": []}, {"t": "Con l'aiuto di un cucchiaio forma delle fossette all'interno dell'impasto.", "foto": []}, {"t": "Lascia cadere i tuorli in queste fossette, io ne ho utilizzati 4 perché per la grandezza della mia 