   {"id": "cp:17107515", "nome": "Polpette tonno e fagioli", "foto": "https://img-global.cpcdn.com/recipes/34ef77d9949efbf3/1200x630cq80/photo.jpg", "url": "https://cookpad.com/it/ricette/17107515", "porzioni": 2, "ingredienti": ["400 g fagioli", "2 scatolette tonno", "1 uovo", "Pan grattato", "5 acciughe", "Prezzemolo", "No sale!!!"], "totale": 0, "nutr": {"kcal": 840.8, "prot": 70.8, "carb": 95.0, "zuc": 7.0, "grassi": 14.5, "saturi": 4.4, "sodio": 298.5}, "dolce": false, "stimata": true, "passi": [{"t": "Schiacciare tutti gli ingredienti insieme.", "foto": []}, {"t": "Formare le polpette e passarle nel pan grattato.", "foto": []}, {"t": "Cuocere in olio e burro facendole dorare", "foto": []}]},
   {"id": "cp:16507906", "nome": "Fichi ripieni", "foto": "https://img-global.cpcdn.com/recipes/b3a9597a5be99b3b/1200x630cq80/photo.jpg", "url": "https://cookpad.com/it/ricette/16507906", "porzioni": 2, "ingredienti": ["4 fichi neri ben sodi", "100 g ricotta (o altro formaggio spalmabile)", "100 g tartare di salmone precedentemente abbattuto", "Q.B. Scorza di limone grattugiata", "Q.B. Pepe nero e olio EVO", "qualche foglia basilico per decorare"], "totale": 0, "nutr": {"kcal": 165.5, "prot": 13.6, "carb": 2.2, "zuc": 2.2, "grassi": 11.4, "saturi": 5.1, "sodio": 88.0}, "dolce": false, "stimata": true, "passi": [{"t": "Il taglio: Lavate i fichi e incideteli a croce dall'alto verso il basso, senza tagliare la base. Aprite i petali con delicatezza.", "foto": []}, {"t": "La farcia: Lavorate il formaggio con un pizzico di pepe e la scorza di limone. Inserite una generosa dose di crema al centro del fico.", "foto": []}, {"t": "Il tocco gourmet: Adagiate la tartare di salmone sopra il formaggio, completate con un giro d'olio a crudo, un'altra spolverata di pepe e qualche fogliolina di basilico.", "foto": ["https://img-global.cpcdn.com/steps/9354d0aad3cb791e/400x400cq80/photo.jpg", "https://img-global.cpcdn.com/steps/e47fc42f3e6192c1/400x400cq80/photo.jpg"]}]},
   {"id": "cp:16874781", "nome": "Parmigiana di finocchi proteica", "foto": "https://img-global.cpcdn.com/recipes/7ce7f6d742370b0d/1200x630cq80/photo.jpg", "url": "https://cookpad.com/it/ricette/16874781", "porzioni": 2, "ingredienti": ["2 finocchi", "100 gr albumi", "300 gr scamorza", "150 gr parmigiano grattugiato", "qb Sale pepe olio evo e pangrattato"], "totale": 0, "nutr": {"kcal": 820.2, "prot": 67.2, "carb": 1.9, "zuc": 1.9, "grassi": 60.8, "saturi": 25.3, "sodio": 533.0}, "dolce": false, "stimata": true, "passi": [{"t": "Lavare i finocchi e tagliarli a fette sottili cuocerli a vapore in questo modo manterranno tutto il sapore.", "foto": ["https://img-global.cpcdn.com/steps/89d70bac791422b5/400x400cq80/photo.jpg"]}, {"t": "Oleare e cospargere di pangrattato una pirofila,fare un primo strato di finocchi.", "foto": ["https://img-global.cpcdn.com/steps/9d59a9ba11c4e2df/400x400cq80/photo.jpg", "https://img-global.cpcdn.com/steps/6347a5882ff2b1b8/400x400cq80/photo.jpg", "https://img-global.cpcdn.com/steps/6f0b6f679158dfae/400x400cq80/photo.jpg"]}, {"t": "Cospargere di pangrattato.", "foto": ["https://img-global.cpcdn.com/steps/c50768173cceb951/400x400cq80/photo.jpg"]}, {"t": "Sbattere l'albume con sale e pepe e versare con un cucchiaio sui finocchi, aggiungere il parmigiano grattugiato e la scamorza grattugiata sui fori larghi", "foto": ["https://img-global.cpcdn.com/steps/db9a49803f3689e3/400x400cq80/photo.jpg", "https://img-global.cpcdn.com/steps/689500732312f108/400x400cq80/photo.jpg", "https://img-global.cpcdn.com/steps/7303165ccf0cc010/400x400cq80/photo.jpg"]}, {"t": "Alternare in questo modo sino a quando non finiscano i finocchi. Terminare l'ultimo strato con pangrattato e parmigiano.", "foto": ["https://img-global.cpcdn.com/steps/73ae9d90d41552aa/400x400cq80/photo.jpg"]}, {"t": "Cuocere in forno a 180 gradi per 35/ 40 minuti sino a quando non si sarà formata una bella crosticina.", "foto": ["https://img-global.cpcdn.com/steps/5d19ca48a2d7f554/400x400cq80/photo.jpg", "https://img-global.cpcdn.com/steps/3b83aa7b0b127f46/400x400cq80/photo.jpg"]}]},
