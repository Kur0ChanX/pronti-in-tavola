]}, {"t": "Diluisci la crema rimasta aggiungendo il latte e la panna rimasti da parte e distribuiscila sulle crepes.", "foto": []}, {"t": "Termina coi 5 g di grana tenuti da parte, altre foglie di basilico e cuoci a 200º per 20'.", "foto": []}], "autore": "Fit with Fun", "nutr": {"kcal": 139.0, "prot": 11.2, "carb": 8.0, "zuc": 2.5, "grassi": 7.2, "saturi": 3.5, "sodio": 246.6}, "dolce": false, "stimata": true},
