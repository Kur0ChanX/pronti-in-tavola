   {"id": "gh:parmigiana-di-melanzane-low-carb-4-ingredienti-in-friggitrice-ad-aria", "nome": "PARMIGIANA DI MELANZANE LOW CARB - 4 ingredienti, in friggitrice ad aria!", "foto": "https://www.giuseppehealthy.it/wp-content/uploads/2025/10/PARMIGIANA-BIANCA-IN-FRIGGITRICE-AD-ARIA.jpg", "url": "https://www.giuseppehealthy.it/it/ricetta/parmigiana-di-melanzane-low-carb-4-ingredienti-in-friggitrice-ad-aria/", "porzioni": 4, "ingredienti": ["2-3 melanzane", "100g parmigiano", "150g prosciutto cotto (o fesa di tacchino)", "250g formaggio a pasta filata (io mozzarella proteica)", "q.b. sale/olio evo"], "totale": 85, "passi": [{"t": "Lava le melanzane e rimuovi da ognuna le estremità; ricavane delle fette sottili e lasciale riposare almeno 30 minuti sotto sale.", "foto": []}, {"t": "Trascorso il tempo necessario sciacqua le melanzane ed asciugale!", "foto": []}, {"t": "Non ti resta che assemblare la tua parmigiana direttamente nella friggitrice ad aria, partendo dal primo strato a base di melanzane, un giro di olio, un secondo strato a base di parmigiano, un terzo strato con il prosciutto ed il quarto strato con il formaggio; ripeti il procedimento fino alla fine degli ingredienti (fai almeno 4 strati). Schiaccia bene tutti gli strati, in modo tale che il risultato sarà ben compatto.", "foto": []}], "autore": "Giuseppe Healthy", "video": "https://www.youtube.com/watch?v=EIPOWd9OHac", "nutr": {"kcal": 297.5, "prot": 28.8, "carb": 0.4, "zuc": 0.4, "grassi": 20.1, "saturi": 8.4, "sodio": 294.5}, "dolce": false, "stimata": true},
