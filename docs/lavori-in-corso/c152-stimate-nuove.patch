   {"id": "fw:torta-fredda-di-brownie-al-tiramisu-proteica-e-senza-zucchero", "nome": "Torta Fredda di Brownie al Tiramisù Proteica e Senza Zucchero", "foto": "https://fitwithfun.it/wp-content/uploads/2023/07/Torta-Fredda-di-Brownie-al-Tiramisu-Proteica-e-Senza-Zucchero-.jpg", "url": "https://fitwithfun.it/torta-fredda-di-brownie-al-tiramisu-proteica-e-senza-zucchero/", "porzioni": 2, "ingredienti": ["1 uovo", "150 g albume", "150 g banana", "1 pizzico lievito per dolci", "60 g farina di avena istantanea", "20 g farina di carrube (leggi note in fondo)", "Q.b. caffè espresso", "100 g ricotta", "Q.b. eritritolo o xilitolo (o dolcificante preferito)"], "totale": 14, "passi": [{"t": "Frulla la banana con uovo, albume, 1 cucchiaio di caffè.", "foto": []}, {"t": "In una ciotola unisci le farine col lievito e versa a poco a poco il frullato rendendo omogeneo.", "foto": []}, {"t": "Versa in una pirofila adatta al microonde e cuoci a 800 W per circa 6' aprendo lo sportello ogni 2'.", "foto": []}, {"t": "Lascia raffreddare la torta poi mettila su un piatto, bagnala col caffè in cima poi riponi in frigo.", "foto": []}, {"t": "Unisci la ricotta al dolcificante e a della vaniglia (se la usi).", "foto": []}, {"t": "Quando la torta sarà fredda e asciutta, ricopri con la ricotta e rimetti nuovamente in frigo per qualche ora o meglio ancora per tutta la notte", "foto": []}, {"t": "Al momento di servire spolvera col cacao.", "foto": []}], "autore": "Fit with Fun", "nutr": {"kcal": 334.4, "prot": 21.0, "carb": 38.4, "zuc": 18.7, "grassi": 10.4, "saturi": 5.0, "sodio": 202.5}, "dolce": true, "stimata": true},
   {"id": "fw:torta-fredda-di-crepes-al-tiramisu-proteica-e-senza-glutine", "nome": "Torta Fredda di Crepes al Tiramisù Proteica e Senza Glutine", "foto": "https://fitwithfun.it/wp-content/uploads/2020/05/Torta-Fredda-di-Crepes-al-Tiramisu-Proteica-e-Senza-Glutine-1.jpg", "url": "https://fitwithfun.it/torta-fredda-di-crepes-al-tiramisu-proteica-e-senza-glutine/", "porzioni": 8, "ingredienti": ["120 g albume", "120 g latte preferito", "70 g Farina di Ceci (o preferita)", "30 g proteine alla vaniglia (facoltative)", "1 pizzico lievito per dolci (o cremor tartaro o bicarbonato)", "50 g mascarpone", "120 g ricotta", "120 g yogurt 0%", "30 g proteine alla vaniglia", "q.b. caffè amaro liquido della moka", "q.b. cacao amaro in polvere"], "totale": 65, "passi": [{"t": "Metti tutti gli ingredienti in una ciotola ed unisci con uno sbattitore elettrico dopodiché poni in frigo.", "foto": []}, {"t": "In una ciotola unisci latte e albume e in un'altra unisci la farina di ceci, le proteine e il lievito.", "foto": []}, {"t": "Setaccia gli ingredienti secchi unendoli ai liquidi girando man a mano con una frusta a mano.", "foto": []}, {"t": "Una volta terminati gli ingredienti e aver unito bene, rivesti con pellicola trasparente e lascia riposare 30' in frigo (per far sì che si sciolgano eventuali grumi).", "foto": []}, {"t": "Trascorso questo tempo, scalda una padella in pietra (io ne ho usata una da 15 cm e ho ricavato 7 crepes).", "foto": []}, {"t": "Versa 1/2 mestolo di impasto e lascia cuocere la crepe, appena i bordi iniziano a staccarsi, girala dall'altro lato e lascia cuocere meno di un minuto.", "foto": []}, {"t": "Prosegui fino a terminare l'impasto poi lascia intiepidire.", "foto": []}, {"t": "Poggia una crepe su un piatto e spennella col caffè, poi prendi circa 40 g di crema e spalmala sulla crepe.", "foto": []}, {"t": "Prosegui con un'altra crepe fino a terminare le crepe e lasciando della crema per i bordi.", "foto": []}, {"t": "Lascia riposare almeno 30' in frigo e termina la decorazione al momento di servire.", "foto": []}, {"t": "Spalma la crema sopra e sui bordi, spolvera in cima col cacao.", "foto": []}, {"t": "Gusta fredda e conserva in frigo!", "foto": []}], "autore": "Fit with Fun", "nutr": {"kcal": 110.0, "prot": 10.8, "carb": 3.7, "zuc": 2.4, "grassi": 5.9, "saturi": 2.6, "sodio": 104.1}, "dolce": false, "stimata": true},
   {"id": "fw:torta-della-nonna-fit-light-proteica-e-senza-zucchero", "nome": "Torta della Nonna Fit Light Proteica e Senza Zucchero", "foto": "https://fitwithfun.it/wp-content/uploads/2022/04/Torta-della-Nonna-Fit-Light-Proteica-e-Senza-Zucchero-1.jpg", "url": "https://fitwithfun.it/torta-della-nonna-fit-light-proteica-e-senza-zucchero/", "porzioni": 6, "ingredienti": ["60 g avena istantanea integrale (leggi le note in fondo)", "40 g avena istantanea + whey (leggi le note in fondo)", "50 g albume", "10 g burro o olio preferito", "Q.b. scorza di limone", "1 uovo", "50 g latte vegetale", "10 g succo di limone", "Q.b. scorza di limone", "10 g farina o amido preferiti", "1 cucchiaio eritritolo o xilitolo (o dolcificante q.b.)", "1 pizzico curcuma"], "totale": 40, "passi": [{"t": "In una ciotoloa metti i 2 tipi di avena con la scorza di limone e un pizzico di sale ed unisci.", "foto": []}, {"t": "Aggiungi l'albume e il burro tenuto almeno 15' fuori dal frigo.", "foto": []}, {"t": "Unisci in modo omogeneo poi chiudi l'impasto in pellicola trasparente e lascia riposare in frigo per circa 30'.", "foto": []}, {"t": "Intanto prepara la crema mettendo tutti gli ingredienti in un pentolino (puoi mettere la scorza intera e poi toglierla a fine cottura oppure grattugiarla).", "foto": []}, {"t": "Metti su fiamma media e porta a densità girando spesso.", "foto": []}, {"t": "Preriscalda il forno a 180°.", "foto": []}, {"t": "Prendi la pasta frolla e dividila a metà, facendo in modo che una parte sia appena maggiore rispetto all'altra.", "foto": []}, {"t": "Stendi la parte più grande tra 2 fogli di carta forno e sistemala poi in uno stampo per crostate smontabile (il mio è da 14 cm).", "foto": []}, {"t": "Con la forchetta fai dei buchetti sul fondo poi farcisci con la crema.", "foto": []}, {"t": "Stendi col mattarello anche l'altra parte di frolla e adagiala sulla crostata, unendo i bordi e facendo anche in cima i buchini con la forchetta.", "foto": []}, {"t": "Inforna per circa 20/30' poi lascia intiepidire prima di toglierla dal forno.", "foto": []}, {"t": "Lascia riposare in frigo per qualche ora almeno e toglila 15' prima di gustarla.", "foto": []}, {"t": "Al momento di servire, cospargi con i pinoli e zucchero a velo.", "foto": []}], "autore": "Fit with Fun", "nutr": {"kcal": 101.4, "prot": 9.0, "carb": 8.2, "zuc": 1.0, "grassi": 3.6, "saturi": 1.7, "sodio": 47.6}, "dolce": true, "stimata": true},
