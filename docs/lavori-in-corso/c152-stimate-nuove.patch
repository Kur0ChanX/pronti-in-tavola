+  {"id": "cp:14325346", "nome": "Kiwi cheesecake fit", "foto": "https://img-global.cpcdn.com/recipes/04fab34b91dc0987/1200x630cq80/photo.jpg", "url": "https://cookpad.com/it/ricette/14325346", "porzioni": 1, "ingredienti": ["1 e mezza fetta biscottata integrale", "Succo di un’arancia piccola", "1 kiwi", "50 grammi yogurt greco senza grassi", "50 grammi skyr bianco", "5 grammi gocce di cioccolato"], "totale": 0, "passi": [{"t": "Schiacciare le fette biscottate e unire al succo d’arancia. Poi versarle dentro un coppa pasta per formare la base compatta", "foto": []}, {"t": "Mescolare insieme lo yogurt e lo skyr e versare dentro il coppa pasta", "foto": []}, {"t": "Frullare il kiwi e versare dentro il coppa pasta, decorando con 2 fette di kiwi e le gocce di cioccolato", "foto": []}, {"t": "Lasciare riposare in frigo", "foto": []}], "nutr": {"kcal": 183.1, "prot": 12.0, "carb": 19.9, "zuc": 15.7, "grassi": 6.1, "saturi": 3.3, "sodio": 72.0}, "dolce": true, "stimata": true},
+  {"id": "cp:17315485", "nome": "Porridge lotus con yogurt greco e fragole", "foto": "https://img-global.cpcdn.com/recipes/d049fe5d229d2933/1200x630cq80/photo.jpg", "url": "https://cookpad.com/it/ricette/17315485", "porzioni": 1, "ingredienti": ["150 g yogurt greco", "1/2 fragole", "2 biscotti lotus", "30 g fiocchi d’avena", "60 ml latte", "qb dolcificante"], "totale": 0, "passi": [{"t": "In una tazza o ciotolina versare i fiocchi d’avena, il latte, le fragole tagliate a cubetti, 60 g di yogurt greco e una o due gocce di dolcificante e mescolare. Lasciare in frigo fino alla mattina dopo", "foto": []}, {"t": "Togliere dal frigo, aggiungere 90 g di yogurt greco, un biscotto sbriciolato e uno intero", "foto": []}], "nutr": {"kcal": 300.0, "prot": 19.5, "carb": 27.7, "zuc": 10.1, "grassi": 11.8, "saturi": 6.6, "sodio": 90.9}, "dolce": true, "stimata": true},
+  {"id": "cp:7172714", "nome": "Polpette tonno e patate", "foto": "https://img-global.cpcdn.com/recipes/8e6c304bd517cc5c/1200x630cq80/photo.jpg", "url": "https://cookpad.com/it/ricette/7172714", "porzioni": 2, "ingredienti": ["2 lattine di tonno da 80 g", "1 patata", "1 uovo", "1 fetta di pane raffermo", "q.b Sale", "q.b Pepe nero", "q.b Prezzemolo (facoltativo)", "Pangrattato", "Olio di semi o arachidi per friggere"], "totale": 0, "passi": [{"t": "Lessate una grossa patata, poi pelatela e schiacciate con una forchetta o uno schiacciapatate.", "foto": []}, {"t": "Mettete una fetta di pane raffermo in ammollo con un po' d'acqua.", "foto": []}, {"t": "Sgocciolate e sminuzzate il tonno e poi unite alla patata schiacciata.", "foto": []}, {"t": "Aggiungere la fetta di pane sbriciolata, l'uovo, un pizzico di sale, il prezzemolo e il pepe nero.", "foto": []}, {"t": "Impastare e formare tante piccole polpettine che successivamente passerete nel pangrattato.", "foto": []}, {"t": "Friggere in abbondante olio di semi o infornate a 200° per 10 minuti e dopo averle girate per altri 10 minuti. Servite calde o fredde.", "foto": []}], "nutr": {"kcal": 251.1, "prot": 16.2, "carb": 20.9, "zuc": 1.1, "grassi": 11.6, "saturi": 3.0, "sodio": 213.3}, "dolce": false, "stimata": true},
+  {"id": "cp:24765009", "nome": "Pancakes con yogurt e fragole", "foto": "https://img-global.cpcdn.com/recipes/a94451056f857998/1200x630cq80/photo.jpg", "url": "https://cookpad.com/it/ricette/24765009", "porzioni": 1, "ingredienti": ["70 gr farina tipo 1", "50 gr yogurt greco", "75 ml albume", "3 gr stevia", "125 ml acqua", "10 gr polvere lievitante", "70 gr yogurt greco bianco", "Semi di lino", "6-7 fragole", "10 gr burro di arachidi"], "totale": 0, "passi": [{"t": "Unisci gli ingredienti indicati nella sezione ‘pancakes’ cuoci poi in padella", "foto": ["https://img-global.cpcdn.com/steps/1444a4ca41804b11/400x400cq80/photo.jpg", "https://img-global.cpcdn.com/steps/0136dc5cf30eaa64/400x400cq80/photo.jpg"]}, {"t": "Fai raffreddare per qualche minuto poi aggiungi delle fragole a pezzetti e del burro di arachidi. Al centro invece disponi lo yogurt greco mescolato con dei semi di lino", "foto": ["https://img-global.cpcdn.com/steps/59d1c0c8d3baa90c/400x400cq80/photo.jpg", "https://img-global.cpcdn.com/steps/b262b5444d5b13c3/400x400cq80/photo.jpg"]}], "nutr": {"kcal": 464.2, "prot": 29.8, "carb": 61.1, "zuc": 11.8, "grassi": 12.4, "saturi": 5.3, "sodio": 213.4}, "dolce": true, "stimata": true},
+  {"id": "bg:chezbibia/ricetta-frittata-autunnale-zucca-e-funghi", "nome": "Frittata autunnale zucca e funghi", "foto": "https://blog.giallozafferano.it/chezbibia/wp-content/uploads/2026/11/frittata-autunnale-zucca-e-funghi.jpg", "url": "https://blog.giallozafferano.it/chezbibia/ricetta-frittata-autunnale-zucca-e-funghi/", "porzioni": 4, "ingredienti": ["350 g zucca (già pulita)", "450 g funghi champignon (freschi o surgelati)", "90 g pancetta affumicata (a dadini)", "5 uova", "2 cucchiai grana (grattugiato)", "1 spicchio aglio", "salvia", "olio extravergine d'oliva", "sale"], "totale": 70, "passi": [{"t": "Tagliate la zucca a dadini piccoli. Se usate i funghi freschi puliteli con della carta da cucina inumidita e tagliateli a fettine. Schiacciate lo spicchio di aglio. Portate sul fuoco una larga padella antiaderente e fatela scaldare. Aggiungete la pancetta tagliata a dadini e un filo di olio extra vergine di oliva e lasciate rosolare la pancetta fino a quando non sarà croccante e dorata. Prelevatela con un mestolo forato e tenetela da parte.", "foto": []}, {"t": "Aggiungete lo spicchio di aglio e i dadini di zucca nella stessa padella col fondo di cottura della pancetta e cuoceteli a fiamma allegra mescolando spesso per cinque minuti. Condite con un cucchiaino di salvia secca tritata e mescolate a fondo, poi aggiungete i funghi e, se usate quelli freschi, anche mezzo bicchiere di acqua (se usate i funghi surgelati aggiungeteli direttamente senza scongelarli prima e non aggiungete acqua).Mescolate e lasciate cuocere per dieci, dodici minuti, finché le verdure non saranno morbide (e aggiungendo poca acqua al bisogno se usate i funghi freschi e il fondo di cottura si asciuga troppo).", "foto": []}, {"t": "Quando il fondo di cottura si sarà asciugato e la zucca sarà morbida eliminate l’aglio, aggiungete la pancetta tenuta da parte, aggiustate di sale e mescolate a fondo. Lasciate intiepidire. In una capiente ciotola sbatte le uova con un pizzico di sale e due cucchiai di grana grattugiato con una frusta o con una forchetta. Unite le verdure tiepide e mescolate a fondo.", "foto": []}, {"t": "Rivestite con un foglio di carta da forno una tortiera da 24 cm di diametro e versateci il composto preparato, livellandolo. Cuocete in forno statico già caldo, a 180° per circa mezz’ora, passando in modalità grill negli ultimi minuti di cottura, fino alla doratura desiderata. Sfornate, lasciate intiepidire e servite la vostra frittata autunnale zucca e funghi. Chez Bibia", "foto": []}], "nutr": {"kcal": 311.9, "prot": 19.7, "carb": 4.0, "zuc": 3.1, "grassi": 22.7, "saturi": 7.8, "sodio": 422.3}, "dolce": false, "stimata": true},
+  {"id": "bg:ioitalianoabucarest/ricetta-passatelli-fritti", "nome": "passatelli fritti su crema di peperoni: una seconda vita per l'impasto", "foto": "https://blog.giallozafferano.it/ioitalianoabucarest/wp-content/uploads/2026/11/passatelli-fritti-con-crema-di-peperoni.jpeg", "url": "https://blog.giallozafferano.it/ioitalianoabucarest/ricetta-passatelli-fritti/", "porzioni": 2, "ingredienti": ["100 g parmigiano grattugiato", "100 g pangrattato", "2 uova", "q.b. noce moscata", "q.b. scorza di limone", "2 peperoni corno di toro", "1 spicchio aglio", "q.b. olio extravergine d'oliva", "q.b. aceto di mele", "q.b. sale", "q.b. pepe", "30 g capperi sotto sale", "q.b. timo", "q.b. olio di semi (per friggere)"], "totale": 40, "passi": [{"t": "In una ciotola mescolare il Parmigiano grattugiato con il pangrattato, aggiungere le uova, una grattugiata di noce moscata e la scorza di limone. Lavorare fino a ottenere un composto omogeneo e compatto. Lasciare riposare in frigorifero per circa 30 minuti.", "foto": []}, {"t": "Arrostire i peperoni in forno a 220 °C fino a quando la pelle sarà ben abbrustolita, circa 25-30 min. Trasferirli in un recipiente coperto e lasciarli riposare per una decina di minuti. Spellarli, eliminare semi e filamenti e lasciarli scolare. Frullare la polpa con un filo d'olio extravergine, lo spicchio d'aglio, sale, pepe e qualche goccia di aceto di mele. Ottenere una crema liscia e vellutata.", "foto": []}, {"t": "Prelevare una parte dell'impasto e formare dei piccoli bocconcini irregolari, compatti e non troppo grandi. Questa è la particolarità della ricetta: invece di utilizzare tutto l'impasto per preparare i tradizionali passatelli in brodo, ne ricaviamo e conserviamo delle piccole porzioni da friggere. Scaldare abbondante olio di semi a circa 165-170 °C e friggere pochi bocconcini alla volta, fino a ottenere una doratura uniforme. Scolarli su carta assorbente.", "foto": []}, {"t": "Lava per eliminare il sale, asciuga e friggi i capperi fino a quando diventeranno croccanti, scola in un colino per eliminare l'olio in eccesso.", "foto": []}, {"t": "Distribuire la crema di peperoni sul fondo del piatto, adagiare i passatelli fritti ancora caldi e completare con i capperi fritti, le erbe aromatiche e un filo d'olio extravergine.", "foto": []}], "nutr": {"kcal": 538.9, "prot": 34.0, "carb": 42.3, "zuc": 9.3, "grassi": 24.9, "saturi": 12.6, "sodio": 1487.4}, "dolce": false, "stimata": true},
+  {"id": "cp:25720263", "nome": "Insalata di patate", "foto": "https://img-global.cpcdn.com/recipes/936f0801888e447b/1200x630cq80/photo.jpg", "url": "https://cookpad.com/it/ricette/25720263", "porzioni": 1, "ingredienti": ["3 patate piccole", "1 scatoletta di tonno", "1 mozzarella piccola", "3 cucchiaini fiocchi di latte", "q.b Olio extravergine d'oliva", "q.b Sale", "q.b insalata mista", "2 fette pan bauletto"], "totale": 0, "passi": [{"t": "Cuocere le patate in una padella con acqua. Ci vorranno circa 40 minuti.", "foto": ["https://img-global.cpcdn.com/steps/cec593fda39a99f2/400x400cq80/photo.jpg"]}, {"t": "Raffreddare le patate, pelarle, tagliarle e metterle in un piatto.", "foto": ["https://img-global.cpcdn.com/steps/c788cc9250472e35/400x400cq80/photo.jpg"]}, {"t": "Aggiungere gli altri ingredienti (tonno, fiocchi di latte, mozzarella) e condire con olio e sale.", "foto": ["https://img-global.cpcdn.com/steps/b8c49bc4c1e1c098/400x400cq80/photo.jpg"]}, {"t": "Aggiungere foglie di insalata mista e accompagnare il tutto con due fette di pane tostato in padella.", "foto": ["https://img-global.cpcdn.com/steps/cc2f96232d794063/400x400cq80/photo.jpg"]}], "nutr": {"kcal": 492.6, "prot": 31.0, "carb": 72.5, "zuc": 5.0, "grassi": 9.2, "saturi": 3.0, "sodio": 341.3}, "dolce": false, "stimata": true},
+  {"id": "cp:24913146", "nome": "Pancake con frutta e cocco", "foto": "https://img-global.cpcdn.com/recipes/ec2f456975d32918/1200x630cq80/photo.jpg", "url": "https://cookpad.com/it/ricette/24913146", "porzioni": 1, "ingredienti": ["75 gr farina integrale", "100 gr albume", "1 cucchiaio yogurt greco bianco", "5 gr stevia", "1 bustina polvere lievitante", "1 albicocca grande", "20 gr mirtillo", "5 gr scaglie di cocco", "1 cucchiaino semi chia", "1 cucchiaio confettura fragole"], "totale": 0, "passi": [{"t": "Crea l’impasto con gli ingredienti indciati e cuoci in padella per ottenere un pancake. Fai cuocere da una parte 4-5 minuti, gira e completa la cottura con altri 2-3 minuti dall’altra parte", "foto": []}, {"t": "Taglia l’albiccola a pezzetti, poi distribuiscila sul pancake insieme ai mirtilli, cocco, chia. Ho usato anche un cucchiao di confettura alla fragola distribuita nella parte centrale", "foto": ["https://img-global.cpcdn.com/steps/81fe373070b98a65/400x400cq80/photo.jpg", "https://img-global.cpcdn.com/steps/8a09059b3c99c36c/400x400cq80/photo.jpg"]}], "nutr": {"kcal": 362.6, "prot": 22.6, "carb": 51.8, "zuc": 6.6, "grassi": 7.1, "saturi": 3.8, "sodio": 177.1}, "dolce": true, "stimata": true},
+  {"id": "bg:crisemaxincucina/ricetta-mug-cake-al-microonde-alle-pesche-e-fiocchi-di-latte", "nome": "Mug cake al microonde alle pesche e fiocchi di latte", "foto": "https://blog.giallozafferano.it/crisemaxincucina/wp-content/uploads/2026/06/Mug-Cake-al-microonde-alle-pesche-e-fiocchi-di-latte.jpg", "url": "https://blog.giallozafferano.it/crisemaxincucina/ricetta-mug-cake-al-microonde-alle-pesche-e-fiocchi-di-latte/", "porzioni": 2, "ingredienti": ["100 g fiocchi di latte", "1 uovo medio", "30 g farina 00", "2 g lievito per dolci", "20 g zucchero semolato (o dolcificante)", "1 1/2 pesca", "1/2 limone (scorza grattugiata)", "1/2 pesca", "2 cucchiaini zucchero semolato"], "totale": 8, "passi": [{"t": "Per preparare la mug cake al microonde alle pesche e fiocchi di latte, iniziate lavando la pesca, eliminate il nocciolo, pelatela e tagliatela a piccoli cubetti. La l'altra metà della pesca pelatela, togliete la buccia e tagliatela a fettine sottili, in un pentolino mettete lo zucchero, fatelo sciogliere poi aggiungete le fette di pesca, fate cuocere qualche minuto, giratele e fate cuocere un minuto, spegnete il gas e fatele intiepidire.", "foto": []}, {"t": "In una ciotola schiacciate leggermente i fiocchi di latte con una forchetta, quindi aggiungete l'uovo e mescolate fino a ottenere un composto omogeneo. Unite lo zucchero, la farina, il lievito per dolci e la scorza grattugiata di limone, continuando a mescolare fino a ottenere un impasto liscio e privo di grumi. Aggiungete i cubetti di pesca e incorporateli delicatamente al composto.", "foto": []}, {"t": "Distribuite l'impasto in due cocotte da circa 8 cm di diametro e 4 cm di altezza, riempiendole per circa due terzi della loro capacità. Cuocete nel microonde a 800 W per 3 minuti. Al termine della cottura lasciate riposare le tortine per 1 minuto prima di servirle. Decoratele, se lo desiderate, con le pesche fatte cuocere in precedenza e decorate con una fogliolina di menta. Consiglio: con queste dosi si ottengono circa 200 g di impasto. In alternativa alle due cocotte potete utilizzare una tazza grande adatta al microonde per preparare una classica mug cake. Assicuratevi che sia sufficientemente capiente, poiché durante la cottura il dolce aumenta di volume.", "foto": []}], "nutr": {"kcal": 195.2, "prot": 12.1, "carb": 26.4, "zuc": 15.9, "grassi": 4.6, "saturi": 2.5, "sodio": 228.2}, "dolce": true, "stimata": true},
+  {"id": "cp:26700948", "nome": "Penne alle zucchine e philadelphia light", "foto": "https://img-global.cpcdn.com/recipes/23ad99f9ea2e7b6a/1200x630cq80/photo.jpg", "url": "https://cookpad.com/it/ricette/26700948", "porzioni": 2, "ingredienti": ["170 gr. penne", "1 zucchina di media dimensione", "150 gr. di prosciutto cotto a dadini", "2 spicchio d'aglio", "q. b. Olio extravergine di oliva", "q. b. Parmigiano reggiano", "Strumenti:"], "totale": 0, "passi": [{"t": "Prendete una zucchina e passatela sotto l'acqua corrente. Eliminate le due estremità e tagliatele con una mandolina sottili.", "foto": ["https://img-global.cpcdn.com/steps/b2660a4073eea453/400x400cq80/photo.jpg", "https://img-global.cpcdn.com/steps/22a6788764af4162/400x400cq80/photo.jpg", "https://img-global.cpcdn.com/steps/8cf1696a23cd60c1/400x400cq80/photo.jpg"]}, {"t": "In una padella ampia e dai bordi larghi mettete all'interno l'aglio con un filo d'olio extravergine di oliva. Fateli dorare poi aggiungete le zucchine sottili mescolando. Cucinate a fiamma bassa con coperchio.", "foto": ["https://img-global.cpcdn.com/steps/c19df424fbb00a46/400x400cq80/photo.jpg", "https://img-global.cpcdn.com/steps/ca36a3b8adb82f20/400x400cq80/photo.jpg"]}, {"t": "Nel frattempo mettete una pentola sul fuoco piena di acqua fredda. Chiudete con coperchio e portate bollore. Aggiustate di sale e calate le penne mescolando. Cucinate a fiamma bassa.", "foto": ["https://img-global.cpcdn.com/steps/0bc940a4fd5534f4/400x400cq80/photo.jpg"]}, {"t": "In un padellino trasferite il prosciutto cotto a dadini. Cucinate a fiamma bassa mescolando spesso fino a farli diventare croccanti. Tenete da parte.", "foto": ["https://img-global.cpcdn.com/steps/3b51e48fcc03667b/400x400cq80/photo.jpg", "https://img-global.cpcdn.com/steps/0d0ba4de19f63400/400x400cq80/photo.jpg"]}, {"t": "Togliete il coperchio e a metà cottura aggiungete del peperoncino. A fine cottura eliminate l'aglio.", "foto": ["https://img-global.cpcdn.com/steps/552b39d934fb2c7c/400x400cq80/photo.jpg"]}, {"t": "Trasferite il philadelphia all'interno di una ciotola. Aggiungete 2 cucchiai di acqua di cottura. Mescolate bene fino a creare una crema molto morbida e vellutata.", "foto": ["https://img-global.cpcdn.com/steps/763429adb93b4b03/400x400cq80/photo.jpg", "https://img-global.cpcdn.com/steps/cbb8d53f9a9cda54/400x400cq80/photo.jpg"]}, {"t": "Trasferite le penne in padella al dente aggiungendo ancora un paio di cucchiai di acqua di cottura. Alzate la fiamma e fate restringere il sughetto mescolando velocemente. Spegnete la fiamma.", "foto": ["https://img-global.cpcdn.com/steps/350154b56fbcb9c0/400x400cq80/photo.jpg"]}, {"t": "Preparate i piatti da portata. Trasferite le penne all'interno delicatamente aggiungendo il prosciutto cotto croccante e del pepe nero fresco. Mettete un filo d'olio extravergine d'oliva a crudo sulle penne. Terminate con una grattugiata di parmigiano a fori larghi. Buon appetito a voi!!", "foto": []}], "nutr": {"kcal": 411.9, "prot": 25.4, "carb": 64.8, "zuc": 3.5, "grassi": 6.8, "saturi": 2.4, "sodio": 634.5}, "dolce": false, "stimata": true},
+  {"id": "cp:15571358", "nome": "Torretta pancakes proteica", "foto": "https://img-global.cpcdn.com/recipes/76fe26a4ba5837c7/1200x630cq80/photo.jpg", "url": "https://cookpad.com/it/ricette/15571358", "porzioni": 1, "ingredienti": ["100 ml albumi", "50 g farina 00", "Q.b. paprika", "Q.b. curcuma", "Q.b. noce moscata", "Q.b. acqua", "1 pizzico sale", "1 porro", "2 zucchine medie", "Q.b. radicchio rosso", "30 g formaggio feta", "1 cucchiaio olio evo", "Q.b acqua", "Q.b. prezzemolo tritato", "sale e pepe"], "totale": 0, "passi": [{"t": "Tagliate le estremità del porro, togliete il primo strato e tagliate finemente; lo utilizzeremo per fare un leggero soffritto cucinare le verdure.", "foto": []}, {"t": "Tagliate le estremitaà alle zucchine, lavatele e tagliatele a cubetti. Portate una padella sul fuoco con mezzo cucchiaio di olio evo e metà del porro preparato precedentemente. Fate soffriggere. Unite le zucchine e il prezzemolo. Correggete di sale e pepe. Fate cuocere fino a che le zucchine non risulteranno morbide. Al bisogno aggiungete un po' d'acqua. Fate raffreddare.", "foto": ["https://img-global.cpcdn.com/steps/76ac7d002141587c/400x400cq80/photo.jpg", "https://img-global.cpcdn.com/steps/e793815406204f32/400x400cq80/photo.jpg", "https://img-global.cpcdn.com/steps/c681ed7589b959c7/400x400cq80/photo.jpg"]}, {"t": "Eseguite lo stesso procedimento delle zucchine con il radicchio. Quando sarà appassito ì unite il formaggio feta e fate sciogliere fino ad ottenere una cremina. Fate raffreddare.", "foto": ["https://img-global.cpcdn.com/steps/27cb11cbc9a7d171/400x400cq80/photo.jpg", "https://img-global.cpcdn.com/steps/668f74bc5894e9ce/400x400cq80/photo.jpg", "https://img-global.cpcdn.com/steps/d474d2965e1d382b/400x400cq80/photo.jpg"]}, {"t": "In una ciotola unite tutti gli ingredienti per prepareare il pancakes. Mescolate bene. Potete aggiungere le spezie che piu' vi aggradano. Scaldate una padella antiaderente, prendete un mestolo di impasto e versatelo nella padella. Quando si sarà rappreso con una paletta giratelo e fate cuocere anche il secondo lato. Ci vorrà circa un minuto in tutto.", "foto": ["https://img-global.cpcdn.com/steps/f33a11b87207f631/400x400cq80/photo.jpg"]}, {"t": "Una volta preparati i pancakes preparate la torretta farcendo i vari strati con le verdure. Io l'ho provata sia calda che fredda e mi è piaciuta in entrambe le versioni.", "foto": ["https://img-global.cpcdn.com/steps/53ae85222c40c854/400x400cq80/photo.jpg", "https://img-global.cpcdn.com/steps/4a9fd13f7a23adc0/400x400cq80/photo.jpg", "https://img-global.cpcdn.com/steps/ee8ccdc45b9797ee/400x400cq80/photo.jpg"]}], "nutr": {"kcal": 482.4, "prot": 28.5, "carb": 43.8, "zuc": 8.5, "grassi": 22.0, "saturi": 4.2, "sodio": 603.5}, "dolce": false, "stimata": true},
+  {"id": "cp:17095813", "nome": "Pancakes salati con frittelle di verdure e ricotta", "foto": "https://img-global.cpcdn.com/recipes/2f1a4e21e3ce3ee5/1200x630cq80/photo.jpg", "url": "https://cookpad.com/it/ricette/17095813", "porzioni": 1, "ingredienti": ["70 gr Farina tipo Integrale", "120 ml Acqua", "1 uovo", "5 mL olio Evo", "2 gr lievito istantaneo", "q.b sale", "1 carota", "1 zucchina piccola", "120 ml albume", "q.b sale e pepe", "10 ml olio evo", "5 gr semi di chia"], "totale": 0, "passi": [{"t": "Unisci gli ingredienti e prepara i pancakes", "foto": ["https://img-global.cpcdn.com/steps/79218733ae00d080/400x400cq80/photo.jpg"]}, {"t": "Grattugia una carota ed una zucchina, aggiungo sale, pepe, olio evo, albume e semi di chia", "foto": ["https://img-global.cpcdn.com/steps/6b0a3ddf495681b1/400x400cq80/photo.jpg"]}, {"t": "Mescola per bene gli ingredienti e cuoci le frittelle in padella antiaderente. Gira un paio di volte fino alla completa cottura", "foto": ["https://img-global.cpcdn.com/steps/85507d0244c35c89/400x400cq80/photo.jpg", "https://img-global.cpcdn.com/steps/d6e5071f7e23a657/400x400cq80/photo.jpg"]}, {"t": "Una volta pronte le frittelle di verdure e i pancakes, impila spalmando su ogni strato che andrai a creare della ricotta vaccina Potresti anche non impilare o fare una pila meno estesa per evitare che si schiantino al suolo 🙃", "foto": ["https://img-global.cpcdn.com/steps/eb3bcece9b149c4e/400x400cq80/photo.jpg", "https://img-global.cpcdn.com/steps/3c1d63ee585ca5dd/400x400cq80/photo.jpg", "https://img-global.cpcdn.com/steps/cbc7478df53bc8f0/400x400cq80/photo.jpg"]}], "nutr": {"kcal": 572.2, "prot": 33.1, "carb": 61.0, "zuc": 11.5, "grassi": 22.4, "saturi": 4.6, "sodio": 355.4}, "dolce": false, "stimata": true},
+  {"id": "cp:24631175", "nome": "Pancakes salati con Hummus di ceci e verdure", "foto": "https://img-global.cpcdn.com/recipes/26dc27e14aff640f/1200x630cq80/photo.jpg", "url": "https://cookpad.com/it/ricette/24631175", "porzioni": 1, "ingredienti": ["50 gr farina", "60 ml acqua", "50 ml albume pastorizzato", "Sale, pepe nero", "10 gr polvere lievitane", "240 gr ceci cotti", "Sale, succo di limone, paprika", "1 carota", "5/6 pomodorini", "Olio evo, pepe, origano, semi di zucca, semi di lino"], "totale": 0, "passi": [{"t": "Monta a neve ferma gli albumi poi aggiungi lentamente tutti gli altri ingredienti. Mescola delicatamente gli ingredienti fini ad ottenere un composto omogeneo.", "foto": []}, {"t": "Riscalda la padella e versa due cucchiai di impasto per singolo pancake. Cuoci da entrambe le parti", "foto": ["https://img-global.cpcdn.com/steps/d97219cb6d3f6f65/400x400cq80/photo.jpg", "https://img-global.cpcdn.com/steps/294d654ac0537e1e/400x400cq80/photo.jpg"]}, {"t": "In un frullatore versa i ceci cotti, pizzico di sale, succo di limone e della paprika. Frulla tutto aggiungendo acqua per regolarne la consistenza", "foto": []}, {"t": "Lava e taglia a fette pomodori e carote, condisci con sale, origano, olio evo", "foto": []}, {"t": "Assembla tutti gli ingredienti, aggiungi ulteriore filo di olio a crudo e dei semi sull’hummus", "foto": ["https://img-global.cpcdn.com/steps/f826c6184482cb3a/400x400cq80/photo.jpg", "https://img-global.cpcdn.com/steps/b4bc4dacda51e9ae/400x400cq80/photo.jpg"]}], "nutr": {"kcal": 496.4, "prot": 28.7, "carb": 77.7, "zuc": 11.8, "grassi": 6.3, "saturi": 1.9, "sodio": 909.1}, "dolce": false, "stimata": true},
+  {"id": "cp:25184113", "nome": "Pasta salmone e formaggio spalmabile", "foto": "https://img-global.cpcdn.com/recipes/b94b3002bd22ee5e/1200x630cq80/photo.jpg", "url": "https://cookpad.com/it/ricette/25184113", "porzioni": 2, "ingredienti": ["1 scalogno", "150 g salmone affumicato", "180 g pasta corta", "15 g burro", "25 g vino bianco", "450 g acqua", "q.b. prezzemolo o erba cipollina", "100 g formaggio spalmabile"], "totale": 0, "passi": [{"t": "Mettere nel boccale lo scalogno, tritare 5 sec. vel. 7. Raccogliere sul fondo con la spatola e aggiungere il burro e 3 min. 100° vel. Soft.", "foto": []}, {"t": "Aggiungere il salmone a pezzetti e il vino, cuocere 5 min. 100° vel. Soft antiorario. Aggiungere l’acqua e il sale, far bollire 8 min. 100° vel. Soft antiorario.", "foto": []}, {"t": "Aggiungere la pasta nell’acqua bollente cuocere impostate il tempo di cottura indicato sulla confezione. 100° vel. Soft antiorario.", "foto": []}, {"t": "A fine cottura aggiungere il formaggio spalmabile e il prezzemolo, mescolate 1 minuto velocità soft antiorario.", "foto": []}], "nutr": {"kcal": 634.7, "prot": 35.7, "carb": 67.3, "zuc": 3.8, "grassi": 26.2, "saturi": 9.6, "sodio": 1580.6}, "dolce": false, "stimata": true},
+  {"id": "cp:25131972", "nome": "397 Mini cheesecakes proteico ai frutti rossi", "foto": "https://img-global.cpcdn.com/recipes/c97295dde7fdaaec/1200x630cq80/photo.jpg", "url": "https://cookpad.com/it/ricette/25131972", "porzioni": 1, "ingredienti": ["50 ml albume", "150 g formaggio spalmabile (tipo Philadelphia light)", "15 g farina di avena", "1 Scorza di limone bio (facoltativa)", "Q.b Dolcificante a piacere (eritritolo, stevia, miele o zucchero di canna)", "100 g frutti rossi congelati (lamponi, mirtilli, ribes, more)", "1 cucchiaio d’acqua", "qualche goccia succo di limone", "q.b dolcificante", "1 Pentolino per la composta", "1 Forno o friggitrice ad aria", "In frigorifero, coperta, per 2–3 giorni. Si può congelare senza topping"], "totale": 0, "passi": [{"t": "In una ciotola, mescola albume, formaggio spalmabile e farina di avena. Aggiungi dolcificante e scorza di limone se desideri un profumo agrumato. Lavora con la frusta fino a ottenere un composto liscio.", "foto": []}, {"t": "Versa in uno stampo piccolo Ø 10–12 cm e cuoci in forno statico a 170°C per 25–30 minuti, oppure in friggitrice ad aria a 160°C per 20–25 minuti. La superficie deve essere leggermente dorata, il centro non tremolante.", "foto": []}, {"t": "Nel frattempo, cuoci i frutti rossi con l’acqua in un pentolino. Lascia sobbollire finché si sfaldano e si addensano. Puoi frullare leggermente o lasciare i pezzi interi.", "foto": []}, {"t": "Lascia raffreddare la tortina, poi spalma la composta in superficie. Servi a temperatura ambiente o fredda.", "foto": ["https://img-global.cpcdn.com/steps/6a6368c55584ad75/400x400cq80/photo.jpg"]}, {"t": "Se cerchi la ricetta passo passo per preparare una favolosa 🍓COULIS AI FRUTTI ROSSI🍒, clicca sul link in basso", "foto": []}], "nutr": {"kcal": 394.8, "prot": 22.0, "carb": 24.1, "zuc": 15.3, "grassi": 23.1, "saturi": 6.8, "sodio": 85.3}, "dolce": true, "stimata": true},
+  {"id": "cp:24961408", "nome": "Pancakes Sicily Edition ️", "foto": "https://img-global.cpcdn.com/recipes/4b80237cd741e4c3/1200x630cq80/photo.jpg", "url": "https://cookpad.com/it/ricette/24961408", "porzioni": 1, "ingredienti": ["75 gr farina tipo 00", "75 ml albume", "4 gr stevia", "1/2 bustina polvere lievitante", "1 cucchiaio yogurt greco", "100 no latte ps", "1 bicchiere granita alla fragola", "1 quadretto cioccolato 90%"], "totale": 0, "passi": [{"t": "Unire gli ingredienti presente nella sezione ‘impasto’, cuocere i pancakes in una padella pre-riscaldata", "foto": []}, {"t": "Fai raffreddare i pancakes prima di farcire con la granita. Aggiungi dei pezzetti di cioccolato per completare il piatto", "foto": ["https://img-global.cpcdn.com/steps/988e051e44548b27/400x400cq80/photo.jpg", "https://img-global.cpcdn.com/steps/8045a2fe425cb6f6/400x400cq80/photo.jpg"]}], "nutr": {"kcal": 349.1, "prot": 19.4, "carb": 65.5, "zuc": 13.1, "grassi": 2.2, "saturi": 0.9, "sodio": 136.8}, "dolce": true, "stimata": true},
+  {"id": "cp:14817037", "nome": "Fusilli integrali peperoni, fiocchi di latte e pomodori secchi", "foto": "https://img-global.cpcdn.com/recipes/8a02aee2976b7d5d/1200x630cq80/photo.jpg", "url": "https://cookpad.com/it/ricette/14817037", "porzioni": 2, "ingredienti": ["200 g fusilli integrali", "2 peperoni rossi piccoli", "2 pomodori secchi", "50 g parmigiano", "100 g fiocchi di latte", "q.b. basilico fresco"], "totale": 0, "passi": [{"t": "Tagliate i peperoni a pezzettini e cuoceteli in padella per 10 minuti con un po’ d’olio EVO.", "foto": []}, {"t": "Una volta pronti mettete tutti gli ingredienti in un frullatore e nel frattempo lessate la pasta.", "foto": []}, {"t": "Una volta scolata amalgamate il sugo aggiungendo un po’ di acqua di cottura e servite.", "foto": []}], "nutr": {"kcal": 548.2, "prot": 30.1, "carb": 83.5, "zuc": 13.1, "grassi": 11.4, "saturi": 6.4, "sodio": 350.0}, "dolce": false, "stimata": true},
+  {"id": "cp:24765048", "nome": "Pancakes ai mirtilli", "foto": "https://img-global.cpcdn.com/recipes/14cd14da98295b0e/1200x630cq80/photo.jpg", "url": "https://cookpad.com/it/ricette/24765048", "porzioni": 2, "ingredienti": ["120 gr farina tipo 1", "120 ml albume", "60 gr yogurt greco bianco magro", "4 gr stevia", "4 gocce aromatizzante vaniglia", "15 gr polvere lievitante", "100 ml acqua", "50 gr mirtilli", "Banana", "Cioccolato", "Yogurt greco bianco"], "totale": 0, "passi": [{"t": "Unisci e crea un impasto con gli ingredienti indicati nella sezione ‘pancakes’ poi cuoci su padella calda antiaderente (o sulla qualche hai strofinato un tovagliolo leggermente oleato)", "foto": ["https://img-global.cpcdn.com/steps/c361d141a8e7556c/400x400cq80/photo.jpg", "https://img-global.cpcdn.com/steps/8c4a0be8396add5f/400x400cq80/photo.jpg", "https://img-global.cpcdn.com/steps/cde3743ac2421b80/400x400cq80/photo.jpg"]}, {"t": "Crea una pila fino ad esaurimento dei pancakes, ad ogni strato aggiungi un cucchiaino di yogurt greco. Nella parte finale aggiungi della banana a fette e del cioccolato fuso", "foto": ["https://img-global.cpcdn.com/steps/e9843b47918f25e6/400x400cq80/photo.jpg", "https://img-global.cpcdn.com/steps/073ad2dccb122df9/400x400cq80/photo.jpg"]}], "nutr": {"kcal": 306.6, "prot": 16.7, "carb": 57.6, "zuc": 14.1, "grassi": 2.3, "saturi": 1.2, "sodio": 114.5}, "dolce": true, "stimata": true},
+  {"id": "bg:lacucinadiloredana/ricetta-budino-al-latte-e-melagrana", "nome": "BUDINO AL LATTE E MELAGRANA fresco e delizioso", "foto": "https://blog.giallozafferano.it/lacucinadiloredana/wp-content/uploads/2026/11/budino-al-latte-e-melagrana.jpg", "url": "https://blog.giallozafferano.it/lacucinadiloredana/ricetta-budino-al-latte-e-melagrana/", "porzioni": 4, "ingredienti": ["400 ml latte", "70 g zucchero", "Mezza bacca vaniglia", "30 g amido di mais", "4 g gelatina in fogli", "200 ml succo di melagrana, fresco", "40 g zucchero", "4 g gelatina in fogli", "2 cucchiai melagrana (chicchi per decorare)"], "totale": 30, "passi": [{"t": "Lasciate ammorbidire i fogli di gelatina in acqua fredda. Versate in una casseruola, l'amido di mais e lo zucchero. Versate a filo il latte mescolando bene con una frusta per sciogliere tutti i grumi. Aggiungete i semi e il baccello di vaniglia. Trasferite la casseruola sul fornello a fiamma bassa e mescolate continuamente finché il composto non inizia a velare il cucchiaio e a addensarsi (ci vorranno circa 5 minuti dal bollore).", "foto": []}, {"t": "Rimuovete il baccello e unite la gelatina strizzata. Mescolate per farla sciogliere nel latte. Versate la crema di latte in 4 bicchieri o stampini monoporzione, riempiendoli per 2/3. Lasciate intiepidire a temperatura ambiente, poi trasferite in frigorifero per 2 ore a rassodare.", "foto": []}, {"t": "Mettete in acqua fredda i fogli di gelatina ad ammorbidire. In un piccolo pentolino, scaldate il succo di melagrana insieme allo zucchero fino a farlo sciogliere completamente (senza farlo bollire troppo). Strizzate la gelatina e scioglietela nel succo caldo mescolando energicamente. Lasciate intiepidire il succo di melagrana per qualche minuto a temperatura ambiente (non deve essere bollente altrimenti scioglierà lo strato di latte sottostante).", "foto": []}, {"t": "Riprendete i bicchieri con il budino al latte ormai ben sodo dal frigorifero. Versate delicatamente sopra lo strato di latte il succo di melagrana intiepidito. Riponete nuovamente in frigorifero per almeno 2 ore, finché anche la copertura non sarà perfettamente rappresa. Prima di portare in tavola, decorate la superficie con qualche chicco di melagrana Portare in tavola il Budino al latte con gelée di melagrana significa regalare ai vostri ospiti un finale di pasto che sa di coccola e di festa. La dolcezza vellutata della crema alla vaniglia incontra la freschezza brillante e il colore rubino di un frutto che, secondo la tradizione, custodisce in ogni chicco un augurio di fortuna e prosperità. Semplice da realizzare ma di grande impatto visivo, questo dolce al cucchiaio conquisterà tutti al primo assaggio, chiudendo la serata con eleganza e leggerezza. Non vi resta che mettervi all'opera e lasciarvi conquistare dalla magia delle cose fatte in casa.", "foto": []}], "nutr": {"kcal": 423.3, "prot": 22.8, "carb": 40.1, "zuc": 33.6, "grassi": 20.0, "saturi": 12.7, "sodio": 453.5}, "dolce": false, "stimata": true},
+  {"id": "cp:24879768", "nome": "Pancakes. Good way to start the week", "foto": "https://img-global.cpcdn.com/recipes/455bbb058795ea01/1200x630cq80/photo.jpg", "url": "https://cookpad.com/it/ricette/24879768", "porzioni": 1, "ingredienti": ["50 gr farina tipo 0", "75 ml albume", "Spolverata di cannella", "Bicarbonato/succo di limone", "3 gr stevia", "4 gocce aromatizzante alla vaniglia", "50 gr ricotta di vacca", "3 gr cannella il polvere", "50 gr uva", "Granola", "10 gr cioccolato 74%"], "totale": 0, "passi": [{"t": "Monta a neve gli albumi poi aggiungi gli altri ingredienti. Mescola l’impasto poi cuoci a fiamma bassa in padella (da entrambe le parti)", "foto": []}, {"t": "In un contenitore mescola la ricotta con la cannella. Se il composto risulta troppo compatto, aggiungi anche qualche goccia di latte/acqua", "foto": []}, {"t": "Farcisci il pancakes con la ricotta, l’uva, Granola ed il cioccolato", "foto": ["https://img-global.cpcdn.com/steps/200a1e40ccc956d6/400x400cq80/photo.jpg"]}], "nutr": {"kcal": 353.9, "prot": 18.9, "carb": 51.0, "zuc": 16.1, "grassi": 9.6, "saturi": 5.8, "sodio": 177.5}, "dolce": true, "stimata": true},
+  {"id": "cp:25132782", "nome": "Cake alle Mele di 3 Ingredienti", "foto": "https://img-global.cpcdn.com/recipes/61d557944137fae4/1200x630cq80/photo.jpg", "url": "https://cookpad.com/it/ricette/25132782", "porzioni": 4, "ingredienti": ["3 mele", "3 uova", "120 g yogurt greco", "50 g biscotti alla cannella o qb di cannella (opzionali)"], "totale": 0, "passi": [{"t": "Lava, detorsola e taglia le mele a pezzetti con la buccia e uniscili alle uova, yogurt e pezzetti di biscotti alla cannella nel bicchiere del frullatore o Bimby", "foto": []}, {"t": "Frulla fino a formare una crema uniforme", "foto": []}, {"t": "Versa il composto in uno stampo oleato da piccolo plumcake", "foto": []}, {"t": "Cuoci in Airfryer riscaldata 5 minuti a 160°C per circa 20-25 minuti.", "foto": []}, {"t": "Servi il cake con una decorazione a piacere", "foto": ["https://img-global.cpcdn.com/steps/e47fc32816ac6f60/400x400cq80/photo.jpg", "https://img-global.cpcdn.com/steps/4e2c71f964f26157/400x400cq80/photo.jpg"]}], "nutr": {"kcal": 178.3, "prot": 9.5, "carb": 21.3, "zuc": 13.2, "grassi": 5.9, "saturi": 2.8, "sodio": 93.3}, "dolce": true, "stimata": true},
+  {"id": "cp:24818380", "nome": "Pasta zucchine, speck e philadelphia", "foto": "https://img-global.cpcdn.com/recipes/65546829f4508b81/1200x630cq80/photo.jpg", "url": "https://cookpad.com/it/ricette/24818380", "porzioni": 1, "ingredienti": ["70 g pasta", "Q.b. sale", "1 zucchina", "25 g speck a cubetti", "2 cucchiai philadelphia"], "totale": 0, "passi": [{"t": "Taglia le zucchine alla julienne e falle cucere in una padella a fuoco alto insieme ai cubetti di speck", "foto": []}, {"t": "Fai scaldare l'acqua in un pentolino. Quando inizia a bollire, aggiungi un po' di sale e la pasta", "foto": []}, {"t": "Quando la pasta è pronta, spegni il fuoco. Aggiungi due cucchiai di philadelphia nella padella con le zucchine e lo speck e mischia per far amalgamare il tutto", "foto": []}, {"t": "Scola la pasta e mischiala al condimento", "foto": []}], "nutr": {"kcal": 441.4, "prot": 23.5, "carb": 54.6, "zuc": 4.7, "grassi": 15.1, "saturi": 4.5, "sodio": 513.8}, "dolce": false, "stimata": true},
+  {"id": "cp:25282712", "nome": "Cupole di salmone affumicato, avocado, philadelphia", "foto": "https://img-global.cpcdn.com/recipes/834ddd3484eadfa3/1200x630cq80/photo.jpg", "url": "https://cookpad.com/it/ricette/25282712", "porzioni": 4, "ingredienti": ["150 g salmone affumicato", "100 g formaggio Philadelphia o altro formaggio spalmabile", "qualche stelo erba cipollina", "1 avocado maturo", "1/2 lime (succo)", "Q.b. Sale e pepe", "4 fette pancarré", "1 limone", "Q.B. Grani pepe rosa", "4 piccole foglie di basilico"], "totale": 0, "passi": [{"t": "In uno stampo semicircolare in silicone adagiare le fette di salmone affumicato rivestendo l'intera cupoletta.", "foto": []}, {"t": "In una ciotola mescolare il philadelphia o altro formaggio spalmabile con dell'erba cipollina tagliata finemente e un pizzico di sale. Distribuire la crema di formaggio sopra al salmone per farne il primo strato.", "foto": []}, {"t": "Tagliare l'avocado a cubetti. Condirlo con sale, pepe nero e succo di limone. Distribuire l'avocado sopra alla crema di formaggio per formare il secondo strato.", "foto": []}, {"t": "Tostare il pancarré, tagliarlo con un coppapasta rotondo della stessa circonferenza della parte più larga della cupola. Chiudere la cupola.", "foto": []}, {"t": "Far riposare le cupolette in frigorifero per circa 20-30 minuti in modo che mantengano la forma.", "foto": []}, {"t": "Sformare le cupolette e decorare con una fettina di limone, una foglia di basilico e qualche grano di pepe rosa.", "foto": ["https://img-global.cpcdn.com/steps/417f84a3c57d27d5/400x400cq80/photo.jpg", "https://img-global.cpcdn.com/steps/966c0b0c7fe9bcc7/400x400cq80/photo.jpg"]}], "nutr": {"kcal": 297.1, "prot": 15.6, "carb": 14.6, "zuc": 3.5, "grassi": 19.2, "saturi": 3.8, "sodio": 903.2}, "dolce": false, "stimata": true},
+  {"id": "cp:17211281", "nome": "Pink Breakfast", "foto": "https://img-global.cpcdn.com/recipes/e760780c9593fe84/1200x630cq80/photo.jpg", "url": "https://cookpad.com/it/ricette/17211281", "porzioni": 1, "ingredienti": ["100 gr Farina integrale", "1 gr stevia", "80 gr albume", "6 gr polvere lievitante", "60 ml latte ps", "Skyr gusto fragola", "Semi di chia", "1 banana piccola"], "totale": 0, "passi": [{"t": "Monta a neve gli albumi con l’aiuto di una frusta elettrica. aggiungili all’impasto creato con la rimante parte degli ingredienti (Farina, polvere lievitante, stevia, latte) e mescola lentamente Cuoci in padella antiaderente", "foto": ["https://img-global.cpcdn.com/steps/915619aba952a28a/400x400cq80/photo.jpg"]}, {"t": "Una volta pronti, disponi su un piatto e farcisci con skyr, fette di banana e semi di chia", "foto": ["https://img-global.cpcdn.com/steps/3173153e8d25e697/400x400cq80/photo.jpg"]}], "nutr": {"kcal": 486.4, "prot": 25.5, "carb": 86.9, "zuc": 24.0, "grassi": 4.6, "saturi": 2.0, "sodio": 173.0}, "dolce": true, "stimata": true},
+  {"id": "cp:17117385", "nome": "Omelette, zafferano, formaggio spalmabile e peperoncino in polvere", "foto": "https://img-global.cpcdn.com/recipes/d719f96e114b0ebf/1200x630cq80/photo.jpg", "url": "https://cookpad.com/it/ricette/17117385", "porzioni": 1, "ingredienti": ["2 Uova grandi", "30 gr latte", "Sale, Olio evo", "q.b Burro", "q.b Peperoncino in polvere", "80 gr formaggio spalmabile senza lattosio", "1 bustina zafferano"], "totale": 0, "passi": [{"t": "Rompete le uova setacciatele con un colino a maglie fini aiutandovi con una forchetta con sotto una ciotola.", "foto": []}, {"t": "Aggiungete il latte, il sale, la bustina di zafferano e sbattete il tutto utilizzando la frusta in modo da amalgamare gli ingredienti saranno pronte quando alzando la frusta il composto verrà giù a filo.", "foto": []}, {"t": "Scaldare una padella da 20 cm, aggiungete qualche cubetto di burro e un filo d'olio evo e lasciate che si sciolga.", "foto": []}, {"t": "Versate il composto di uova e fate cuocere a fiamma moderata in questo modo l' omelette sarà morbida.", "foto": []}, {"t": "Non appena inizierà a rapprendersi ai bordi, coprite con il coperchio (se dovesse aumentare la temperatura togliete la padella dal fuoco per qualche minuto e poi rimettete la padella sul fuoco).", "foto": []}, {"t": "Ogni tanto roteate la padella delicatamente in questo modo non rimarrà sullo stesso punto e non si brucerà.", "foto": []}, {"t": "Quando l' omelette sarà morbida o bavosa e sollevandola con la spatola e il sotto è bello dorato spegnete il fuoco e lasciate che si intiepidisca un po'.", "foto": []}, {"t": "Con una sac à poche, farcite l' omelette con il formaggio spalmabile lavorato con un cucchiaio in precedenza assieme a poco latte per renderlo più cremoso.", "foto": []}, {"t": "Chiudete l' omelette delicatamente da un lato e poi dall' altro.", "foto": []}, {"t": "Ponete dolcemente l' omelette sul piatto da portata e inumidite la superficie passandoci sopra una noce di burro.", "foto": []}, {"t": "Servite l' omelette con poco peperoncino in polvere sopra e con dell' insalata realizzata con gli scarti di finocchio (foglie e gambi) conditi semplicemente con un filo d'olio evo, scorza e il succo di mezzo limone.", "foto": ["https://img-global.cpcdn.com/steps/9b9139f78b45946a/400x400cq80/photo.jpg"]}], "nutr": {"kcal": 410.4, "prot": 21.5, "carb": 1.5, "zuc": 1.5, "grassi": 35.5, "saturi": 12.2, "sodio": 429.7}, "dolce": false, "stimata": true},
+  {"id": "cp:13146813", "nome": "Frittata di cicoria catalogna con salsa cruda di pomodorini", "foto": "https://img-global.cpcdn.com/recipes/301eb520b0118641/1200x630cq80/photo.jpg", "url": "https://cookpad.com/it/ricette/13146813", "porzioni": 3, "ingredienti": ["1 mazzo di cicoria catalogna", "180 ml albumi (circa 6 uova)", "1 cucchiaio parmigiano", "1/2 cucchiaio pecorino", "2 cucchiaio olio evo", "q.b. sale", "q.b. pepe", "200 g pomodorini ciliegino", "20 mandorle", "1 cucchiaio parmigiano", "1 cucchiaio olio evo", "1/2 spicchio d'aglio", "q.b. sale", "q.b. origano"], "totale": 0, "passi": [{"t": "Separiamo le foglie dalla base del cespo, eliminiamo le foglie esterne, la parte più dura del fusto e sciacquiamo bene. Portiamo a bollore abbondante acqua salata e lessiamo la verdura per 15 minuti, dopo la scoliamo e la raffreddiamo con un d'acqua fredda. Dopodiché la strizziamo, la tagliamo a pezzetti, aggiungiamo 1 cucchiaio di olio e regoliamo di sale.", "foto": ["https://img-global.cpcdn.com/steps/1ae2cfe8157e101f/400x400cq80/photo.jpg", "https://img-global.cpcdn.com/steps/b295bda679279695/400x400cq80/photo.jpg", "https://img-global.cpcdn.com/steps/a0bd37169083145d/400x400cq80/photo.jpg"]}, {"t": "In una ciotola versiamo gli albumi, il parmigiano, il pecorino, un pizzico di pepe e con una forchetta sbattiamo il composto, aggiungiamo la cicoria e amalgamiamo il tutto. In una padella dal diametro 22 cm versiamo 1 cucchiaio di olio e quando sarà caldo versiamo il composto.", "foto": ["https://img-global.cpcdn.com/steps/0d8cf1cba6c87de1/400x400cq80/photo.jpg", "https://img-global.cpcdn.com/steps/7a6d356472e25109/400x400cq80/photo.jpg"]}, {"t": "Copriamo con il coperchio e cuociamo a fiamma alta per 1 minuti poi abbassiamo la fiamma e continuiamo la cottura per 3 minuti. Spegniamo il fuoco e senza togliere il cerchio lasciamo riposare per 5 minuti. A questo punto la frittata si sarà rappresa anche sopra e con l'aiuto di un piatto la giriamo e la facciamo cuocere dall'altro lato per 1 minuto ancora.", "foto": ["https://img-global.cpcdn.com/steps/2f07ec010c127606/400x400cq80/photo.jpg", "https://img-global.cpcdn.com/steps/aca33e711ea6ac9e/400x400cq80/photo.jpg", "https://img-global.cpcdn.com/steps/1b04c94148619b3f/400x400cq80/photo.jpg"]}, {"t": "Ora prepariamo la salsa cruda. Laviamo i pomodorini, li asciughiamo e li tagliamo a pezzi. Li versiamo dentro un tritatutto con il parmigiano, l'aglio, l'olio, il sale e l'origano. Tritiamo per 1 minuto poi aggiungiamo le mandorle, continuiamo a tritare fino a quando la salsa non sarà omogenea.", "foto": ["https://img-global.cpcdn.com/steps/2b1374b9cf59fcd4/400x400cq80/photo.jpg", "https://img-global.cpcdn.com/steps/bbaaa56f49db8fe8/400x400cq80/photo.jpg", "https://img-global.cpcdn.com/steps/829a7be765db29a7/400x400cq80/photo.jpg"]}, {"t": "Mettiamo la frittata su un piatto, la dividiamo in spicchi e sopra mettiamo la salsa cruda di pomodorini ciliegino. Si conserva benissimo per 2 giorni in frigorifero. È ottima anche fredda.", "foto": ["https://img-global.cpcdn.com/steps/daf3ce9c625654ad/400x400cq80/photo.jpg", "https://img-global.cpcdn.com/steps/2aa85c7f880d5171/400x400cq80/photo.jpg", "https://img-global.cpcdn.com/steps/c96e4e2987e5cbc9/400x400cq80/photo.jpg"]}], "nutr": {"kcal": 233.7, "prot": 12.0, "carb": 2.4, "zuc": 2.4, "grassi": 19.8, "saturi": 4.5, "sodio": 251.6}, "dolce": false, "stimata": true},
+  {"id": "cp:15587944", "nome": "Frittata arrotolata ripiena con solo albumi", "foto": "https://img-global.cpcdn.com/recipes/290ca4da0360e716/1200x630cq80/photo.jpg", "url": "https://cookpad.com/it/ricette/15587944", "porzioni": 4, "ingredienti": ["4 albumi", "4 cucchiai grana grattugiato", "2 zucchine", "Cipolla, olio evo e sale q. b", "200 g stracchino o formaggio spalmabile", "100 g lonza a fette (o affettati a piacere)", "qualche goccia limone"], "totale": 0, "passi": [{"t": "Per prima cosa versate gli albumi in una ciotola, aggiungete qualche goccia di limone e montate a neve.", "foto": ["https://img-global.cpcdn.com/steps/0e31590dd0ece236/400x400cq80/photo.jpg"]}, {"t": "Aggiungete poi del grana grattugiato ed un pizzico di sale. Versate il composto in una teglia(20 x 30 circa) ricoperta di carta forno, leggermente unta e livellate con una spatola Cuocete in forno statico a 180°per 15 minuti", "foto": ["https://img-global.cpcdn.com/steps/aa8aef22d9ef50af/400x400cq80/photo.jpg"]}, {"t": "Nel frattempo preparate le zucchine, grattugiatele e fatele sfufare in padella, per 10 minuti, con 2 cucchiai di olio, cipolla e sale", "foto": ["https://img-global.cpcdn.com/steps/658f65539e918e21/400x400cq80/photo.jpg"]}, {"t": "Sfornate la frittata e staccatela delicatamente dalla carta. Adagiatela su un foglio pulito e farcitela", "foto": ["https://img-global.cpcdn.com/steps/9c645d54d762432d/400x400cq80/photo.jpg"]}, {"t": "Distribuite le zucchine, poi la lonza ed infine lo stracchino", "foto": ["https://img-global.cpcdn.com/steps/cef50640bc94fcf3/400x400cq80/photo.jpg", "https://img-global.cpcdn.com/steps/4f72eeaa198b7c39/400x400cq80/photo.jpg", "https://img-global.cpcdn.com/steps/aa02c320901a6863/400x400cq80/photo.jpg"]}, {"t": "Arrotolate, aiutandovi con la carta, coprite con pellicola. Riponete in frigo per almeno 1 ora", "foto": ["https://img-global.cpcdn.com/steps/096c55a1c5d61cc0/400x400cq80/photo.jpg"]}, {"t": "Tagliate a fette e servite. Buon appetito 😍", "foto": ["https://img-global.cpcdn.com/steps/a1d1acc242853b2d/400x400cq80/photo.jpg", "https://img-global.cpcdn.com/steps/6c2a60db0c2b6929/400x400cq80/photo.jpg"]}], "nutr": {"kcal": 343.2, "prot": 17.6, "carb": 20.7, "zuc": 2.4, "grassi": 21.4, "saturi": 7.9, "sodio": 325.8}, "dolce": false, "stimata": true},
+  {"id": "cp:25210291", "nome": "Piadina di verdure ripiena con prosciutto e Filadelfia", "foto": "https://img-global.cpcdn.com/recipes/843820790887c254/1200x630cq80/photo.jpg", "url": "https://cookpad.com/it/ricette/25210291", "porzioni": 2, "ingredienti": ["2 zucchine", "2 carote", "2 cucchiai parmigiano grattugiato", "1 cucchiaio olio extravergine di oliva", "1 patata", "q.b sale", "q.b pepe", "1 uovo"], "totale": 0, "passi": [{"t": "Prendete un contenitore e metteteli dentro uno strofinaccio pulito e grattugiate dentro le verdure. Quando sono pronte chiudete lo strofinaccio e strizzatele bene fino a quando non hanno più acqua in accesso.", "foto": ["https://img-global.cpcdn.com/steps/6bf71114621f858f/400x400cq80/photo.jpg", "https://img-global.cpcdn.com/steps/8e8a311b070f4cc0/400x400cq80/photo.jpg"]}, {"t": "Mettete le verdure nel contenitore e aggiungete un uovo, parmigiano, sale,pepe e mescolate il tutto.", "foto": ["https://img-global.cpcdn.com/steps/9b35cdebcd09f225/400x400cq80/photo.jpg"]}, {"t": "Nel frattempo mettete la carta forno su una teglia e mettete le verdure belle aperte tipo frittata e se volete potete aggiungere un cucchiaio di olio e ancora parmigiano.", "foto": ["https://img-global.cpcdn.com/steps/e94562f3e126ba0a/400x400cq80/photo.jpg"]}, {"t": "Poi accendete il forno a 180 gradi e aspettare che le verdure siano belle croccanti (scegliete voi come vi piace) poi spegnete il forno e lasciate raffreddare. quando e freddo spalmate quello che volete dentro e divertitevi.", "foto": ["https://img-global.cpcdn.com/steps/691eb8934b3caedd/400x400cq80/photo.jpg"]}, {"t": "Poi rotolate il rotolo bello croccante.. a me è piaciuto tanto 💞", "foto": []}], "nutr": {"kcal": 283.0, "prot": 14.4, "carb": 21.5, "zuc": 10.0, "grassi": 14.8, "saturi": 5.0, "sodio": 210.9}, "dolce": false, "stimata": true},
+  {"id": "cp:23940119", "nome": "Bagels homemade \"furbi\" con salmone selvaggio affumicato, zucchine grigliate e philadelphia", "foto": "https://img-global.cpcdn.com/recipes/6cdf58101685006e/1200x630cq80/photo.jpg", "url": "https://cookpad.com/it/ricette/23940119", "porzioni": 3, "ingredienti": ["250 gr farina 00", "200 gr yogurt greco", "10 gr lievito istantaneo per pizze e torte salate", "1 uovo", "1 cucchiaino sale", "q.b Olio E.V.O e semi misti per panificazione", "100 gr salmone selvaggio affumicato", "150 gr philadelphia", "2 zucchine", "q.b Rucola", "Q.b. Succo di limone, sale e Olio E.V.O"], "totale": 0, "passi": [{"t": "Iniziate preparando l'impasto dei bagels. Aggiungete alla farina, il lievito, il sale e lo yogurt greco. Impastate fino a raggiungere un impasto elastico e sodo come quello del pane (se risultasse troppo appiccicoso aggiungete farina). Dividete l'impasto in 3 parti uguali e con ciascuna create delle ciambelline adagiandole su una placca foderata con carta forno. Spennellatele con il tuorlo dell'uovo e conditele in superficie con i semini misti a piacere. Lasciatele lievitare per 30 minuti.", "foto": ["https://img-global.cpcdn.com/steps/d266dda1216362a1/400x400cq80/photo.jpg"]}, {"t": "Prima di infornare i bagels in forno statico a 180 °C per circa 30 minuti, spruzzateli con poco olio E.V.O. Una volta pronti toglieteli dal forno e fateli raffreddare. Nel frattempo tagliate le zucchine e grigliatele con poco olio E.V.O. Una volta pronte, regolatele di sale e tenetele da parte.", "foto": ["https://img-global.cpcdn.com/steps/159873ef4e8481ac/400x400cq80/photo.jpg", "https://img-global.cpcdn.com/steps/e0f80126aa82c870/400x400cq80/photo.jpg"]}, {"t": "Tagliate a metà i bagels e cominciate a farcirli: sulla metà inferiore spalmate il philadelphia, aggiungete la rucola, le fette di salmone selvaggio affumicato, un goccio di succo di limone e disponete per ultime le zucchine grigliate. Servite e buon appetito!!", "foto": ["https://img-global.cpcdn.com/steps/69254350501ef3c4/400x400cq80/photo.jpg", "https://img-global.cpcdn.com/steps/51a87ca1eb0122c4/400x400cq80/photo.jpg", "https://img-global.cpcdn.com/steps/8ed22d6ac98d9591/400x400cq80/photo.jpg"]}], "nutr": {"kcal": 598.1, "prot": 30.4, "carb": 64.9, "zuc": 6.5, "grassi": 25.1, "saturi": 8.8, "sodio": 253.3}, "dolce": false, "stimata": true}
 ];
