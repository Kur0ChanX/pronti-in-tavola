   {"id": "fw:come-realizzare-un-tiramisu-fit-light-e-proteico", "nome": "Come realizzare un Tiramisù Fit Light e Proteico", "foto": "https://fitwithfun.it/wp-content/uploads/2019/06/Come-realizzare-un-Tiramisù-Fit-Light-e-Proteico-2-.jpg", "url": "https://fitwithfun.it/come-realizzare-un-tiramisu-fit-light-e-proteico/", "porzioni": 4, "ingredienti": ["12 fette wasa", "150 g latte di cocco denso", "200 g fiocchi di latte", "30 g proteine al tiramisù", "1 moka grande di caffè", "1/2 bicchiere latte di mandorle o preferito", "10 g zucchero di canna integrale"], "totale": 20, "passi": [{"t": "Per prima cosa metti su la macchinetta del caffè e quando questo è pronto dolcifica con lo zucchero o come preferisci.", "foto": []}, {"t": "Versa il caffè in un piatto, aggiungi il latte e lascia intiepidire.", "foto": []}, {"t": "In un mixer metti il latte di cocco, i fiocchi di latte e le proteine. Meglio ancora se latte di cocco e fiocchi di latte sono freddi di frigorifero.", "foto": []}, {"t": "Prendi una pirofila, inzuppa le fette nel caffelatte e forma il primo strato.", "foto": []}, {"t": "Poi fai uno strato con la crema e prosegui fino a terminare gli ingredienti. Io ho realizzato 3 strati.", "foto": []}, {"t": "Consiglio di tenerlo tutta la notte in frigo o almeno 3 ore.", "foto": []}, {"t": "Prima di servire dai una generosa spolverata di cacao.", "foto": []}], "autore": "Fit with Fun", "nutr": {"kcal": 229.1, "prot": 13.4, "carb": 6.6, "zuc": 6.4, "grassi": 16.3, "saturi": 13.1, "sodio": 242.4}, "dolce": true, "stimata": true},
   {"id": "fw:lasagna-di-zucchine-con-ragu-di-pollo-low-carb", "nome": "Lasagna di Zucchine con Ragù di Pollo Low Carb", "foto": "https://fitwithfun.it/wp-content/uploads/2019/05/Lasagna-di-Zucchine-con-Ragù-di-Pollo-Low-Carb.jpg", "url": "https://fitwithfun.it/lasagna-di-zucchine-con-ragu-di-pollo-low-carb/", "porzioni": 1, "ingredienti": ["400 g zucchina", "140 g Macinato di Pollo/Tacchino", "100 g Passata di Pomodoro", "10 g Grana Padano", "7 g olio extravergine di oliva", "q.b. Sale e Pepe", "q.b. Porro o Cipolla"], "totale": 50, "passi": [{"t": "Lava la zucchina e tagliala a fette.", "foto": []}, {"t": "Ricopri una leccarda con carta forno e cuoci le zucchine per circa 15/20 a 200º oppure cuocile su una piastra, per evitare che riempiano la lasagna d'acqua.", "foto": []}, {"t": "In una padella metti l'olio col macinato e il porro e lascia rosolare fino a cottura della carne.", "foto": []}, {"t": "Aggiungi la Passata, sale e pepe e lascia insaporire qualche minuto.", "foto": []}, {"t": "Prendi una pirofila, la mia misura 15 x 10, fai uno strato con le zucchine e uno col ragù, poi continua con le zucchine e prosegui così fino a terminare gli ingredienti.", "foto": []}, {"t": "Termina in cima con la spolverata di pepe e grana.", "foto": []}, {"t": "Inforna per circa 20' a 200º e se ti piace la crosticina, cuoci per altri 5' al massimo o con funzione grill.", "foto": []}], "autore": "Fit with Fun", "nutr": {"kcal": 329.1, "prot": 44.8, "carb": 9.6, "zuc": 9.2, "grassi": 11.6, "saturi": 3.4, "sodio": 123.2}, "dolce": false, "stimata": true},
   {"id": "fw:torta-pancake-con-zucchine-e-bacon-senza-glutine", "nome": "Torta Pancake con Zucchine e Bacon Senza Glutine", "foto": "https://fitwithfun.it/wp-content/uploads/2019/04/Torta-Pancake-con-Zucchine-e-Bacon-Senza-Glutine-1.jpg", "url": "https://fitwithfun.it/torta-pancake-con-zucchine-e-bacon-senza-glutine/", "porzioni": 1, "ingredienti": ["1 uovo", "180 g albume", "170 g zucchina", "10 g Grana Padano", "20 g fiocchi di patate", "20 g Farina di Lupini", "20 g bacon", "q.b. zenzero fresco", "q.b. curry", "q.b. scorza di limone", "q.b. Sale e Pepe"], "totale": 25, "passi": [{"t": "Preriscalda il forno a 180º.", "foto": []}, {"t": "In una ciotola unisci uovo e albume e sbatti leggermente con una forchetta.", "foto": []}, {"t": "Aggiungi il grana, lo zenzero e la scorza di limone grattugiati, la farina, i fiocchi, il sale, le spezie e il bacon, ed unisci in modo omogeneo.", "foto": []}, {"t": "Taglia la zucchina a rondelle e metti la metà sul fondo di uno stampo in silicone da 15 cm.", "foto": []}, {"t": "Copri con l'impasto e termina con le restanti fette di zucchina.", "foto": []}, {"t": "Cuoci per circa 20'.", "foto": []}, {"t": "Servi.", "foto": []}], "autore": "Fit with Fun", "nutr": {"kcal": 254.1, "prot": 36.4, "carb": 8.9, "zuc": 4.5, "grassi": 8.7, "saturi": 4.1, "sodio": 447.2}, "dolce": false, "stimata": true},
   {"id": "fw:mini-torta-cookie-dough-ceci-arachidi-e-carrube", "nome": "Mini Torta Cookie Dough Ceci Arachidi e Carrube", "foto": "https://fitwithfun.it/wp-content/uploads/2019/04/Mini-Torta-Cookie-Dough-Ceci-Arachidi-e-Carrube.jpg", "url": "https://fitwithfun.it/mini-torta-cookie-dough-ceci-arachidi-e-carrube/", "porzioni": 1, "ingredienti": ["150 g ceci cotti", "100 g yogurt 0%", "10 g burro di arachidi 100%", "15 g Proteine Cookies & Cream", "5 g farina di arachidi", "5 g farina di carrube", "10 g gocce di cioccolato fondente", "q.b. cannella in polvere", "q.b. essenza di vaniglia"], "totale": 40, "passi": [{"t": "Metti in un mixer i ceci lavati e scolati, il burro di arachidi, le proteine, lo yogurt, la vaniglia e la cannella e aziona.", "foto": []}, {"t": "Nei 2/3 di questo composto aggiungi la farina di arachidi e le gocce di cioccolato ed unisci.", "foto": []}, {"t": "Nel restante 1/3 aggiungi quella di carrube ed unisci.", "foto": []}, {"t": "Poggia un coppa pasta su un piattino, versa la parte chiara e metti circa 30' in freezer per evitare che andando a versare la parte con la carrube si mischino.", "foto": []}, {"t": "Trascorso questo tempo prendi il piattino e termina con la parte scura.", "foto": []}, {"t": "Tieni in frigo tutta la notte e termina se vuoi con una spolverata di carrube.", "foto": []}], "autore": "Fit with Fun", "nutr": {"kcal": 361.8, "prot": 18.1, "carb": 33.5, "zuc": 13.5, "grassi": 15.6, "saturi": 4.7, "sodio": 562.9}, "dolce": false, "stimata": true},
   {"id": "fw:french-toast-tiramisu-fit-light-e-proteico", "nome": "French Toast Tiramisù Fit Light e Proteico", "foto": "https://fitwithfun.it/wp-content/uploads/2019/03/French-Toast-Tiramisù-Fit-Light-e-Proteico.jpg", "url": "https://fitwithfun.it/french-toast-tiramisu-fit-light-e-proteico/", "porzioni": 1, "ingredienti": ["3 fette pane integrale", "50 g latte di cocco denso", "50 g fiocchi di latte", "10 g proteine alla vaniglia", "30 g albume", "2 cucchiai latte preferito", "1 tazzina caffè amaro della moka", "q.b. cannella in polvere"], "totale": 20, "passi": [{"t": "Metti una padella sul fuoco e falla diventare bollente.", "foto": []}, {"t": "In un piatto metti albume, latte e cannella e sbatti con una forchetta.", "foto": []}, {"t": "Inzuppa le fette di pane su entrambi i lati e cuoci allo stesso modo.", "foto": []}, {"t": "Lascia che intiepidiscano.", "foto": []}, {"t": "Frulla i fiocchi di latte col latte di cocco e le proteine tieni in frigo.", "foto": []}, {"t": "Una volta intiepiditi i toast poggia un toast su un piattino e spalma un cucchiaio di caffè sulla superficie.", "foto": []}, {"t": "Farcisci con la crema e continua con un altro toast fino a terminare gli ingredienti.", "foto": []}, {"t": "Lascia riposare in frigo un paio d'ore o meglio ancora tutta la notte.", "foto": []}, {"t": "Al momento di servire, abbondante spolverata di cacao.", "foto": []}], "autore": "Fit with Fun", "nutr": {"kcal": 303.1, "prot": 19.9, "carb": 7.0, "zuc": 6.1, "grassi": 21.4, "saturi": 17.6, "sodio": 295.3}, "dolce": true, "stimata": true},
