   {"id": "fw:milanesa-a-la-napoletana-cotoletta-fit-light-e-saporita", "nome": "Milanese alla Napoletana Cotoletta Fit Light e Saporita", "foto": "https://fitwithfun.it/wp-content/uploads/2025/01/Milanese-alla-Napoletana-Cotoletta-Fit-Light-e-Saporita-1.jpg", "url": "https://fitwithfun.it/milanesa-a-la-napoletana-cotoletta-fit-light-e-saporita/", "porzioni": 2, "ingredienti": ["2 petti di pollo (circa 350 g)", "1 uovo", "50 g corn flakes o pangrattato", "3 cucchiai passata di pomodoro", "40 g formaggio mozzarella grattugiato", "q.b. sale, pepe e origano"], "totale": 17, "passi": [{"t": "Sbriciola i corn flakes e mettili in un piatto (oppure aggiungi il pangrattato)", "foto": []}, {"t": "In un piatto sbatti l'uovo con sale e pepe.", "foto": []}, {"t": "Taglia i petti aprendoli poi passali nell'uovo battuto e poi nei corn flakes.", "foto": []}, {"t": "In un bicchiere condisci la passata di pomodoro con sale, pepe ed origano e tieni da parte.", "foto": []}, {"t": "Cuoci in Friggitrice ad aria per circa 10' a 200° unendo pomodoro e mozzarella due minuti prima che termini la cottura.", "foto": []}, {"t": "Oppure cuoci in forno preriscaldato a 200° per circa 15' o fino a doratura e mettendo sempre pomodoro e la mozzarella.", "foto": []}, {"t": "Oppure ancora puoi cuocerle in padella, su entrambi i lati, mettere il condimento a cottura quasi ultimata e coprire con un coperchio per far sciogliere la mozzarella.", "foto": []}], "autore": "Fit with Fun", "nutr": {"kcal": 356.8, "prot": 49.8, "carb": 22.6, "zuc": 3.4, "grassi": 7.9, "saturi": 2.8, "sodio": 261.1}, "dolce": false, "stimata": true},
