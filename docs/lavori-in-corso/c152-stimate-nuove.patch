   {"id": "fw:torta-mousse-di-ricotta-cioccolato-e-patate-dolci", "nome": "Torta Mousse di Ricotta Cioccolato e Patate Dolci", "foto": "https://fitwithfun.it/wp-content/uploads/2019/08/Torta-Mousse-di-Ricotta-Senza-Glutine-sito.jpg", "url": "https://fitwithfun.it/torta-mousse-di-ricotta-cioccolato-e-patate-dolci/", "porzioni": 8, "ingredienti": ["200 g patata dolce cruda", "150 g ricotta magra", "60 g banana", "100 g albume", "30 g sciroppo d'acero", "30 g cacao amaro in polvere", "20 g fiocchi di avena senza glutine (o preferita)", "20 g Farina di Soia", "15 g gocce di cioccolato fondente", "15 g gocce di cioccolato bianco", "q.b. cannella", "q.b. vaniglia", "q.b. noce moscata", "3 g lievito per dolci"], "totale": 17, "passi": [{"t": "Cuoci la patata 5' al microonde al max potenza, a metà tempo girala.", "foto": []}, {"t": "Lascia intiepidire poi frullala con la banana, lo sciroppo, la ricotta e l'albume.", "foto": []}, {"t": "Versa in una ciotola e aggiungi la cannella, la vaniglia, la noce moscata, il lievito e le farine per poi unire bene con una forchetta.", "foto": []}, {"t": "Sembra una mousse, da qui il nome!", "foto": []}, {"t": "Aggiungi 2/3 delle gocce nell'impasto, versa in uno stampo, adatto alla cottura in microonde, da circa 15 cm.", "foto": []}, {"t": "Cospargi la superficie con le gocce di cioccolato rimaste.", "foto": []}, {"t": "Cuoci 7' al microonde a massima potenza, controllando di tanto in tanto la cottura.", "foto": []}, {"t": "In forno basteranno 20/25' a 180º", "foto": []}], "autore": "Fit with Fun", "nutr": {"kcal": 162.1, "prot": 10.1, "carb": 7.1, "zuc": 4.7, "grassi": 10.4, "saturi": 4.3, "sodio": 38.9}, "dolce": false, "stimata": true},
