   {"id": "fw:mugcake-proteica-ricotta-fichi-e-carrube", "nome": "MugCake Proteica Ricotta Fichi e Carrube", "foto": "https://fitwithfun.it/wp-content/uploads/2020/06/MugCake-Proteica-Ricotta-Fichi-e-Carrube-sito-1.jpg", "url": "https://fitwithfun.it/mugcake-proteica-ricotta-fichi-e-carrube/", "porzioni": 2, "ingredienti": ["180 g zucca (peso da cruda)", "90 g ricotta", "100 g albume", "2 fichi", "30 g Farina di Soia", "30 g farina di carrube", "20 g fiocchi di avena", "3 g lievito", "q.b. vaniglia", "1 cucchiaino cannella", "1 pizzico noce moscata", "1 cucchiaio eritritolo o xilitolo (o dolcificante q.b.)"], "totale": 15, "passi": [{"t": "Cuoci la zucca 5' in microonde.", "foto": []}, {"t": "Schiacciala con una forchetta insieme alla ricotta poi aggiungi l'albume.", "foto": []}, {"t": "Dopodiché prosegui con l'aggiungere tutte le farine (inclusi i fiocchi), gli aromi, le spezie e il lievito ed unisci in modo omogeneo con una forchetta.", "foto": []}, {"t": "Spennella il fondo di un tegame (ceramica o terracotta tra i 10 e i 15 cm) con pochissimo olio di cocco.", "foto": []}, {"t": "Taglia a metà i due fichi e posizionali sul fondo del tegame con l'interno rivolto verso il basso a formare un quadrifoglio.", "foto": []}, {"t": "Versa l'impasto sui fichi e cuoci in microonde a max potenza per circa 8' (Leggi le Note in basso).", "foto": []}, {"t": "Se vuoi dare un tocco ancora più caramellato, giralo, spolvera con zucchero di canna (non ne ho usato nemmeno un grammo), e cuoci per un altro minuto.", "foto": []}], "autore": "Fit with Fun", "nutr": {"kcal": 258.8, "prot": 17.6, "carb": 22.1, "zuc": 13.4, "grassi": 9.4, "saturi": 3.8, "sodio": 119.6}, "dolce": true, "stimata": true},
   {"id": "fw:torta-alle-mandorle-e-carrube-senza-zucchero-e-proteica", "nome": "Torta alle Mandorle e Carrube Senza Zucchero e Proteica", "foto": "https://fitwithfun.it/wp-content/uploads/2019/03/Torta-alle-Mandorle-e-Carrube-Senza-Zucchero-e-Proteica.jpg", "url": "https://fitwithfun.it/torta-alle-mandorle-e-carrube-senza-zucchero-e-proteica/", "porzioni": 6, "ingredienti": ["1 uovo", "150 g albume", "100 g yogurt 0%", "80 g banana", "30 g farina di carrube", "20 g proteine alla vaniglia", "50 g farina di mandorle", "3 g lievito per dolci"], "totale": 30, "passi": [{"t": "Preriscalda il forno a 180º.", "foto": []}, {"t": "In un mixer metti la banana, l'uovo, l'albume e lo yogurt e aziona.", "foto": []}, {"t": "A mixer spento unisci il resto degli ingredienti ed unisci in modo omogeneo.", "foto": []}, {"t": "Versa in uno stampo tondo da 15 cm in silicone o in uno rivestito con carta forno.", "foto": []}, {"t": "Inforna per circa 25'.", "foto": []}, {"t": "Lascia intiepidire.", "foto": []}], "autore": "Fit with Fun", "nutr": {"kcal": 116.3, "prot": 9.1, "carb": 6.3, "zuc": 5.7, "grassi": 5.9, "saturi": 0.9, "sodio": 73.4}, "dolce": true, "stimata": true},
   {"id": "fw:tortino-4-ingredienti-cocco-e-cioccolato-bianco-low-carb", "nome": "Tortino 4 Ingredienti Cocco e Cioccolato Bianco Low Carb", "foto": "https://fitwithfun.it/wp-content/uploads/2020/11/Tortino-4-Ingredienti-Cocco-e-Cioccolato-Bianco-Low-Carb-1.jpg", "url": "https://fitwithfun.it/tortino-4-ingredienti-cocco-e-cioccolato-bianco-low-carb/", "porzioni": 1, "ingredienti": ["40 g latte di cocco in lattina (o yogurt greco)", "80 g albume", "20 g farina di cocco degrassata", "10 g proteine al cioccolato bianco", "1 pizzico lievito per dolci (o cremor tartaro o bicarbonato)"], "totale": 17, "passi": [{"t": "Preriscalda il forno a 180º.", "foto": []}, {"t": "In una ciotola unisci il latte di cocco, l'albume e un pizzico di sale e sbatti con una forchetta.", "foto": []}, {"t": "Aggiungi gli altri ingredienti ed unisci in modo omogeneo.", "foto": []}, {"t": "Versa in uno stampo o una cocotte da 10 cm e cuoci per circa 15'.", "foto": []}, {"t": "Aspetta intiepidisca, decora e servi.", "foto": []}], "autore": "Fit with Fun", "nutr": {"kcal": 245.0, "prot": 21.1, "carb": 6.2, "zuc": 5.9, "grassi": 15.2, "saturi": 12.4, "sodio": 179.4}, "dolce": true, "stimata": true},
   {"id": "fw:torta-brownie-cocco-e-cacao-al-microonde", "nome": "Torta Brownie Cocco e Cacao al Microonde", "foto": "https://fitwithfun.it/wp-content/uploads/2019/12/Torta-Brownie-Cocco-e-Cacao-al-Microonde-sito.jpg", "url": "https://fitwithfun.it/torta-brownie-cocco-e-cacao-al-microonde/", "porzioni": 2, "ingredienti": ["70 g latte di cocco denso", "150 g albume", "25 g cacao amaro in polvere", "25 g proteine al cioccolato fondente", "10 g fiocchi di patate", "10 g farina di cocco", "q.b. Aroma Vaniglia", "1 pizzico lievito per dolci"], "totale": 9, "passi": [{"t": "In una ciotola unisci il latte di cocco con l'albume.", "foto": []}, {"t": "Aggiungi tutti gli altri ingredienti e rendi omogeneo.", "foto": []}, {"t": "Versa in uno stampo da 15 cm adatto a cottura in microonde e cuoci per circa 6' a max potenza.", "foto": []}, {"t": "Considerando che i microonde variano di potenza da modello a modello, ogni 2' apri lo sportello e controlla la cottura.", "foto": []}, {"t": "Lascia raffreddare e se vuoi decora a piacimento.", "foto": []}, {"t": "Io ho accompagnato con yogurt a cui ho aggiunto un pizzico di cocco rapé e scaglie di cioccolato fondente 85%.", "foto": []}], "autore": "Fit with Fun", "nutr": {"kcal": 286.5, "prot": 21.9, "carb": 6.1, "zuc": 3.6, "grassi": 19.5, "saturi": 15.7, "sodio": 168.1}, "dolce": false, "stimata": true},
-  {"id": "fw:torta-mugcake-bicolore-cocco-cacao-e-cioccolato-proteica", "nome": "Torta MugCake Bicolore Cocco Cacao e Cioccolato Proteica", "foto": "https://fitwithfun.it/wp-content/uploads/2021/04/Torta-MugCake-Bicolore-Cocco-Cacao-e-Cioccolato-Proteica-sito.jpg", "url": "https://fitwithfun.it/torta-mugcake-bicolore-cocco-cacao-e-cioccolato-proteica/", "porzioni": 4, "ingredienti": ["100 g polpa di mela o banana", "210 g albume", "30 g fiocchi di avena", "20 g farina di riso", "20 g farina di cocco", "10 g cacao amaro in polvere", "3 g lievito per dolci (o cremor tartaro o bicarbonato)", "q.b. vaniglia", "q.b. gocce di cioccolato fondente"], "totale": 15, "passi": [{"t": "In una ciotola unisci fiocchi di avena, farina di cocco, farina di riso e lievito.", "foto": []}, {"t": "Aggiungi (girando con una forchetta o una frusta a mano) la vaniglia, la polpa di mela e 200 g di albume tenendone 10 g da parte.", "foto": []}, {"t": "Dividi l'impasto in due parti e ad una aggiungi il cacao e i 10 g di albume messi da parte.", "foto": []}, {"t": "In uno stampo da circa 15 cm versa prima la parte scura sul fondo poi la parte chiara su quella scura.", "foto": []}, {"t": "Decora con le gocce di Cioccolato e cuoci in microonde per circa 6/7', controllando di tanto in tanto.", "foto": []}], "autore": "Fit with Fun", "nutr": {"kcal": 128.5, "prot": 8.0, "carb": 14.4, "zuc": 5.1, "grassi": 4.5, "saturi": 3.2, "sodio": 89.7}, "dolce": false, "stimata": true},
+  {"id": "fw:torta-mugcake-bicolore-cocco-cacao-e-cioccolato-proteica", "nome": "Torta MugCake Bicolore Cocco Cacao e Cioccolato Proteica", "foto": "https://fitwithfun.it/wp-content/uploads/2021/04/Torta-MugCake-Bicolore-Cocco-Cacao-e-Cioccolato-Proteica-sito.jpg", "url": "https://fitwithfun.it/torta-mugcake-bicolore-cocco-cacao-e-cioccolato-proteica/", "porzioni": 4, "ingredienti": ["100 g polpa di mela o banana", "210 g albume", "30 g fiocchi di avena", "20 g farina di riso", "20 g farina di cocco", "10 g cacao amaro in polvere", "3 g lievito per dolci (o cremor tartaro o bicarbonato)", "q.b. vaniglia", "q.b. gocce di cioccolato fondente"], "totale": 15, "passi": [{"t": "In una ciotola unisci fiocchi di avena, farina di cocco, farina di riso e lievito.", "foto": []}, {"t": "Aggiungi (girando con una forchetta o una frusta a mano) la vaniglia, la polpa di mela e 200 g di albume tenendone 10 g da parte.", "foto": []}, {"t": "Dividi l'impasto in due parti e ad una aggiungi il cacao e i 10 g di albume messi da parte.", "foto": []}, {"t": "In uno stampo da circa 15 cm versa prima la parte scura sul fondo poi la parte chiara su quella scura.", "foto": []}, {"t": "Decora con le gocce di Cioccolato e cuoci in microonde per circa 6/7', controllando di tanto in tanto.", "foto": []}], "autore": "Fit with Fun", "nutr": {"kcal": 128.5, "prot": 8.0, "carb": 14.4, "zuc": 5.1, "grassi": 4.5, "saturi": 3.2, "sodio": 89.7}, "dolce": true, "stimata": true},
   {"id": "fw:torta-fit-e-proteica-al-cacao-ripiena-di-cocco-e-lamponi", "nome": "Torta Fit e Proteica al Cacao Ripiena di Cocco e Lamponi", "foto": "https://fitwithfun.it/wp-content/uploads/2021/02/Torta-Fit-e-Proteica-al-Cacao-Ripiena-di-Cocco-e-Lamponi-1.jpg", "url": "https://fitwithfun.it/torta-fit-e-proteica-al-cacao-ripiena-di-cocco-e-lamponi/", "porzioni": 4, "ingredienti": ["200 g albume", "50 g yogurt 0%", "20 g fiocchi di avena", "20 g cacao amaro in polvere", "25 g farina di cocco degrassata", "5 gocce yummy drops cocco (o dolcificante)", "2 g lievito per dolci", "200 g yogurt 0%", "5 g proteine alla vaniglia", "5 g cocco rapé", "200 g lamponi"], "totale": 25, "passi": [{"t": "In una ciotola unisci gli ingredienti secchi (cacao, farina di cocco e fiocchi di avena) con il lievito.", "foto": []}, {"t": "Aggiungi mano a mano gli altri ingredienti ed unisci bene con una forchetta o una frusta a mano.", "foto": []}, {"t": "Versa in un contenitore adatto a microonde o cuoci in forno (misura tra i 12 e i 15 cm).", "foto": []}, {"t": "In microonde cuoci per circa 6' a max potenza, controllando ogni minuto (i modelli variano tra loro); in forno cuoci a 180º per circa 20' e fai la prova dello stecchino.", "foto": []}, {"t": "Lascia raffreddare, poi taglia a metà e prepara la crema per la farcitura.", "foto": []}, {"t": "Unisci lo yogurt alle proteine e al cocco e spalma su entrambi i dischi.", "foto": []}, {"t": "Sul primo disco distribuisci i lamponi su tutta la superficie, in cima invece solo intorno al perimetro (o come preferisci).", "foto": []}, {"t": "Conserva in Frigo.", "foto": []}], "autore": "Fit with Fun", "nutr": {"kcal": 159.8, "prot": 10.9, "carb": 12.8, "zuc": 9.3, "grassi": 7.1, "saturi": 5.1, "sodio": 126.6}, "dolce": true, "stimata": true},
   {"id": "fw:brownie-proteico-di-patate-dolci-e-cacao-al-microonde", "nome": "Brownie Proteico di Patate Dolci e Cacao al Microonde", "foto": "https://fitwithfun.it/wp-content/uploads/2022/11/Brownie-Proteico-di-Patate-Dolci-e-Cacao-al-Microonde-1.jpg", "url": "https://fitwithfun.it/brownie-proteico-di-patate-dolci-e-cacao-al-microonde/", "porzioni": 1, "ingredienti": ["100 g patata dolce (al netto degli scarti)", "80 g banana", "70 g albume", "25 g avena istantanea integrale (leggi note in fondo)", "10 g cacao magro in polvere", "10 g proteine al cioccolato fondente (facoltative)", "1 pizzico di lievito", "Q.b. vaniglia e cannella"], "totale": 5, "passi": [{"t": "La patata dev'essere cotta e asciutta, io l'ho bucherellata e cotta un paio di minuti nel microonde.", "foto": []}, {"t": "Una volta intiepidita frullala con la banana e l'albume.", "foto": []}, {"t": "In una ciotola unisci cacao, avena, proteine, lievito, vaniglia e cannella.", "foto": []}, {"t": "Versa la crema ottenuta nella ciotola con gli ingredienti secchi ed unisci in modo omogeneo.", "foto": []}, {"t": "Controlla se la dolcezza è di tuo gradimento altrimenti aggiungi del dolcificante preferito q.b.", "foto": []}, {"t": "Versa in uno stampo adatto alla cottura al microonde e cuoci per circa 3/4'.", "foto": []}, {"t": "Se non hai il microonde puoi cuocere in un padellino con coperchio o al forno per circa 15/20 a 180°.", "foto": []}], "autore": "Fit with Fun", "nutr": {"kcal": 533.4, "prot": 40.6, "carb": 33.8, "zuc": 15.7, "grassi": 26.4, "saturi": 8.6, "sodio": 144.5}, "dolce": false, "stimata": true},
   {"id": "fw:calzone-o-frittata-di-carote-grattugiate-ripiena-e-in-padella", "nome": "Calzone o Frittata di Carote Grattugiate Ripiena e in Padella", "foto": "https://fitwithfun.it/wp-content/uploads/2022/11/Calzone-o-Frittata-di-Carote-Grattugiate-Ripiena-e-in-Padella-1.jpg", "url": "https://fitwithfun.it/calzone-o-frittata-di-carote-grattugiate-ripiena-e-in-padella/", "porzioni": 1, "ingredienti": ["150 g carote crude e pelate", "2 uova", "10 g formaggio grattugiato", "1 cucchiaio yogurt preferito (facoltativo)", "20 g fetta di formaggio light", "50 g prosciutto cotto"], "totale": 20, "passi": [{"t": "Ho usato 3 carote piccoline per un totale di circa 150 g (già pelate) e poi le ho grattugiate.", "foto": []}, {"t": "Scalda una padella e quando è bollente salta le carote (senza aggiungere nulla), servirà a togliere un po' di umidità, poi lascia intiepidire leggermente.", "foto": []}, {"t": "In una ciotola o un piatto, rompi le uova e sbattile con una forchetta, poi aggiungi sale, pepe e formaggio e sbatti qualche secondo ancora per rendere omogeneo.", "foto": []}, {"t": "Aggiungi anche lo yogurt se scegli di usarlo, conferisce una morbidezza unica alle frittate, provare per credere!", "foto": []}, {"t": "Aggiungi le carote al battuto, unisci poi versa in una padella bollente e copri con un coperchio.", "foto": []}, {"t": "Quando sotto sarà ben cotto, metti il ripieno scelto su metà frittata.", "foto": []}, {"t": "Con l'aiuto di 2 spatole piega un lato verso l'altro.", "foto": []}, {"t": "Premi leggermente sui bordi per far in modo che l'interno, ancora leggermente morbido, funga da legante.", "foto": []}, {"t": "Cuoci ancora qualche minuto su entrambi i lati, senza coperchio e quando sarà bella dorata, servi la tua goduriosa frittata.", "foto": []}], "autore": "Fit with Fun", "nutr": {"kcal": 344.9, "prot": 26.4, "carb": 13.4, "zuc": 12.6, "grassi": 19.9, "saturi": 7.6, "sodio": 753.0}, "dolce": false, "stimata": true},
   {"id": "fw:pollo-alla-thailandese-con-curry-e-latte-di-cocco", "nome": "Pollo alla Thailandese con Curry e Latte di Cocco", "foto": "https://fitwithfun.it/wp-content/uploads/2022/11/Pollo-alla-Thailandese-con-Curry-e-Latte-di-Cocco-1.jpg", "url": "https://fitwithfun.it/pollo-alla-thailandese-con-curry-e-latte-di-cocco/", "porzioni": 1, "ingredienti": ["200 g zucchina o melanzana", "50 g latte di cocco fullfat", "200 g petto di pollo (o tacchino)", "1/2 cucchiaino pasta curry (leggi le note in fondo)", "Q.b. riso basmati (facoltativo)"], "totale": 35, "passi": [{"t": "Come detto in prefazione le quantità degli ingredienti sono relative, nel caso ad esempio tu segua una chetogenica puoi aumentare il latte di cocco ed omettere il riso, e così via.", "foto": []}, {"t": "In una padella metti la pasta curry, o il misto di spezie che scelto (leggi le note in fondo) e un dito di acqua.", "foto": []}, {"t": "Poni su fiamma media e lascia che il calore sciolga le spezie e colori l'acqua.", "foto": []}, {"t": "A quel punto aggiungi la verdura scelta, che avrai precedentemente tagliato a dadini e lascia cuocere per circa 15'.", "foto": []}, {"t": "Se vuoi servire con riso, in questo frangente, cuocilo come indicato in confezione.", "foto": []}, {"t": "Quando le verdure saranno cotte, aggiungi nella padella il latte di cocco con ½ tazza di acqua e il petto di pollo tagliato a tocchetti.", "foto": []}, {"t": "Lascia cuocere il pollo per circa 10', se secca aggiungi un po’ di acqua di tanto in tanto e controlla di sale.", "foto": []}, {"t": "La pietanza deve comunque essere servita cremosa e non acquosa.", "foto": []}, {"t": "Puoi servire il riso accanto o aggiungerlo in padella.", "foto": []}], "autore": "Fit with Fun", "nutr": {"kcal": 430.1, "prot": 52.8, "carb": 9.2, "zuc": 5.5, "grassi": 19.4, "saturi": 15.8, "sodio": 79.7}, "dolce": false, "stimata": true},
   {"id": "fw:cioccolata-calda-bianca-proteica-100-calorie-senza-zucchero", "nome": "Cioccolata Calda Bianca Proteica 100 Calorie Senza Zucchero", "foto": "https://fitwithfun.it/wp-content/uploads/2022/12/Cioccolata-Calda-Bianca-Proteica-100-Calorie-Senza-Zucchero-1.jpg", "url": "https://fitwithfun.it/cioccolata-calda-bianca-proteica-100-calorie-senza-zucchero/", "porzioni": 1, "ingredienti": ["200 g latte vegetale", "10 g amido di mais", "10 g proteine al cioccolato bianco", "10 g crema proteica al cioccolato bianco (facoltativa)"], "totale": 7, "passi": [{"t": "In un pentolino metti l'amido con le proteine ed unisci.", "foto": []}, {"t": "Versa il latte girando con una frusta a mano.", "foto": []}, {"t": "Poni su fiamma media e gira spesso con la frusta fino a densità desiderata.", "foto": []}, {"t": "Se vuoi prima di versarla in una tazza aggiungi un cucchiaino di crema proteica al cioccolato bianco.", "foto": []}, {"t": "Versa in una tazza e goditela calda.", "foto": []}], "autore": "Fit with Fun", "nutr": {"kcal": 252.8, "prot": 16.5, "carb": 22.4, "zuc": 10.9, "grassi": 11.5, "saturi": 5.5, "sodio": 146.0}, "dolce": true, "stimata": true},
