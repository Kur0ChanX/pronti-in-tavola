   {"id": "fw:hamburgers-di-fagioli-e-verdure-vegan-proteici-senza-glutine", "nome": "Hamburgers di Fagioli e Verdure Vegan Proteici Senza Glutine", "foto": "https://fitwithfun.it/wp-content/uploads/2021/11/Hamburgers-di-Fagioli-e-Verdure-Vegan-Proteici-Senza-Glutine-1.jpg", "url": "https://fitwithfun.it/hamburgers-di-fagioli-e-verdure-vegan-proteici-senza-glutine/", "porzioni": 2, "ingredienti": ["200 g fagioli rossi o neri", "20 g semi di chia", "20 g lievito alimentare", "50 g zucchina", "50 g cavolo rosso", "30 g cipolla rossa", "30 g carote grattugiate", "5 g olio extravergine di oliva", "5 g salsa di soia", "q.b. sale e spezie preferite (per me cumino e paprika)"], "totale": 40, "passi": [{"t": "Scalda una padella.", "foto": []}, {"t": "Taglia finemente cipolla e cavolo, mettili nella padella con un dito d'acqua e lascia asciugare.", "foto": []}, {"t": "Quando l' acqua sarà evaporata e le verdure ammorbidite, aggiungi la zucchina e e le carote sempre tagliate finemente, insieme all'olio e alla salsa di soia e lascia saltare e insaporire 5'.", "foto": []}, {"t": "Sciacqua e scola bene i fagioli, poi mettili in un mixer con i semi di chia, il lievito, sale, le tue spezie preferite e tutto il saltato di verdure ed aziona.", "foto": []}, {"t": "Io ho diviso in 2 burgers da circa 170 g ma puoi fare più polpette o burgers più piccoli.", "foto": []}, {"t": "Puoi gustarli così oppure terminare la cottura su una piastra, in padella (fino a doratura) o nel forno (200° per circa 20/30')", "foto": []}, {"t": "Si mantengono compatti ma molto morbidi.", "foto": []}], "autore": "Fit with Fun", "nutr": {"kcal": 373.0, "prot": 26.1, "carb": 50.1, "zuc": 6.0, "grassi": 4.6, "saturi": 0.9, "sodio": 165.1}, "dolce": false, "stimata": true},
