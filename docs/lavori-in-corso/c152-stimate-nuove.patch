   {"id": "fw:pizza-allo-yogurt-greco-2-ingredienti-proteica-e-senza-glutine", "nome": "Pizza allo Yogurt Greco 2 Ingredienti Proteica e Senza Glutine", "foto": "https://fitwithfun.it/wp-content/uploads/2020/05/Pizza-allo-Yogurt-Proteica-e-Senza-Glutine-1.jpg", "url": "https://fitwithfun.it/pizza-allo-yogurt-greco-2-ingredienti-proteica-e-senza-glutine/", "porzioni": 1, "ingredienti": ["20 g farina di fave", "20 g proteine in polvere neutre", "30 g fiocchi di patate per il purè", "90 g yogurt greco 0%", "3 g lievito istantaneo per pane", "q.b. Sale e Pepe"], "totale": 17, "passi": [{"t": "Preriscalda il forno a 180º.", "foto": []}, {"t": "In una ciotola unisci la farina di fave, i fiocchi di patate, le proteine, sale, pepe e lievito poi aggiungi lo yogurt poco per volta fino a formare un impasto morbido ed elastico.", "foto": []}, {"t": "Se ti è più comodo passa su una spianatoia e impasta pochi secondi con le mani fino a formare un panetto.", "foto": []}, {"t": "Stendi con l'aiuto di un mattarello infarinato oppure metti il panetto tra due fogli di carta forno.", "foto": []}, {"t": "Inforna per circa 10/15' o fino a doratura.", "foto": []}, {"t": "Condisci a gusto, se usi del formaggio tipo mozzarella, lascia sciogliere un altro paio di minuti in forno.", "foto": []}], "autore": "Fit with Fun", "nutr": {"kcal": 159.1, "prot": 26.2, "carb": 10.4, "zuc": 4.7, "grassi": 1.6, "saturi": 0.8, "sodio": 92.4}, "dolce": false, "stimata": true},
