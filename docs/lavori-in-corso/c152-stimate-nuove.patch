   {"id": "fw:mini-torta-proteica-avocado-e-cioccolato-senza-cottura", "nome": "Mini Torta Proteica Avocado e Cioccolato Senza Cottura", "foto": "https://fitwithfun.it/wp-content/uploads/2021/09/4-Mini-Torta-Cioccolato-e-Burro-di-Arachidi-Food-Porn-Vegana-e-Senza-Cottura.jpg", "url": "https://fitwithfun.it/mini-torta-proteica-avocado-e-cioccolato-senza-cottura/", "porzioni": 2, "ingredienti": ["40 g fiocchi di avena", "20 g proteine al cioccolato", "10 g cacao magro in polvere", "100 g avocado", "50 g banana", "q.b. latte vegetale senza zucchero (o preferito)"], "totale": 10, "passi": [{"t": "Unisci i fiocchi di avena con 10 g di proteine ed un pizzico di cacao. Aggiungi il latte a filo fino ad ottenere un impasto morbido adatto a creare la base.", "foto": []}, {"t": "Crea la base della torta con l'aiuto di un coppapasta o all'interno di una ciotola poi metti in frigo.", "foto": []}, {"t": "Frulla l'avocado con la banana, il cacao, gli altri 10 g di proteine, se gradisci un po di vaniglia e cannella e unb goccio di latte.", "foto": []}, {"t": "Versa la crema ottenuta sulla base di avena, livella e rimetti in frigo per qualche ora o meglio ancora tutta la notte.", "foto": []}, {"t": "Decora con ciò che ami e servi, io ho terminato con burro di arachidi e gocce di cioccolato senza zucchero.", "foto": []}], "autore": "Fit with Fun", "nutr": {"kcal": 268.1, "prot": 13.9, "carb": 18.5, "zuc": 5.3, "grassi": 14.9, "saturi": 2.6, "sodio": 27.6}, "dolce": true, "stimata": true},
