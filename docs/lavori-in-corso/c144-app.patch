+  {"id": "cp:24913139", "nome": "Gelato HomeMade all’albicocca + pancake", "foto": "https://img-global.cpcdn.com/recipes/1ce06d4d8b0ede1d/1200x630cq80/photo.jpg", "url": "https://cookpad.com/it/ricette/24913139", "porzioni": 1, "ingredienti": ["250 ml latte ps", "3 albicocche piccole", "4 gr stevia", "5 gocce aromatizzante alla vaniglia", "50 gr farina tipo 0", "70 ml albume", "2 gr stevia", "10 gr polvere lievitante", "1 cucchiaio ricotta"], "totale": 0, "nutr": {"kcal": 373.5, "prot": 22.6, "carb": 49.1, "zuc": 14.2, "grassi": 11.1, "saturi": 6.5, "sodio": 254.4}, "dolce": true, "stimata": true, "passi": [{"t": "Frulla insieme la frutta con latte, aromatizzante e stevia. Versa tutto in una gelatiera e fai girare per circa 25 minuti mescolando di tanto in tanto per evitare che parte del gelato si solidifichi sulle pareti del contenuto", "foto": ["https://img-global.cpcdn.com/steps/f5fe2218918f9b2a/400x400cq80/photo.jpg", "https://img-global.cpcdn.com/steps/66d860a72aaa4c74/400x400cq80/photo.jpg"]}, {"t": "Unisci gli ingredienti per creare l’impasto che darà vita ad un unico grande pancake previa cottura in padella", "foto": []}, {"t": "Fai raffreddare il pancake dopo di che coprilo di gelato ed una generosa spolverata di cannella", "foto": ["https://img-global.cpcdn.com/steps/8b477a710c18d921/400x400cq80/photo.jpg", "https://img-global.cpcdn.com/steps/910290d031e78cfe/400x400cq80/photo.jpg"]}]},
+  {"id": "cp:24359551", "nome": "Tiramisù Crêpes Cake", "foto": "https://img-global.cpcdn.com/recipes/4b866ce589f5dbd4/1200x630cq80/photo.jpg", "url": "https://cookpad.com/it/ricette/24359551", "porzioni": 2, "ingredienti": ["100 gr farina tipo 0", "150 ml latte", "2 caffè espresso", "100 ml albume", "10 gr zucchero", "2 cucchiai cacao amaro", "1 vasetto yogurt greco bianco", "Cacao amaro", "3-4 Mirtilli"], "totale": 0, "nutr": {"kcal": 364.5, "prot": 21.9, "carb": 49.3, "zuc": 12.7, "grassi": 10.1, "saturi": 6.0, "sodio": 150.1}, "dolce": true, "stimata": true, "passi": [{"t": "Unisci gli ingredienti indicati in modo da creare un impasto per la preparazione delle crêpes", "foto": ["https://img-global.cpcdn.com/steps/2754c612d629003f/400x400cq80/photo.jpg"]}, {"t": "Man mano che le crêpes sono pronte, spalma su di ognuna un cucchiaio di yogurt greco bianco e se lo gradisci sbriciola anche del cioccolato Vai avanti con lo stesso procedimento fino a che le crêpes non si saranno esaurite", "foto": []}, {"t": "Spolvera del cacao amaro e decora con della frutta fresca (io ho usato qualche mirtillo)", "foto": ["https://img-global.cpcdn.com/steps/29779862476dc28a/400x400cq80/photo.jpg", "https://img-global.cpcdn.com/steps/3da56b2e71fd7cad/400x400cq80/photo.jpg", "https://img-global.cpcdn.com/steps/78c924b9c8e21ca6/400x400cq80/photo.jpg"]}]},
