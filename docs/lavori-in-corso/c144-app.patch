+.ric-mini-video { position: relative; flex: none; width: 76px; height: 76px; }
+.ric-mini-video img { width: 76px; height: 76px; border-radius: 12px; object-fit: cover; display: block; background: var(--crema, #FBF4E8); }
+.ric-mini-video i { position: absolute; inset: 0; margin: auto; width: 30px; height: 30px; border-radius: 50%; background: rgba(0,0,0,.6); color: #fff; font-style: normal; font-size: 14px; display: grid; place-items: center; }
+.ric-video-autore { min-height: 0; }
+.ric-video-autore small { display: block; margin-top: 4px; }
+.ric-tipi-video { gap: 6px; }
+.ric-tipi-video .scelta { min-height: 40px; padding: 6px 11px; display: inline-flex; flex-direction: row; white-space: nowrap; }
+.ric-yt { position: relative; display: block; width: 100%; padding: 0; border: 0; background: none; font: inherit; cursor: pointer; text-decoration: none; }
+.ric-yt span { position: absolute; left: 50%; bottom: 14px; transform: translateX(-50%); background: #C4302B; color: #fff; font-weight: 700; padding: 10px 16px; border-radius: 999px; white-space: nowrap; box-shadow: 0 2px 8px rgba(0,0,0,.3); }
+/* C147: il video di YouTube dentro l'app, grande sopra la ricetta */
+.video-yt { position: fixed; inset: 0; z-index: 9000; background: #111; display: flex; flex-direction: column; gap: 10px; padding: max(10px, env(safe-area-inset-top)) 12px max(14px, env(safe-area-inset-bottom)); }
+.video-yt-barra { display: flex; justify-content: flex-end; }
+.video-yt-player { flex: 1; min-height: 220px; }
+.video-yt-player iframe { width: 100%; height: 100%; border: 0; border-radius: 12px; background: #000; display: block; }
+.video-yt-fuori { color: #fff; text-align: center; font-size: .9rem; opacity: .85; }
+body.con-video { overflow: hidden; }
 .ric-intro summary { cursor: pointer; line-height: 1.45; }
 .ric-intro summary b { color: var(--vino, #7B2318); }
 .ric-intro p { margin: 8px 0 0; }
