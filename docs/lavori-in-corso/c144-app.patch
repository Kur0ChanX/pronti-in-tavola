+  {"id": "cp:24134249", "nome": "Whey Protein Banana Bread", "foto": "https://img-global.cpcdn.com/recipes/574ea5a3cdcebd80/1200x630cq80/photo.jpg", "url": "https://cookpad.com/it/ricette/24134249", "porzioni": 1, "ingredienti": ["40 gr fiocchi di avena senza glutine", "60 ml latte vegetale", "1 banana", "1 cucchiaio miele, sciroppo di agave o zucchero di cocco", "20 gr whey protein (io al cioccolato)", "1/2 cucchiaino lievito in polvere", "Qb gocce di cioccolato al 70%", "Qb cannella"], "totale": 0, "nutr": {"kcal": 413.2, "prot": 24.2, "carb": 64.9, "zuc": 37.7, "grassi": 6.5, "saturi": 2.6, "sodio": 82.2}, "dolce": true, "stimata": true, "passi": [{"t": "Unire nel boccale del frullatore o robot da cucina i fiocchi di avena, il latte, metà della banana, il cucchiaio di miele, whey protein e il lievito, frullare per un paio di minuti", "foto": []}, {"t": "Riempire con il composto un contenitore adatto all’Airfryer, coprire la superficie con l’altra metà della banana a rondelle, la cannella e le gocce di cioccolato", "foto": []}, {"t": "Cuocere in Airfryer a 170°C per circa 8/10 minuti. Suggerisco di degustarlo tiepido", "foto": ["https://img-global.cpcdn.com/steps/26cabac309534f72/400x400cq80/photo.jpg", "https://img-global.cpcdn.com/steps/89db90279bf47e0c/400x400cq80/photo.jpg"]}]},
