+  {"id": "bg:cucinaalcontrario/ricetta-pancake-con-yogurt-greco", "nome": "Pancake con yogurt greco: proteici ( 20 minuti)", "foto": "https://blog.giallozafferano.it/cucinaalcontrario/wp-content/uploads/2026/08/Pancake-con-yogurt-greco-001.jpg", "url": "https://blog.giallozafferano.it/cucinaalcontrario/ricetta-pancake-con-yogurt-greco/", "porzioni": 2, "ingredienti": ["2 uovo (INTERO SENZA GUSCIO)", "3 albumi", "150 g yogurt greco 0% di grassi", "30 g zucchero di canna", "70 g farina di avena (INTEGRALE)", "1/2 cucchiaino lievito chimico in polvere (VANIGLIATO)", "1/2 cucchiaino cannella in polvere", "1 pizzico sale"], "totale": 20, "nutr": {"kcal": 323.4, "prot": 24.2, "carb": 39.9, "zuc": 19.3, "grassi": 7.5, "saturi": 2.6, "sodio": 188.4}, "dolce": true, "stimata": true, "passi": [{"t": "Prepara la base (1 minuto): In una ciotola metti l'uovo gli albumi e lo yogurt.", "foto": ["https://blog.giallozafferano.it/cucinaalcontrario/wp-content/uploads/2026/07/Pancake-con-yogurt-greco-0.jpg"]}, {"t": "Amalgama gli ingredienti (2-3 minuti): Mescola fino a quando il composto è omogeneo. Come capisci che va bene? Il composto risulta liscio, senza grumi o striature dell'uovo.", "foto": ["https://blog.giallozafferano.it/cucinaalcontrario/wp-content/uploads/2026/07/Pancake-con-yogurt-greco-1.jpg"]}, {"t": "Aggiungi lo zucchero (1 minuto): Incorpora lo zucchero nel composto e miscela.", "foto": ["https://blog.giallozafferano.it/cucinaalcontrario/wp-content/uploads/2026/07/Pancake-con-yogurt-greco-2.jpg"]}, {"t": "Aggiungi gli ingredienti secchi (1-2 minuti): Unisci la farina setacciata, il lievito e la cannella al composto.", "foto": ["https://blog.giallozafferano.it/cucinaalcontrario/wp-content/uploads/2026/07/Pancake-con-yogurt-greco-3.jpg"]}, {"t": "Amalgama il composto (1-2 minuti): Miscela fino a quando il composto è omogeneo e non presenta grumi. Eventualmente aiutati con la frusta elettrica.", "foto": ["https://blog.giallozafferano.it/cucinaalcontrario/wp-content/uploads/2026/07/Pancake-con-yogurt-greco-4.jpg"]}, {"t": "Scalda e versa la pastella (2-3 minuti): Fai scaldare una padella antiaderente e quando è ben calda ( operazione importante ) versa al centro un mestolo di pastella ( non c' è bisogno di espandere la pastella ).Come capisci che va bene? quando una goccia di pastella sfrigola a contatto della padella.", "foto": ["https://blog.giallozafferano.it/cucinaalcontrario/wp-content/uploads/2026/07/Pancake-con-yogurt-greco-5.jpg"]}, {"t": "Cuoci il primo lato (2-3minuti per pancake): Fai cuocere fino a quando noti in superficie tante bollicine scoppiate, quindi con l'aiuto di una spatola gira dall'altra parte e fai cuocere per (1 minuto).", "foto": ["https://blog.giallozafferano.it/cucinaalcontrario/wp-content/uploads/2026/07/Ricetta-pancake-con-sciroppo-dacero-7-1.jpg"]}, {"t": "Completa la cottura (varia in base ai pancake che decidi di preparare): Prosegui la cottura fino ad esaurire tutta la pastella e man mano che i pancake sono cotti adagiandoli man mano uno sopra l'altro su un piatto, fino a creare una torretta.", "foto": ["https://blog.giallozafferano.it/cucinaalcontrario/wp-content/uploads/2026/07/Pancake-con-farina-di-avena-4.jpg"]}, {"t": "Servi i pancake ( 1 minuto): Accompagna i pancake a piacere con mirtilli, topping al cioccolato e zucchero a velo.", "foto": ["https://blog.giallozafferano.it/cucinaalcontrario/wp-content/uploads/2026/08/Pancake-con-yogurt-greco-003.jpg"]}]},
+  {"id": "cp:15650293", "nome": "Pancakes", "foto": "https://img-global.cpcdn.com/recipes/0f729cb7e0201cbd/1200x630cq80/photo.jpg", "url": "https://cookpad.com/it/ricette/15650293", "porzioni": 1, "ingredienti": ["50 g farina", "1 uovo o 30 ml di albume", "70 g yogurt greco 0% di grassi o 1 banana schiacciata ridotta in poltiglia", "1 pizzico bicarbonato di sodio"], "totale": 0, "nutr": {"kcal": 214.3, "prot": 15.7, "carb": 38.7, "zuc": 3.8, "grassi": 0.6, "saturi": 0.2, "sodio": 79.3}, "dolce": true, "stimata": true, "passi": [{"t": "Prendere tutti gli ingredienti necessari ed amalgamarli insieme.", "foto": []}, {"t": "Una volta che si è formato il composto(non deve essere solido), prendere una padella antiaderente e aggiungere un goccia di olio evo o olio di cocco a seconda di quello che preferite e accendete il fornello.", "foto": []}, {"t": "Aspettare qualche secondo e poi con un cucchiaio prendere un po’ del composto e versatelo sulla padella.", "foto": []}, {"t": "Aspettare che il composto nella padella inizi a formare delle bolle, a quel punto potete girarlo.", "foto": []}, {"t": "Aspettare ancora un minuto e otterrete il vostro primo pancake. Continuare con lo stesso procedimento fino ad esaurimento del composto.", "foto": []}, {"t": "Infine, potete guarnire i vostri pancakes con quello che volete. Io amo farcirli con cioccolata fondente al 90% sciolta a bagnomaria o marmellata di frutti di bosco e semi di zucca.", "foto": []}]},
