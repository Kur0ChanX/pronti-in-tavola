+  {"id": "cp:17166135", "nome": "Barrette proteiche", "foto": "https://img-global.cpcdn.com/recipes/749320b915581b95/1200x630cq80/photo.jpg", "url": "https://cookpad.com/it/ricette/17166135", "porzioni": 20, "ingredienti": ["80 gr farina o fiocchi di avena", "150 gr albume", "40 gr cacao amaro", "50 gr sciroppo dagave", "30 gr burro di arachidi", "200 gr proteine in polvere", "Scorza grattugiata di 2arance o di 1 limone", "qb Cannella", "qb Latte"], "totale": 0, "nutr": {"kcal": 72.6, "prot": 9.9, "carb": 3.5, "zuc": 0.6, "grassi": 2.2, "saturi": 0.9, "sodio": 43.5}, "dolce": true, "stimata": true, "passi": [{"t": "Prepariamo gli ingredienti", "foto": ["https://img-global.cpcdn.com/steps/49ba010d63664a3a/400x400cq80/photo.jpg"]}, {"t": "In una ciotola versare la farina di avena,io avevo i fiocchi e li ho frullati nel tritatutto,unire tutti gli ingredienti in polvere e mescolare, aggiungere il burro di arachidi,lo sciroppo dagave e l'albume. Mescolare.", "foto": ["https://img-global.cpcdn.com/steps/1be60a53beb170d8/400x400cq80/photo.jpg"]}, {"t": "Dopodiché aggiungere la buccia grattugiata del limone o delle arance,in ultimo versare un po alla volta il latte, mescolando sempre sino a raggiungere un impasto consistente", "foto": ["https://img-global.cpcdn.com/steps/956d2af9f552fe57/400x400cq80/photo.jpg", "https://img-global.cpcdn.com/steps/005669a37a06ff49/400x400cq80/photo.jpg", "https://img-global.cpcdn.com/steps/c55baf9977c74b01/400x400cq80/photo.jpg"]}, {"t": "Adagiare un foglio di carta forno su una leccarda,e stendere l'impasto sino a raggiungere lo spessore di 1cm.", "foto": ["https://img-global.cpcdn.com/steps/17381471145fd6e4/400x400cq80/photo.jpg"]}, {"t": "Cuocere in forno preriscaldato per 15/20 minuti a 170 gradi facendo la prova stecchino dovranno risultare morbide. Spegnere lasciare raffreddare e tagliare le barrette", "foto": ["https://img-global.cpcdn.com/steps/922da74ac4903374/400x400cq80/photo.jpg"]}]},
