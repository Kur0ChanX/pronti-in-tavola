-  {"id": "cp:25563537", "nome": "Frittata sandwich ai fagiolini: ricetta keto, senza glutine e lattosio ️", "foto": "https://img-global.cpcdn.com/recipes/bd9fb9734c1c5714/1200x630cq80/photo.jpg", "url": "https://cookpad.com/it/ricette/25563537", "porzioni": 3, "ingredienti": ["6 uova medie", "200 g fagiolini (già lessati e scolati)", "3 sottilette (senza lattosio)", "1 cucchiaino olio di cocco", "q.b Sale fino integrale", "q.b Pepe nero", "1 Piatto piano (per girare la frittata)", "📍La frittata si conserva in frigorifero, all'interno di un contenitore ermetico, per un massimo di 2 giorni"], "totale": 0, "nutr": {"kcal": 373.1, "prot": 29.4, "carb": 31.7, "zuc": 2.3, "grassi": 12.6, "saturi": 4.7, "sodio": 153.4}, "dolce": false, "stimata": true},
+  {"id": "cp:16965383", "nome": "Polpette di melanzane e tonno", "foto": "https://img-global.cpcdn.com/recipes/54841ad912d8528e/1200x630cq80/photo.jpg", "url": "https://cookpad.com/it/ricette/16965383", "porzioni": 4, "ingredienti": ["4 melanzane lunghe viola", "5 scatolette di tonno sgocciolato", "1 mazzetto basilico", "qb Maggiorana", "1 uovo intero+ 1 albume", "2 cucchiai abbondanti di pecorino grattugiato", "300 gr pane raffermo ammollato", "qb Sale", "qb Aglio in polvere"], "totale": 0, "nutr": {"kcal": 429.2, "prot": 34.9, "carb": 44.8, "zuc": 1.6, "grassi": 12.9, "saturi": 3.9, "sodio": 693.6}, "dolce": false, "stimata": true, "passi": [{"t": "Tagliare le estremità delle melanzane,tagliarle a pezzetti piccoli e sbollentarle in abbondante acqua salata per pochi minuti.", "foto": []}, {"t": "Scolare le melanzane,farle raffreddare e strizzarle.", "foto": []}, {"t": "Mettere as ammollare il pane raffermo in una ciotola di acqua.", "foto": []}, {"t": "Una volta ammollato,strizzarlo per bene e versarlo in una ciotola in cui uniremo le melanzane strizzate e tutti gli altri ingredienti, sgocciolare il tonno dall'olio o dall'acqua in caso si usasse il tonno al naturale.", "foto": []}, {"t": "Impastare ed amalgamare bene tutti gli ingredienti, formare delle polpettine e cuocere in friggitrice ad aria secondo la temperatura ed i tempi della propria friggitrice. In alternativa sono buonissime anche fritte", "foto": ["https://img-global.cpcdn.com/steps/0c74cd7a9d2debdd/400x400cq80/photo.jpg", "https://img-global.cpcdn.com/steps/823124fa4ae7945b/400x400cq80/photo.jpg", "https://img-global.cpcdn.com/steps/ee5e772f49b675c7/400x400cq80/photo.jpg"]}]},
+  {"id": "cp:25494308", "nome": "Spinaci filanti keto", "foto": "https://img-global.cpcdn.com/recipes/2ca494184ab02baf/1200x630cq80/photo.jpg", "url": "https://cookpad.com/it/ricette/25494308", "porzioni": 3, "ingredienti": ["500 g spinaci surgelati", "1 cucchiaino olio di cocco", "1 spicchio aglio grattugiato", "q.b Sale integrale", "q.b Pepe nero", "125 g Parmigiano Reggiano grattugiato", "1 Grattugia a fori stretti", "📍In frigorifero: Riponi gli spinaci in un contenitore ermetico (preferibilmente in vetro) una volta raffreddati. Si conservano perfettamente per 24 ore", "📍Congelazione: Sconsigliata. Avendo utilizzato spinaci surgelati in origine, non è sicuro ricongelarli dopo la cottura"], "totale": 0, "nutr": {"kcal": 239.3, "prot": 19.3, "carb": 4.8, "zuc": 0.7, "grassi": 15.2, "saturi": 8.3, "sodio": 416.7}, "dolce": false, "stimata": true, "passi": [{"t": "Fai prima scongelare gli spinaci, poi strizzali con forza tra le mani o in un canovaccio per eliminare tutta l'acqua in eccesso.", "foto": ["https://img-global.cpcdn.com/steps/c58652b23c9b7824/400x400cq80/photo.jpg"]}, {"t": "Grattugia finemente lo spicchio d'aglio.", "foto": ["https://img-global.cpcdn.com/steps/8b79a9deb5823ae5/400x400cq80/photo.jpg", "https://img-global.cpcdn.com/steps/12dbff3f939a2996/400x400cq80/photo.jpg"]}, {"t": "Scalda l'olio di cocco in una padella a fuoco basso. Fai appassire l'aglio nell'olio caldo per pochi istanti, evitando che scurisca troppo.", "foto": ["https://img-global.cpcdn.com/steps/849c37994826e604/400x400cq80/photo.jpg"]}, {"t": "Aggiungi gli spinaci strizzati e falli insaporire bene nel condimento per qualche minuto.", "foto": ["https://img-global.cpcdn.com/steps/e04f184b3d387e97/400x400cq80/photo.jpg"]}, {"t": "Aggiungi il sale integrale e una spolverata di pepe nero agli spinaci, mescolando con cura.", "foto": []}, {"t": "Grattugia il Parmigiano Reggiano, versalo sopra gli spinaci e mescola energicamente per distribuirlo.", "foto": ["https://img-global.cpcdn.com/steps/4b01efe0fc5fbde2/400x400cq80/photo.jpg", "https://img-global.cpcdn.com/steps/78bd7ef052af0994/400x400cq80/photo.jpg"]}, {"t": "Spegni il fuoco, copri con il coperchio per 3 minuti esatti affinché il calore faccia filare il formaggio, quindi servili caldi.", "foto": ["https://img-global.cpcdn.com/steps/7d924b7d66791754/400x400cq80/photo.jpg"]}, {"t": "🧬VALORI NUTRIZIONALI PER 100 G Calorie 128 kcal Proteine 10,2 g Grassi 8,5 g Carboidrati 1,1 g Fibre 1,9 g Sodio 0,4 g", "foto": []}, {"t": "💡Eliminare tutta l'acqua dagli spinaci è fondamentale per evitare l'effetto \"bollito\" e far aderire perfettamente il Parmigiano alle foglie.", "foto": []}, {"t": "💡Per l'intolleranza al lattosio, usa un Parmigiano Reggiano stagionato almeno 30-36 mesi: è più digeribile e naturalmente privo di zuccheri del latte.", "foto": []}, {"t": "💡Attenzione all'aglio: Grattugiandolo sprigioni più allicina, un potente antinfiammatorio naturale, ma ricorda di cuocerlo a fuoco dolcissimo per non alterarne le proprietà.", "foto": []}, {"t": "💡Se ami le consistenze diverse, aggiungi una manciata di pinoli tostati o gherigli di noce a fine cottura per un tocco crunch e grassi omega-3 extra.", "foto": []}, {"t": "❓️Posso usare gli spinaci freschi? Certamente! Considera che riducono molto il volume: per 3 persone ne serviranno circa 800g-1kg. Ricorda di cuocerli brevemente e strizzarli bene come quelli surgelati.", "foto": []}, {"t": "❓️Perché l'olio di cocco? È un grasso stabile alla cottura e ottimo per la dieta keto. Se usi quello \"deodorato\" non ne percepirai l'aroma, altrimenti donerà un tocco esotico delizioso.", "foto": []}, {"t": "❓️Il parmigiano è davvero senza lattosio? Sì, la stagionatura oltre i 30 mesi garantisce l'assenza naturale di lattosio, rendendo la ricetta sicura per chi è intollerante.", "foto": []}, {"t": "❓️Posso sostituire l'aglio? Se non lo gradisci, puoi ometterlo, ma grattugiato finemente si fonde con il formaggio regalando un sapore profumato e mai invadente.", "foto": []}, {"t": "❌️Scongelamento parziale: Se gli spinaci sono ancora ghiacciati al centro, rilasceranno acqua in padella rovinando la mantecatura del Parmigiano.", "foto": []}, {"t": "❌️Strizzatura leggera: Non aver paura di premere forte! Se lasci residui di liquido, il formaggio scivolerà via invece di avvolgere le foglie di spinaci.", "foto": []}, {"t": "❌️Aglio bruciato: L'aglio grattugiato cuoce in pochissimi secondi. Se diventa marrone, assumerà un gusto amaro che coprirà la dolcezza degli spinaci.", "foto": []}, {"t": "❌️Eccesso di sale: Il Parmigiano Reggiano è naturalmente sapido e la strizzatura degli spinaci ne concentra il sapore; assaggia sempre prima di aggiungere troppo sale integrale.", "foto": []}, {"t": "❌️Fuoco troppo alto alla fine: Se mantieni la fiamma alta dopo aver aggiunto il formaggio, rischi di separare il grasso dalla proteina, ottenendo un effetto \"unto\" invece di quello filante.", "foto": []}, {"t": "🏁Ti sono piaciuti questi spinaci cremosi? Allora non puoi perderti la mia versione più sfiziosa e croccante: corri a scoprire la ricetta dei miei FAGOTTINI DI PASTA SFOGLIA E SPINACI! Sono il finger food perfetto, filanti e dorati, ideali per un aperitivo o una cena veloce che mette d’accordo tutti. Provali subito e fammi sapere cosa ne pensi nei commenti!", "foto": []}]},
+  {"id": "cp:25446413", "nome": "Quiche Proteica alle Verdure", "foto": "https://img-global.cpcdn.com/recipes/c802f347f6f28149/1200x630cq80/photo.jpg", "url": "https://cookpad.com/it/ricette/25446413", "porzioni": 4, "ingredienti": ["8 uova", "250 g formaggio cottage", "125 g mozzarella (una pallina)", "300 g patate dolci", "50 g formaggio Cheddar", "150 g broccoli", "150 g Zucchine", "150 g peperoni", "1 cucchiaino olio d'oliva", "Sale, pepe, paprika affumicata"], "totale": 0, "nutr": {"kcal": 422.7, "prot": 34.0, "carb": 17.4, "zuc": 6.1, "grassi": 23.8, "saturi": 9.1, "sodio": 536.3}, "dolce": false, "stimata": true, "passi": [{"t": "Verdure al forno Taglia patate dolci, broccoli, zucchine e peperoni. Condisci con 1 cucchiaino di olio, sale, pepe e paprika affumicata. Cuoci a 180°C per 25 minuti.", "foto": []}, {"t": "Base proteica Sbatti 8 uova con 250 g di cottage, aggiusta di sale e pepe.", "foto": []}, {"t": "Assemblaggio Metti le verdure in una teglia, versa sopra il composto di uova. Aggiungi la mozzarella e cuoci altri 20 minuti.", "foto": []}, {"t": "Finitura A 5 minuti dalla fine aggiungi il cheddar sopra per farlo sciogliere e dorare. Lascia riposare 10 minuti prima di tagliare.", "foto": ["https://img-global.cpcdn.com/steps/56b01717b1017bbe/400x400cq80/photo.jpg", "https://img-global.cpcdn.com/steps/733f182b3ca635ff/400x400cq80/photo.jpg"]}]},
+  {"id": "cp:15271163", "nome": "Wrap sano e proteico", "foto": "https://img-global.cpcdn.com/recipes/f5169265a630e840/1200x630cq80/photo.jpg", "url": "https://cookpad.com/it/ricette/15271163", "porzioni": 1, "ingredienti": ["50 gr farina tipo 0", "100 ml albumi", "q.b. sale", "q.b. pepe nero", "Farcitura a piacere (es Philadelphia active, fesa di tacchino, insalata e pomodori / petto di pollo grigliato, insalata e pomodori)"], "totale": 0, "nutr": {"kcal": 204.5, "prot": 16.2, "carb": 36.6, "zuc": 1.6, "grassi": 0.6, "saturi": 0.1, "sodio": 167.5}, "dolce": false, "stimata": true, "passi": [{"t": "Aggiungere tutti gli ingredienti alla farina e mescolare con una frusta", "foto": ["https://img-global.cpcdn.com/steps/f8f7511d4f4ea71e/400x400cq80/photo.jpg", "https://img-global.cpcdn.com/steps/6728dfa1c80de92f/400x400cq80/photo.jpg"]}, {"t": "Cuocere su padella antiaderente 3-4 minuti", "foto": ["https://img-global.cpcdn.com/steps/5e1cfdc953fdefd7/400x400cq80/photo.jpg", "https://img-global.cpcdn.com/steps/4d0789d613cc6fac/400x400cq80/photo.jpg"]}, {"t": "Farcisci a piacere e gusta!!", "foto": ["https://img-global.cpcdn.com/steps/e9f8b73a73ff17e4/400x400cq80/photo.jpg", "https://img-global.cpcdn.com/steps/1b8c6bb51256e513/400x400cq80/photo.jpg"]}]},
+  {"id": "cp:25563537", "nome": "Frittata sandwich ai fagiolini: ricetta keto, senza glutine e lattosio ️", "foto": "https://img-global.cpcdn.com/recipes/bd9fb9734c1c5714/1200x630cq80/photo.jpg", "url": "https://cookpad.com/it/ricette/25563537", "porzioni": 3, "ingredienti": ["6 uova medie", "200 g fagiolini (già lessati e scolati)", "3 sottilette (senza lattosio)", "1 cucchiaino olio di cocco", "q.b Sale fino integrale", "q.b Pepe nero", "1 Piatto piano (per girare la frittata)", "📍La frittata si conserva in frigorifero, all'interno di un contenitore ermetico, per un massimo di 2 giorni"], "totale": 0, "nutr": {"kcal": 373.1, "prot": 29.4, "carb": 31.7, "zuc": 2.3, "grassi": 12.6, "saturi": 4.7, "sodio": 153.4}, "dolce": false, "stimata": true, "passi": [{"t": "Inizia preparando i fagiolini già lessati: tagliali a piccoli pezzetti di circa 0,5 cm.", "foto": ["https://img-global.cpcdn.com/steps/8da46e4187108ea2/400x400cq80/photo.jpg", "https://img-global.cpcdn.com/steps/fd1f1c96ce6a96bc/400x400cq80/photo.jpg"]}, {"t": "In una ciotola capiente, rompi le uova e sbattile leggermente con un pizzico di sale integrale e una spolverata di pepe nero.", "foto": ["https://img-global.cpcdn.com/steps/c87a1d975119e48a/400x400cq80/photo.jpg", "https://img-global.cpcdn.com/steps/9b597cd22be16ff9/400x400cq80/photo.jpg"]}, {"t": "Unisci i fagiolini sminuzzati al composto di uova e mescola bene per distribuire uniformemente la verdura.", "foto": ["https://img-global.cpcdn.com/steps/9c57092fb71f4e78/400x400cq80/photo.jpg"]}, {"t": "Scalda un cucchiaino di olio di cocco in una padella antiaderente da 22-24 cm a fuoco medio.", "foto": ["https://img-global.cpcdn.com/steps/68836460104cd47a/400x400cq80/photo.jpg"]}, {"t": "Versa metà del composto nella padella ben calda, distribuendolo su tutta la superficie.", "foto": ["https://img-global.cpcdn.com/steps/5793d43b7c0e475c/400x400cq80/photo.jpg"]}, {"t": "Non appena la base inizia a rapprendersi, posiziona le sottilette al centro della frittata.", "foto": ["https://img-global.cpcdn.com/steps/894d19a81d2e2ecd/400x400cq80/photo.jpg"]}, {"t": "Copri immediatamente con il resto del composto di uova e fagiolini, sigillando il \"cuore\" di formaggio.", "foto": ["https://img-global.cpcdn.com/steps/2b0a0f11cf2e598b/400x400cq80/photo.jpg"]}, {"t": "Metti il coperchio e prosegui la cottura a fuoco medio-basso per circa 8-9 minuti.", "foto": []}, {"t": "Aiutandoti con un piatto piano, gira la frittata con un movimento deciso e cuoci l'altro lato per 1-2 minuti senza coperchio, finché non risulterà dorata.", "foto": ["https://img-global.cpcdn.com/steps/d520c63600c923e0/400x400cq80/photo.jpg"]}, {"t": "🧬VALORI NUTRIZIONALI PER 100 G Energia: 145 kcal Grassi: 10,2 g Carboidrati: 1,8 g Fibre: 1,2 g Proteine: 11,5 g", "foto": []}, {"t": "💡Se non hai i fagiolini, puoi utilizzare delle zucchine grattugiate (e strizzate) o degli spinaci saltati in padella.", "foto": []}, {"t": "💡Per un risultato ancora più cremoso, puoi aggiungere un cucchiaio di parmigiano reggiano stagionato 36 mesi (naturalmente privo di lattosio) al composto di uova.", "foto": []}, {"t": "❓️\"Posso cuocerla in forno?\" Sì, puoi infornare a 180°C per circa 20 minuti in una teglia foderata con carta forno, ma l'effetto \"sandwich\" è più semplice da gestire in padella.", "foto": []}, {"t": "⚠️Fiamma troppo alta: Cuocere a fuoco vivace brucerà la base prima che la parte superiore si sia rappresa a sufficienza per essere girata. Mantieni sempre il fuoco medio-basso.", "foto": []}, {"t": "⚠️Non usare il coperchio: Il vapore intrappolato dal coperchio è fondamentale per cuocere uniformemente lo strato superiore del sandwich.", "foto": []}, {"t": "🏁Cerchi altre idee keto-friendly? Lasciati conquistare dalla morbidezza dell'OMELETTE SOFFIATA AL CAPRINO E NOCI. Scopri subito come realizzarla per un secondo piatto originale e nutriente! ☁️🧀", "foto": []}]},
