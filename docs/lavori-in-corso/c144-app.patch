+  {"id": "cp:25811828", "nome": "Yogurt Greco con Fragole Calde e Cioccolato Fondente", "foto": "https://img-global.cpcdn.com/recipes/2917eaeb1c0b9d01/1200x630cq80/photo.jpg", "url": "https://cookpad.com/it/ricette/25811828", "porzioni": 2, "ingredienti": ["170 gr yogurt greco", "100 gr fragole fresche", "10 gr cioccolato fondente", "q.b cannella", "1-2 cucchiai acqua"], "totale": 0, "nutr": {"kcal": 124.0, "prot": 8.4, "carb": 8.5, "zuc": 8.5, "grassi": 6.1, "saturi": 3.8, "sodio": 35.5}, "dolce": true, "stimata": true, "passi": [{"t": "Lava le fragole e tagliale a pezzetti piccoli. Versale in un pentolino con pochissima acqua. Non serve aggiungere zucchero. Cuocile a fuoco basso per circa 5 minuti, mescolando ogni tanto. Quando si forma una salsa naturale lucida, sono pronte.", "foto": ["https://img-global.cpcdn.com/steps/3222c0eb66690b5a/400x400cq80/photo.jpg"]}, {"t": "Versa lo yogurt in una ciotola, aggiungi parte del liquido caldo delle fragole e una spolverata di cannella, mescola bene fino ad ottenere una consistenza vellutata.", "foto": ["https://img-global.cpcdn.com/steps/0adc93a599913355/400x400cq80/photo.jpg"]}, {"t": "Aggiungi sopra le fragole cotte, il cioccolato fondente e a piacere granella di nocciole, semi di chia oppure cocco rapé.", "foto": ["https://img-global.cpcdn.com/steps/2de817b8e48b008a/400x400cq80/photo.jpg"]}]},
+  {"id": "cp:14566426", "nome": "Torta di mele proteica, zero zuccheri, lowfat", "foto": "https://img-global.cpcdn.com/recipes/ec731bc54f86ee5b/1200x630cq80/photo.jpg", "url": "https://cookpad.com/it/ricette/14566426", "porzioni": 10, "ingredienti": ["250 g farina proteica aromatizzata nocciola e cacao", "150 g albumi", "130 ml latte", "50 g olio di semi", "2 mele a spicchi sottili", "1 bustina lievito per dolci", "q.b Zucchero a velo"], "totale": 0, "nutr": {"kcal": 161.1, "prot": 10.9, "carb": 12.6, "zuc": 3.6, "grassi": 6.8, "saturi": 1.3, "sodio": 44.8}, "dolce": true, "stimata": true, "passi": [{"t": "Cominciamo unendo tutti gli ingredienti in una Bowl, sbattiamo con una frusta e trasferiamo in uno stampo di 22-24 cm di diametro. Decoriamo con le mele a fettine e inforniamo a 180° per circa 30 minuti o fino a cottura (facciamo sempre la prova stecchino).", "foto": ["https://img-global.cpcdn.com/steps/ad8136f7c148f14d/400x400cq80/photo.jpg"]}, {"t": "Sforniamo e lasciamo raffreddare, rimuoviamo poi la carta forno e decoriamo con zucchero a velo.", "foto": ["https://img-global.cpcdn.com/steps/4c7d8d132eb51136/400x400cq80/photo.jpg"]}, {"t": "Ottima per una colazione o spuntino sano.. Buon appetito 🌻🌻🌻🌻🌻!", "foto": ["https://img-global.cpcdn.com/steps/b6315eeb8ea39adc/400x400cq80/photo.jpg"]}]},
+  {"id": "cp:25088574", "nome": "Plumcake Fit di Avena, Mele e Carote con Whey", "foto": "https://img-global.cpcdn.com/recipes/327993f77c44af87/1200x630cq80/photo.jpg", "url": "https://cookpad.com/it/ricette/25088574", "porzioni": 6, "ingredienti": ["160 g Fiocchi di avena fini", "200 ml latte di mandorle", "100 g Carote", "150 g Mela", "3 Uova", "30 g sciroppo d’acero", "30 g Whey protein gusto vaniglia o cioccolato", "14 g Lievito in polvere", "Qb Cannella in polvere", "Qb granella di pistacchi", "Qb pistacchi", "Qb gocce di cioccolato"], "totale": 0, "nutr": {"kcal": 172.0, "prot": 11.6, "carb": 18.3, "zuc": 2.5, "grassi": 5.1, "saturi": 1.6, "sodio": 84.3}, "dolce": true, "stimata": true, "passi": [{"t": "Sbuccia e taglia a cubetti la carota e la mela, e pesare il resto degli ingredienti", "foto": ["https://img-global.cpcdn.com/steps/565d1eb94ed58f0f/400x400cq80/photo.jpg"]}, {"t": "Nel bicchiere del frullatore, unisci in sequenza l’avena, lo sciroppo d’acero sciolto nel latte e le uova", "foto": []}, {"t": "Il whey, il lievito e la cannella. Frullare bene gli ingredienti", "foto": []}, {"t": "Versare il composto in uno stampo per plumcake. Spargere sulla superficie granella di pistacchi, pistacchi e gocce di cioccolata", "foto": []}, {"t": "Cuocere in Airfryer a 170°C per circa 40 minuti.", "foto": []}, {"t": "Lasciar raffreddare su una gratella e poi rimuovere il plumcake dallo stampo", "foto": ["https://img-global.cpcdn.com/steps/83150ccfa1a016b0/400x400cq80/photo.jpg", "https://img-global.cpcdn.com/steps/ef0a633d90066af5/400x400cq80/photo.jpg"]}]},
