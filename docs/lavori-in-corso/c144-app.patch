+  {"id": "cp:24726121", "nome": "Home-Made Crispy Ice-Cream", "foto": "https://img-global.cpcdn.com/recipes/69c5c374568ee611/1200x630cq80/photo.jpg", "url": "https://cookpad.com/it/ricette/24726121", "porzioni": 1, "ingredienti": ["25 gr farro soffiato", "60 gr mousse al cacao", "80 gr yogurt greco bianco", "10 gr cioccolato 74%", "50 mL acqua"], "totale": 0, "nutr": {"kcal": 434.1, "prot": 23.6, "carb": 32.5, "zuc": 9.1, "grassi": 23.6, "saturi": 14.0, "sodio": 58.5}, "dolce": true, "stimata": true, "passi": [{"t": "Mescola insieme il farro soffiato con la mousse proteica al cacao fino a dare uniformità agli ingredienti", "foto": []}, {"t": "All’interno di un coppapasta disponi uno strato di farro+mousse poi yogurt greco. Aggiungi del cioccolato a pezzetti e copri tutto con ulterio strato di farro+mousse", "foto": []}, {"t": "Fai riposare in freezer per circa un’ora poi estrai il coppapasta e fai passare ancora 10-15 minuti in freezer prima di consumare.", "foto": ["https://img-global.cpcdn.com/steps/5c570bb5081f09cd/400x400cq80/photo.jpg", "https://img-global.cpcdn.com/steps/25e464ef429f3927/400x400cq80/photo.jpg"]}]},
+  {"id": "cp:13418708", "nome": "𝕊𝔸ℂℍ𝔼ℝ 𝔽𝕀𝕋", "foto": "https://img-global.cpcdn.com/recipes/b14aa5105983ec53/1200x630cq80/photo.jpg", "url": "https://cookpad.com/it/ricette/13418708", "porzioni": 2, "ingredienti": ["30 gr Fiocchi d’avena gusto noccioloso", "20 gr Farina d’avena al cioccolato", "10 gr Farina di cocco 🥥", "150 ml Albume d’uovo", "5 gr Cacao Amaro", "4 gr Lievito", "30 gr Marmellata Hero light all’albicocca", "20 gr Cioccolata fondente 85%", "1 Cucchiaio crema proteica alla Nutella zero zuccheri 0%"], "totale": 0, "nutr": {"kcal": 266.0, "prot": 14.3, "carb": 25.6, "zuc": 8.7, "grassi": 11.8, "saturi": 6.0, "sodio": 143.2}, "dolce": true, "stimata": true, "passi": [{"t": "Montare l’albume a neve ferma e aggiungere le farine, il cacao e il lievito mescolando lentamente.", "foto": []}, {"t": "Cuocere in un pentolino di diametro 14cm con coperchio a fuoco basso per 15 minuti.", "foto": []}, {"t": "Girare il pancake dall’altro lato e cuocere altri 2/3 minuti senza coperchio.", "foto": []}, {"t": "Lasciare intiepidire, tagliare a metà e farcire con la marmellata all’albicocca.", "foto": []}, {"t": "A parte sciogliere il cioccolato fondente a bagnomaria e ricoprire la torta. Infine utilizzare la crema proteica alla nutella per la scritta.", "foto": ["https://img-global.cpcdn.com/steps/6b054a11d64ffb40/400x400cq80/photo.jpg", "https://img-global.cpcdn.com/steps/6b701a9c729bf26c/400x400cq80/photo.jpg", "https://img-global.cpcdn.com/steps/3a284bb75dfffcfb/400x400cq80/photo.jpg"]}]},
+  {"id": "cp:25560703", "nome": "Frittata dolce FIT cacao e fragole: la colazione proteica pronta in 15 minuti", "foto": "https://img-global.cpcdn.com/recipes/210b8d6b0930b350/1200x630cq80/photo.jpg", "url": "https://cookpad.com/it/ricette/25560703", "porzioni": 1, "ingredienti": ["2 uova intere", "1 banana matura", "1 cucchiaio yogurt greco (10% grassi)", "2 cucchiai farina di mandorle", "2 cucchiai cacao amaro", "3 fragole a fette"], "totale": 0, "nutr": {"kcal": 541.5, "prot": 29.0, "carb": 26.3, "zuc": 19.6, "grassi": 34.9, "saturi": 10.5, "sodio": 168.1}, "dolce": true, "stimata": true, "passi": [{"t": "In una ciotola, schiaccia accuratamente la banana con una forchetta fino a ridurla in purea omogenea.", "foto": ["https://img-global.cpcdn.com/steps/06163f95dcc5b59f/400x400cq80/photo.jpg", "https://img-global.cpcdn.com/steps/02770eb83ca564cf/400x400cq80/photo.jpg"]}, {"t": "Unisci le 2 uova alla banana.", "foto": ["https://img-global.cpcdn.com/steps/110fe544a9bdb94f/400x400cq80/photo.jpg"]}, {"t": "Aggiungi lo yogurt greco al 10%, la farina di mandorle e i 2 cucchiai di cacao amaro. Mescola con cura finché il composto non risulta scuro, denso e privo di grumi.", "foto": ["https://img-global.cpcdn.com/steps/f3cc0b9c28ce0df5/400x400cq80/photo.jpg", "https://img-global.cpcdn.com/steps/57137a466856d0b7/400x400cq80/photo.jpg", "https://img-global.cpcdn.com/steps/1a3ef056e3e7c94d/400x400cq80/photo.jpg"]}, {"t": "Lava, pulisci e taglia a fettine le fragole.", "foto": ["https://img-global.cpcdn.com/steps/7e7723b6b74ca2c8/400x400cq80/photo.jpg", "https://img-global.cpcdn.com/steps/b5221894cbadaaf5/400x400cq80/photo.jpg", "https://img-global.cpcdn.com/steps/aa4a4de4a7bbec0b/400x400cq80/photo.jpg"]}, {"t": "Ungi la padella con il cucchiaino di olio di cocco e scaldala leggermente.", "foto": ["https://img-global.cpcdn.com/steps/c6d9edf70b3b284e/400x400cq80/photo.jpg"]}, {"t": "Versa l'impasto, livellandolo bene, e adagia sopra le 3 fragole tagliate a fettine.", "foto": ["https://img-global.cpcdn.com/steps/71550c1109a36267/400x400cq80/photo.jpg", "https://img-global.cpcdn.com/steps/4893eb3ecc2550cc/400x400cq80/photo.jpg"]}, {"t": "Copri con il coperchio e cuoci a fuoco molto basso per 15 minuti. Il calore costante e dolce permetterà alla frittata di gonfiarsi uniformemente.", "foto": []}, {"t": "Spegni il fuoco e, senza sollevare il coperchio, lascia riposare la frittata per altri 2 minuti. Questo passaggio finale permette al vapore residuo di ultimare la cottura della superficie.", "foto": []}, {"t": "Fai scivolare delicatamente sul piatto e servila tiepida.", "foto": ["https://img-global.cpcdn.com/steps/087a0f1fee9d5125/400x400cq80/photo.jpg"]}, {"t": "🧬VALORI NUTRIZIONALI PER 100 G Calorie 188 kcal Proteine 8.2 g Grassi 12.5 g Carboidrati 10.8 g Fibre 4.2 g", "foto": []}, {"t": "💡Assicurati che il coperchio sia della misura giusta per la padella: trattenere il calore è fondamentale per la riuscita dei 15 minuti a fuoco minimo.", "foto": []}, {"t": "❓️\"Perché lasciarla coperta a fuoco spento?\" Questo permette alle proteine dell'uovo di stabilizzarsi senza subire lo shock termico, evitando che la frittata si sgonfi appena servita.", "foto": []}, {"t": "❓️\"Il cacao non diventa amaro con 15 minuti di cottura?\" No, purché la fiamma sia al minimo. La cottura lenta esalta l'aroma del cioccolato senza bruciarlo.", "foto": []}, {"t": "⚠️Non alzare il coperchio durante i 15 minuti: La dispersione di calore interromperebbe la cottura uniforme della parte superiore.", "foto": []}, {"t": "⚠️Fiamma troppo alta: Con 15 minuti di esposizione, una fiamma media brucerebbe inesorabilmente la base di cacao.", "foto": []}, {"t": "🏁Se ti è piaciuta questa frittata super cioccolatosa, non puoi perderti il mio BUDINO FIT AL CACAO CON YOGURT GRECO! 🍫✨ È la merenda fresca e proteica perfetta da preparare in un minuto. Corri a scoprire la ricetta e fammi sapere quale dei due vince la sfida del gusto!", "foto": []}]},
