{
  "name": "pronti-in-tavola",
  "compatibility_date": "2026-11-01",
  "main": "worker.js",
  // i file dell'app; il Worker risponde prima solo per /api/* (notifiche degli ordini, C3)
  "assets": { "directory": "./sito", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "durable_objects": { "bindings": [{ "name": "AVVISI", "class_name": "Avvisi" }, { "name": "RICETTARIO", "class_name": "Ricettario" }] },
  // aiutante di Monica (C48): Workers AI gratuito sullo stesso account dell'app
  "ai": { "binding": "AI" },
  // C135 corsia d'emergenza degli avvisi: cassetto Workers KV «pronti-in-tavola-riserva», creato da Mario l'11/11 dalla dashboard
  // (il token di GitHub non può crearlo, PT E57). L'ID non è segreto («KV namespace IDs are public»).
  // 11/11 06:21 il primo cassetto (a8b7…d771) era nell'account sbagliato: 10041 (PT E64). Rifatto da Mario l'11/11 ~13:57 nell'account del sito.
  "kv_namespaces": [{ "binding": "RISERVA", "id": "c4fa18640b4846cba693e198059fd860" }],
  // v2: il database delle ricette e delle voci (C60)
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Avvisi"] }, { "tag": "v2", "new_sqlite_classes": ["Ricettario"] }],
  // promemoria della sera (worker.js scheduled): 18:00 UTC = 19:00 d'inverno, 20:00 d'estate in Italia
  // e ogni 10 minuti il motore che fa crescere il database delle ricette (C60)
  "triggers": { "crons": ["0 18 * * *", "*/10 * * * *"] },
  "preview_urls": false
}
